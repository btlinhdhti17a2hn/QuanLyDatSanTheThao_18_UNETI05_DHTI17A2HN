// Nội dung thực hiện: Partial View nửa trái (giới thiệu) dùng chung cho trang Đăng nhập, Đăng ký và Quên mật khẩu
*@

<section class="auth-hero">
    <a class="auth-brand" asp-controller="Home" asp-action="Index">
        <span class="brand-badge">🏟️</span> SPORTS GROUND
    </a>

    <h1 class="auth-title">Quản lý &amp; đặt sân<br /><span>thể thao trực tuyến</span></h1>
    <div class="auth-tags">Nhanh chóng <i></i> Minh bạch <i></i> Tiện lợi</div>

    <div class="pitch">
        <div class="pitch-line"></div>
        <div class="pitch-circle"></div>
        <div class="pitch-box left"></div>
        <div class="pitch-box right"></div>
        <span class="ball b1">⚽</span>
        <span class="ball b2">🏀</span>
        <span class="ball b3">🏸</span>
        <span class="ball b4">🎾</span>
    </div>

    <div class="auth-features">
        <div class="auth-feature">
            <span class="f-ic">🛡️</span>
            <div><strong>An toàn</strong><span>Bảo mật thông tin người dùng</span></div>
        </div>
        <div class="auth-feature">
            <span class="f-ic">⚡</span>
            <div><strong>Nhanh chóng</strong><span>Đặt sân chỉ với vài thao tác</span></div>
        </div>
        <div class="auth-feature">
            <span class="f-ic">📅</span>
            <div><strong>Tiện lợi</strong><span>Theo dõi lịch đặt mọi lúc, mọi nơi</span></div>
        </div>
    </div>
</section>