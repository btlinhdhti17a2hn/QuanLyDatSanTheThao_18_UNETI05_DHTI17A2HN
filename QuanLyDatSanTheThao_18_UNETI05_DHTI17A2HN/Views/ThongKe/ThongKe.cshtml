@* Họ và tên: Tạ Đình Kim 
   Mã sinh viên: 23103100315
   Nội dung thực hiện: Trang thống kê nâng cao bằng LINQ (GroupBy, Sum, Count) - doanh thu theo kỳ,
   loại sân ưa thích, dịch vụ phổ biến, khung giờ cao điểm. Có bộ lọc thời gian, so sánh kỳ trước
   và xem nhanh danh sách đơn hủy.
   *@

@using System.Globalization
@using QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.ViewModels
@model ThongKeViewModel
@{
    ViewData["Title"] = "Thống kê";
    var inv = CultureInfo.InvariantCulture;
    Func<DateTime, string> f = d => d.ToString("dd/MM/yyyy", inv);

    // ===== Tỷ lệ hủy =====
    double tyLeHuy = Convert.ToDouble(Model.TyLeHuy, inv);
    string huyMau = tyLeHuy < 10 ? "#16a34a" : (tyLeHuy < 20 ? "#d97706" : "#dc2626");
    string huyNhan = tyLeHuy < 10 ? "Ở mức tốt" : (tyLeHuy < 20 ? "Cần theo dõi" : "Tỷ lệ cao");
    string huyLop = tyLeHuy < 10 ? "good" : (tyLeHuy < 20 ? "warn" : "bad");
    string huyIcon = tyLeHuy < 10 ? "✔" : "⚠";
    string huyRong = Math.Min(100, tyLeHuy).ToString("0.##", inv);

    // ===== Bộ lọc thời gian =====
    // Danh sách năm cho dropdown: gộp năm có dữ liệu + dải năm liên tục (từ 5 năm trước đến 2 năm sau hiện tại)
    int namHienTai = DateTime.Today.Year;
    var danhSachNam = new List<int>();
    if (Model.DanhSachNam != null) { danhSachNam.AddRange(Model.DanhSachNam); }
    for (int y = namHienTai - 5; y <= namHienTai + 2; y++) { danhSachNam.Add(y); }
    danhSachNam.Add(Model.Nam);
    danhSachNam = danhSachNam.Distinct().OrderByDescending(y => y).ToList();

    string kieu = string.IsNullOrEmpty(Model.Kieu) ? "nam" : Model.Kieu;
    DateTime tu = Model.TuNgay == default(DateTime) ? new DateTime(Model.Nam, 1, 1) : Model.TuNgay.Date;
    DateTime den = Model.DenNgay == default(DateTime) ? new DateTime(Model.Nam, 12, 31) : Model.DenNgay.Date;

    string nhan;
    switch (kieu)
    {
        case "homnay": nhan = "hôm nay (" + f(tu) + ")"; break;
        case "tuannay": nhan = "tuần này (" + f(tu) + " - " + f(den) + ")"; break;
        case "thangnay": nhan = "tháng " + tu.ToString("MM/yyyy", inv); break;
        case "quynay": nhan = "quý " + ((tu.Month - 1) / 3 + 1) + "/" + tu.Year; break;
        case "tuychon": nhan = f(tu) + " - " + f(den); break;
        default: nhan = "năm " + tu.Year; break;
    }

    var presets = new[]
    {
        new { Key = "homnay",   Text = "Hôm nay" },
        new { Key = "tuannay",  Text = "Tuần này" },
        new { Key = "thangnay", Text = "Tháng này" },
        new { Key = "quynay",   Text = "Quý này" },
        new { Key = "nam",      Text = "Năm" },
        new { Key = "tuychon",  Text = "Tùy chọn" }
    };

    bool coDuLieu = Model.TongLuotDat > 0;

    // ===== So sánh với kỳ trước: trả về [lớp CSS, chữ hiển thị] =====
    Func<decimal, decimal, string[]> delta = (cur, prev) =>
    {
        if (prev == 0) return cur == 0 ? new[] { "flat", "–" } : new[] { "new", "Chưa có dữ liệu kỳ trước" };
        decimal pct = Math.Round((cur - prev) / prev * 100m, 1);
        if (pct == 0) return new[] { "flat", "= 0%" };
        return new[] { pct > 0 ? "up" : "down", (pct > 0 ? "▲ " : "▼ ") + Math.Abs(pct).ToString("0.#") + "%" };
    };
    string kyTruocTip = "So với " + f(Model.TuNgayTruoc) + " - " + f(Model.DenNgayTruoc);

    // Nhãn kỳ trước theo bộ lọc đang chọn (hôm qua / tuần trước / tháng trước / quý trước / năm trước)
    string kyTruocNhan;
    switch (kieu)
    {
        case "homnay": kyTruocNhan = "so với hôm qua"; break;
        case "tuannay": kyTruocNhan = "so với tuần trước"; break;
        case "thangnay": kyTruocNhan = "so với tháng trước"; break;
        case "quynay": kyTruocNhan = "so với quý trước"; break;
        case "nam": kyTruocNhan = "so với năm trước"; break;
        default: kyTruocNhan = "so với kỳ trước"; break;
    }
    string kyTruocKhoang = f(Model.TuNgayTruoc) + " - " + f(Model.DenNgayTruoc);

    // Tiền thất thoát do đơn hủy (cộng từ danh sách đơn hủy; nếu danh sách bị cắt thì chỉ là mức tối thiểu)
    decimal tienHuy = Model.DonHuy.Sum(x => x.DonGia);
    bool tienHuyTruncated = Model.SoLuotHuy > Model.DonHuy.Count;

    // Tổng doanh thu dịch vụ để tính tỷ trọng đóng góp
    decimal tongDichVu = Model.DichVuPhoBien.Sum(x => x.GiaTri);

    var dtDelta = delta(Model.TongDoanhThuNam, Model.DoanhThuKyTruoc);
    var luotDelta = delta(Model.TongLuotDat, Model.LuotDatKyTruoc);
    decimal trungBinh = Model.SoDonHoanThanh > 0 ? Math.Round(Model.TongDoanhThuNam / Model.SoDonHoanThanh, 0) : 0;

    string moTaBieuDo = Model.DonViBieuDo == "tuần"
        ? "Mỗi cột = 1 tuần (nhãn là ngày bắt đầu). Cột đậm là mốc cao nhất."
        : "Mỗi cột = 1 " + Model.DonViBieuDo + ". Cột đậm là mốc cao nhất.";

    // ===== Nhận định khung giờ =====
    var kg = Model.KhungGio;
    var kgCao = Model.KhungGioCaoDiem;
    var kgThap = kg.Count > 1 ? kg.OrderBy(x => x.SoLuong).First() : null;

    // ===== Doanh thu theo loại sân: gộp lượt đặt + doanh thu, dùng cho biểu đồ tròn và bảng =====
    var tienTheoLoai = Model.DoanhThuTheoLoai.ToDictionary(x => x.Ten, x => x.GiaTri);
    var loaiRows = Model.LuotDatTheoLoai
        .Select(x => new { x.Ten, Luot = x.SoLuong, Tien = tienTheoLoai.GetValueOrDefault(x.Ten) })
        .OrderByDescending(x => x.Tien).ThenByDescending(x => x.Luot).ThenBy(x => x.Ten)
        .ToList();
    decimal tongTienLoai = loaiRows.Sum(x => x.Tien);
    string[] mau = { "#14532d", "#16a34a", "#4ade80", "#0ea5e9", "#f59e0b", "#94a3b8" };

    const double chuVi = 2 * Math.PI * 44;   // bán kính vòng tròn = 44
    int soPhanCoTien = loaiRows.Count(x => x.Tien > 0);
    var donut = new List<(string Mau, string Day, string Lech, int Idx)>();
    double daDung = 0;
    for (int idx = 0; idx < loaiRows.Count; idx++)
    {
        if (tongTienLoai <= 0 || loaiRows[idx].Tien <= 0) continue;
        double dai = (double)(loaiRows[idx].Tien / tongTienLoai) * chuVi;
        double hien = soPhanCoTien > 1 ? Math.Max(dai - 1.5, 0.5) : dai;   // chừa khe nhỏ giữa các phần
        donut.Add((mau[idx % mau.Length],
                   hien.ToString("0.###", inv) + " " + (chuVi - hien).ToString("0.###", inv),
                   (-daDung).ToString("0.###", inv), idx));
        daDung += dai;
    }

    // Số tiền gọn cho giữa biểu đồ tròn
    Func<decimal, string> gon = v => v >= 1000000000m ? (v / 1000000000m).ToString("0.##") + " tỷ"
                                   : v >= 1000000m ? (v / 1000000m).ToString("0.##") + " tr"
                                   : v.ToString("N0") + " đ";

    // ===== Biểu đồ cột theo giờ (mặc định 6h - 22h, tự mở rộng nếu có đơn ngoài khoảng này) =====
    var gioMap = new Dictionary<int, ThongKeItem>();
    foreach (var mucGio in Model.KhungGio)
    {
        if (mucGio.Ten.Length >= 2 && int.TryParse(mucGio.Ten.Substring(0, 2), out var gioSo)) gioMap[gioSo] = mucGio;
    }
    int gioDau = gioMap.Count > 0 ? Math.Min(6, gioMap.Keys.Min()) : 6;
    int gioCuoi = gioMap.Count > 0 ? Math.Max(22, gioMap.Keys.Max()) : 22;
    int gioMax = gioMap.Count > 0 ? gioMap.Values.Max(x => x.SoLuong) : 0;
    int gioCaoDiem = -1;
    if (kgCao != null && kgCao.Ten.Length >= 2 && int.TryParse(kgCao.Ten.Substring(0, 2), out var gioCao)) gioCaoDiem = gioCao;

    // Thu hẹp trục giờ về vùng có dữ liệu (±2 giờ), tối thiểu 8 cột, để không lãng phí chỗ khi đơn dồn vào vài giờ
    if (gioMap.Count > 0)
    {
        int gA = Math.Max(0, gioMap.Keys.Min() - 2);
        int gB = Math.Min(23, gioMap.Keys.Max() + 2);
        while (gB - gA + 1 < 8 && (gA > 0 || gB < 23))
        {
            if (gA > 0) gA--;
            if (gB - gA + 1 < 8 && gB < 23) gB++;
        }
        gioDau = gA;
        gioCuoi = gB;
    }

    // Gom khung giờ theo buổi: Sáng (< 12h), Chiều (12h - 18h), Tối (từ 18h)
    var buoiRows = new[]
    {
        new { Ten = "Sáng",  Mo = "trước 12:00",  Luot = gioMap.Where(x => x.Key < 12).Sum(x => x.Value.SoLuong) },
        new { Ten = "Chiều", Mo = "12:00 - 18:00", Luot = gioMap.Where(x => x.Key >= 12 && x.Key < 18).Sum(x => x.Value.SoLuong) },
        new { Ten = "Tối",   Mo = "từ 18:00",      Luot = gioMap.Where(x => x.Key >= 18).Sum(x => x.Value.SoLuong) }
    };
    int buoiMax = buoiRows.Max(x => x.Luot);
    int buoiTong = buoiRows.Sum(x => x.Luot);

    // ===== Xếp hạng sân =====
    int tongLuotSan = Model.LuotDatTheoSan.Sum(x => x.SoLuong);
    var topSan = Model.LuotDatTheoSan.Take(5).ToList();
    Func<int, int> hangSan = so => 1 + Model.LuotDatTheoSan.Count(x => x.SoLuong > so);   // đồng hạng cùng thứ tự
    Func<int, int, string> tyLeStr = (so, tong) => tong == 0 ? "0%" : (so * 100.0 / tong).ToString("0.#") + "%";
    var sanIt = Model.SanItKhach.Take(5).ToList();

    // Xếp hạng sân: cùng số lượt thì sắp theo tên để thứ tự cố định, và gắn nhãn "Đồng hạng"
    var topSanRows = Model.LuotDatTheoSan.OrderByDescending(x => x.SoLuong).ThenBy(x => x.Ten).Take(5).ToList();

    // Chỉ số khai thác sân (ước lượng từ lượt đặt, chưa cần giờ mở cửa)
    var luotTheoLoai = Model.LuotDatTheoLoai.GroupBy(x => x.Ten).ToDictionary(g => g.Key, g => g.Sum(x => x.SoLuong));
    int tongSan = Model.SanTheoLoai.Sum(x => x.SoLuong);
    int sanCoDat = Model.LuotDatTheoSan.Count(x => x.SoLuong > 0);
    double luotTbSan = tongSan > 0 ? (double)tongLuotSan / tongSan : 0;
    var sanLoaiRows = Model.SanTheoLoai
        .Select(x => new { x.Ten, SoSan = x.SoLuong, Luot = luotTheoLoai.GetValueOrDefault(x.Ten) })
        .Select(x => new { x.Ten, x.SoSan, x.Luot, TbSan = x.SoSan > 0 ? (double)x.Luot / x.SoSan : 0.0 })
        .ToList();
    double sanLoaiMax = sanLoaiRows.Count == 0 ? 0 : sanLoaiRows.Max(x => x.TbSan);

    // ===== Báo cáo khi in / lưu PDF: tiêu đề theo kỳ đang xem + phân tích tự động =====
    string loaiBaoCao;
    switch (kieu)
    {
        case "homnay": loaiBaoCao = "ngày"; break;
        case "tuannay": loaiBaoCao = "tuần"; break;
        case "thangnay": loaiBaoCao = "tháng"; break;
        case "quynay": loaiBaoCao = "quý"; break;
        case "nam": loaiBaoCao = "năm"; break;
        default: loaiBaoCao = null; break;
    }
    string tieuDeBaoCao = loaiBaoCao != null ? "Báo cáo " + loaiBaoCao : "Báo cáo thống kê";
    string kyBaoCao = kieu == "homnay" ? f(tu) : f(tu) + " - " + f(den);
    string tieuDeTrang = tieuDeBaoCao + " " + kyBaoCao.Replace("/", "-");   // thành tên file khi "Lưu thành PDF"
    Func<decimal, string> tien = v => v.ToString("N0") + " đ";

    var phanTich = new List<string>();
    if (Model.DoanhThuKyTruoc > 0)
    {
        decimal pctDt = Math.Round((Model.TongDoanhThuNam - Model.DoanhThuKyTruoc) / Model.DoanhThuKyTruoc * 100m, 1);
        phanTich.Add("Doanh thu đạt " + tien(Model.TongDoanhThuNam) + ", " + (pctDt >= 0 ? "tăng " : "giảm ") + Math.Abs(pctDt).ToString("0.#") + "% " + kyTruocNhan + " (" + tien(Model.DoanhThuKyTruoc) + ").");
    }
    else
    {
        phanTich.Add("Doanh thu đạt " + tien(Model.TongDoanhThuNam) + "; kỳ trước (" + kyTruocKhoang + ") chưa có dữ liệu để so sánh.");
    }
    phanTich.Add("Có " + Model.TongLuotDat + " lượt đặt, trong đó " + Model.SoDonHoanThanh + " đơn hoàn thành; giá trị trung bình " + tien(trungBinh) + " mỗi đơn.");
    phanTich.Add("Tỷ lệ hủy đơn " + Model.TyLeHuy + "% (" + Model.SoLuotHuy + "/" + Model.TongLuotDat + " đơn) - " + huyNhan.ToLower()
                 + (Model.SoLuotHuy > 0 ? ", thất thoát " + (tienHuyTruncated ? "tối thiểu " : "") + tien(tienHuy) + "." : "."));
    var loaiTop = loaiRows.FirstOrDefault();
    if (loaiTop != null && loaiTop.Tien > 0 && tongTienLoai > 0)
    {
        phanTich.Add(loaiTop.Ten + " mang lại doanh thu cao nhất: " + tien(loaiTop.Tien) + " (" + (loaiTop.Tien / tongTienLoai * 100m).ToString("0.#") + "% doanh thu theo loại sân).");
    }
    if (kgCao != null)
    {
        phanTich.Add("Khung giờ cao điểm là " + kgCao.Ten + " với " + kgCao.SoLuong + " lượt (" + kgCao.TyLe.ToString("0.#") + "% tổng lượt đặt).");
    }
    if (buoiTong > 0)
    {
        var buoiTop = buoiRows.OrderByDescending(x => x.Luot).First();
        phanTich.Add("Buổi " + buoiTop.Ten.ToLower() + " có nhiều lượt đặt nhất (" + tyLeStr(buoiTop.Luot, buoiTong) + ").");
    }
    if (kgThap != null && kgCao != null && kgThap.Ten != kgCao.Ten)
    {
        phanTich.Add("Khung giờ vắng nhất là " + kgThap.Ten + " (" + kgThap.SoLuong + " lượt); có thể cân nhắc ưu đãi để kích cầu.");
    }
    if (topSanRows.Count > 0)
    {
        var sanTop = topSanRows[0];
        int cungLuotDau = Model.LuotDatTheoSan.Count(x => x.SoLuong == sanTop.SoLuong);
        phanTich.Add(cungLuotDau > 1
            ? cungLuotDau + " sân cùng dẫn đầu với " + sanTop.SoLuong + " lượt đặt mỗi sân."
            : sanTop.Ten + " được đặt nhiều nhất với " + sanTop.SoLuong + " lượt.");
    }
    if (tongSan > 0 && sanCoDat < tongSan)
    {
        phanTich.Add((tongSan - sanCoDat) + "/" + tongSan + " sân chưa có lượt đặt nào trong kỳ.");
    }
    if (Model.DichVuPhoBien.Count > 0)
    {
        var dvTop = Model.DichVuPhoBien[0];
        phanTich.Add("Dịch vụ bán chạy nhất là " + dvTop.Ten + " (" + dvTop.SoLuong + " lượt sử dụng, " + tien(dvTop.GiaTri) + ").");
    }
    if (tyLeHuy >= 20)
    {
        phanTich.Add("Tỷ lệ hủy đang ở mức cao, nên rà soát nguyên nhân hủy (chính sách đặt cọc, nhắc lịch) để giảm thất thoát.");
    }
}

<style>
    .tk {
        --ink: #0f172a;
        --muted: #64748b;
        --line: #e5e7eb;
        --pitch: #14532d;
        --pitch-2: #166534;
        --brand: #16a34a;
        --brand-soft: #4ade80;
        --brand-deep: #15803d;
    }

    /* ===== Khối nội dung chung: padding 20px, bo 12px ===== */
    .tk-panel {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 1.25rem;
        margin: 0;
        box-shadow: 0 1px 2px rgba(15,23,42,.04);
    }

    .tk-panel-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.3;
    }

    .tk-panel-sub {
        color: var(--muted);
        font-size: .8125rem;
        margin-bottom: .75rem;
        min-height: .4rem;
    }

    .tk-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .4rem;
        color: #94a3b8;
        padding: 1.5rem 0 1rem;
        font-size: .875rem;
    }

    .tk-note {
        color: var(--muted);
        font-size: .8125rem;
        margin-top: .5rem;
    }

    .tk-stack {
        display: grid;
        gap: 1.25rem;
        min-width: 0;
        align-content: start;
    }

    /* ===== THANH TRÊN CÙNG: Tiêu đề | Tabs | Bộ lọc (1 hàng) ===== */
    .tk-top {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .4rem .75rem;
        margin-bottom: 1rem;
    }

    .tk-title {
        line-height: 1.2;
        margin-right: .25rem;
    }

        .tk-title h2 {
            font-size: 1.4rem;
            margin: 0;
            font-weight: 700;
            line-height: 1.2;
        }

        .tk-title .sub {
            color: var(--muted);
            font-size: .8125rem;
            white-space: nowrap;
        }

            .tk-title .sub b {
                color: var(--pitch-2);
            }

    .tk-tabs {
        display: flex;
        gap: .25rem;
        overflow-x: auto;
        white-space: nowrap;
        flex: 1 1 auto;
        min-width: 0;
        scrollbar-width: none;
    }

        .tk-tabs::-webkit-scrollbar {
            display: none;
        }

    .tk-tab {
        border: 0;
        background: transparent;
        color: var(--muted);
        font-weight: 600;
        font-size: .875rem;
        padding: .35rem .75rem;
        border-radius: 8px;
        cursor: pointer;
        transition: color .15s, background .15s;
    }

        .tk-tab:hover {
            color: var(--ink);
            background: #f1f5f9;
        }

        .tk-tab.active {
            color: var(--pitch-2);
            background: #dcfce7;
        }

    .tk-filter {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .5rem;
        margin: 0 0 0 auto;
    }

    .tk-sub {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .8125rem;
        color: var(--muted);
    }

        .tk-sub[hidden] {
            display: none;
        }

        .tk-sub .form-select,
        .tk-sub .form-control {
            width: auto;
            padding-top: .25rem;
            padding-bottom: .25rem;
            font-size: .875rem;
        }

    .tk-apply {
        border: 0;
        background: var(--pitch-2);
        color: #fff;
        font-weight: 600;
        font-size: .8125rem;
        padding: .3rem .9rem;
        border-radius: 8px;
        cursor: pointer;
    }

        .tk-apply:hover {
            background: var(--pitch);
        }

    .tk-pane[hidden] {
        display: none;
    }

    .tk-pane:not([hidden]) {
        animation: tkFade .2s ease;
    }

    @@keyframes tkFade {
        from {
            opacity: 0;
            transform: translateY(4px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    /* ===== 4 THẺ CHỈ SỐ: cùng nền trắng, icon bên phải, badge ngay dưới số ===== */
    .tk-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .tk-kpi {
        display: block;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: .7rem 1rem;
        box-shadow: 0 1px 2px rgba(15,23,42,.04);
        text-align: left;
        font: inherit;
        width: 100%;
        min-width: 0;
    }

    .tk-kpi-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .5rem;
    }

    .tk-kpi-label {
        font-size: .75rem;
        font-weight: 600;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .03em;
        line-height: 1.3;
    }

    .tk-kpi-val {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.2;
        color: var(--ink);
        margin: .15rem 0 .3rem;
        white-space: nowrap;
    }

        .tk-kpi-val small {
            font-size: .8125rem;
            font-weight: 600;
            color: var(--muted);
            margin-left: .4rem;
        }

    .tk-kpi-foot {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .2rem .5rem;
        font-size: .8125rem;
        color: var(--muted);
    }

    .tk-loss {
        font-size: .8125rem;
        color: #b91c1c;
        white-space: nowrap;
    }

        .tk-loss b {
            font-weight: 700;
        }

    .tk-ico {
        flex: none;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: #f0fdf4;
        color: var(--brand-deep);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .tk-ico.red {
            background: #fef2f2;
            color: #dc2626;
        }

    .tk-share {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .8125rem;
        color: var(--muted);
    }

        .tk-share > span {
            min-width: 2.8rem;
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

    .tk-svc-total {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .5rem;
        font-size: .875rem;
        color: var(--ink);
        background: #f8fafc;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: .5rem .75rem;
        margin-bottom: .75rem;
    }

    .tk-tools {
        display: flex;
        gap: .35rem;
    }

    .tk-tool {
        border: 1px solid var(--line);
        background: #fff;
        color: var(--muted);
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        cursor: pointer;
    }

        .tk-tool:hover {
            background: #f1f5f9;
            color: var(--ink);
        }

    /* ===== Bản in: chỉ in "báo cáo" riêng, không in giao diện thao tác ===== */
    .tk-report {
        display: none;
    }

    @@page {
        size: A4;
        margin: 14mm 12mm;
    }

    @@media print {
        nav, header, footer, aside, .tk-top, .tk-pane, .tk-dialog, .tk-tools { display: none !important; }
        body { background: #fff !important; }

        .tk-report {
            display: block !important;
            color: #0f172a;
            font-size: 10.5pt;
            line-height: 1.45;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .rp-head {
            text-align: center;
            border-bottom: 2px solid #166534;
            padding-bottom: 8px;
            margin-bottom: 14px;
        }

        .rp-org {
            font-size: 10pt;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .rp-title {
            font-size: 20pt;
            font-weight: 700;
            color: #14532d;
            text-transform: uppercase;
            margin: 2px 0;
        }

        .rp-meta {
            font-size: 10pt;
            color: #475569;
        }

        .rp-sec {
            margin-bottom: 14px;
        }

            .rp-sec h3 {
                font-size: 12pt;
                font-weight: 700;
                color: #166534;
                border-bottom: 1px solid #cbd5e1;
                padding-bottom: 3px;
                margin: 0 0 6px;
                break-after: avoid;
            }

            .rp-sec h4 {
                font-size: 10.5pt;
                font-weight: 700;
                margin: 8px 0 4px;
                break-after: avoid;
            }

        .rp-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 4px;
            break-inside: auto;
        }

            .rp-table th {
                background: #e8f5ec;
                text-align: left;
                font-size: 9.5pt;
                padding: 4px 6px;
                border: 1px solid #cbd5e1;
            }

            .rp-table td {
                font-size: 10pt;
                padding: 4px 6px;
                border: 1px solid #e2e8f0;
            }

            .rp-table tr {
                break-inside: avoid;
            }

            .rp-table .r {
                text-align: right;
                white-space: nowrap;
            }

            .rp-table tfoot td {
                font-weight: 700;
                background: #f8fafc;
            }

        .rp-bar {
            height: 6px;
            background: #e2e8f0;
            border-radius: 99px;
            overflow: hidden;
            margin-top: 3px;
        }

            .rp-bar > span {
                display: block;
                height: 100%;
                background: #16a34a;
            }

        .rp-note {
            font-size: 9.5pt;
            color: #64748b;
            margin: 2px 0 0;
        }

        .rp-list {
            margin: 0;
            padding-left: 18px;
        }

            .rp-list li {
                margin-bottom: 4px;
            }

        .rp-foot {
            margin-top: 16px;
            padding-top: 6px;
            border-top: 1px solid #cbd5e1;
            font-size: 9pt;
            color: #64748b;
            display: flex;
            justify-content: space-between;
        }
    }

    .tk-kpi.bad {
        border-left: 3px solid #dc2626;
    }

    /* Donut <-> bảng loại sân: rê chuột / bấm để làm nổi bật */
    .tk-arc {
        cursor: pointer;
        transition: opacity .15s, stroke-width .15s;
    }

    #tk-donut.has-hl .tk-arc:not(.hl) {
        opacity: .3;
    }

    #tk-donut .tk-arc.hl {
        stroke-width: 21;
    }

    .tk-lrow {
        cursor: pointer;
        transition: background .15s;
    }

        .tk-lrow.hl td {
            background: #f0fdf4;
        }

    .tk-sortable {
        cursor: pointer;
        user-select: none;
    }

        .tk-sortable:hover {
            color: var(--ink);
        }

        .tk-sortable::after {
            content: " \2195";
            opacity: .45;
        }

        .tk-sortable.asc::after {
            content: " \25B2";
            opacity: 1;
            color: var(--pitch-2);
        }

        .tk-sortable.desc::after {
            content: " \25BC";
            opacity: 1;
            color: var(--pitch-2);
        }

    /* Hàng chỉ số nhỏ của tab Hiệu suất sân */
    .tk-mstats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .tk-mstat {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: .75rem;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: .6rem 1rem;
        min-width: 0;
    }

        .tk-mstat .l {
            font-size: .8125rem;
            color: var(--muted);
        }

        .tk-mstat .v {
            font-size: 1rem;
            font-weight: 700;
            color: var(--ink);
            white-space: nowrap;
        }

            .tk-mstat .v small {
                font-size: .8125rem;
                font-weight: 600;
                color: var(--muted);
                margin-left: .35rem;
            }

    .tk-tag {
        display: inline-block;
        margin-left: .5rem;
        padding: 0 .45rem;
        border-radius: 99px;
        background: #f1f5f9;
        color: #475569;
        font-size: .75rem;
        font-weight: 600;
        line-height: 1.5;
        vertical-align: 1px;
    }

    /* Hai cột cùng chiều cao: khối cuối của mỗi cột giãn ra cho thẳng hàng đáy */
    .tk-body.eq {
        align-items: stretch;
    }

        .tk-body.eq > .tk-stack {
            grid-template-rows: auto 1fr;
            align-content: stretch;
        }

    #tk-rk-top[hidden], #tk-rk-low[hidden] {
        display: none;
    }

    .tk-badge {
        display: inline-block;
        padding: .1rem .55rem;
        border-radius: 99px;
        font-size: .8125rem;
        font-weight: 600;
        white-space: nowrap;
        line-height: 1.5;
    }

        .tk-badge.up, .tk-badge.good {
            background: #dcfce7;
            color: #15803d;
        }

        .tk-badge.down, .tk-badge.bad {
            background: #fee2e2;
            color: #b91c1c;
        }

        .tk-badge.warn {
            background: #fef3c7;
            color: #b45309;
        }

        .tk-badge.flat, .tk-badge.new {
            background: #f1f5f9;
            color: #475569;
        }

    .tk-click {
        cursor: pointer;
        transition: border-color .15s, box-shadow .15s, transform .1s;
    }

        .tk-click:hover:not(:disabled) {
            border-color: #fca5a5;
            box-shadow: 0 2px 8px rgba(220,38,38,.12);
        }

        .tk-click:active:not(:disabled) {
            transform: scale(.99);
        }

        .tk-click:disabled {
            cursor: default;
        }

        .tk-click .go {
            color: #dc2626;
            font-weight: 600;
        }

    .tk-meter {
        height: 5px;
        border-radius: 99px;
        background: #e2e8f0;
        overflow: hidden;
        margin-top: .5rem;
    }

        .tk-meter > span {
            display: block;
            height: 100%;
            border-radius: 99px;
        }

    /* ===== Lưới thân trang ===== */
    .tk-body {
        display: grid;
        grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);   /* 60% - 40% */
        gap: 1.25rem;
        align-items: start;
    }

        .tk-body > * {
            min-width: 0;
        }

    /* ===== Bảng dữ liệu gọn: chữ 14px, tiêu đề cột 12px ===== */
    .tk-tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .tk-tbl th {
            font-size: .75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .03em;
            color: var(--muted);
            padding: .4rem .5rem;
            border-bottom: 1px solid var(--line);
            text-align: left;
            white-space: nowrap;
        }

        .tk-tbl td {
            font-size: .875rem;
            color: var(--ink);
            padding: .6rem .5rem;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .tk-tbl tr:last-child td {
            border-bottom: 0;
        }

        .tk-tbl .r {
            text-align: right;
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }

        .tk-tbl .rk {
            width: 2.2rem;
            color: var(--muted);
            font-weight: 700;
            font-size: .8125rem;
        }

        .tk-tbl tr.top td {
            font-weight: 600;
        }

        .tk-tbl tr.top .rk {
            color: var(--pitch-2);
        }

    .tk-dot {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin-right: .5rem;
        vertical-align: -1px;
    }

    /* Thanh tiến độ nhỏ dưới tên loại sân */
    .tk-mini {
        height: 4px;
        border-radius: 99px;
        background: #eef2f6;
        overflow: hidden;
        margin: .3rem 0 0 1.35rem;
    }

        .tk-mini > span {
            display: block;
            height: 100%;
            border-radius: 99px;
        }

    /* Chuyển Giờ / Buổi + biểu đồ theo buổi */
    .tk-head-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .tk-buoi {
        display: grid;
        gap: .85rem;
        padding-top: .25rem;
    }

    .tk-buoi[hidden], .tk-hplot[hidden] {
        display: none;
    }

    .tk-buoi-row {
        display: grid;
        grid-template-columns: 7.5rem minmax(0, 1fr) 5.5rem;
        align-items: center;
        gap: .75rem;
        font-size: .875rem;
    }

        .tk-buoi-row .n b {
            display: block;
            color: var(--ink);
        }

        .tk-buoi-row .n span {
            color: var(--muted);
            font-size: .8125rem;
        }

        .tk-buoi-row .tr {
            height: 18px;
            background: #eef2f6;
            border-radius: 99px;
            overflow: hidden;
        }

            .tk-buoi-row .tr > span {
                display: block;
                height: 100%;
                border-radius: 99px;
                background: var(--brand-soft);
            }

        .tk-buoi-row.top .tr > span {
            background: var(--brand-deep);
        }

        .tk-buoi-row .v {
            text-align: right;
            font-variant-numeric: tabular-nums;
            font-weight: 600;
            color: var(--ink);
        }

            .tk-buoi-row .v small {
                color: var(--muted);
                font-weight: 500;
                margin-left: .25rem;
            }

    /* ===== Biểu đồ tròn (donut) ===== */
    .tk-donut {
        position: relative;
        width: 150px;
        height: 150px;
        margin: 0 auto .75rem;
    }

        .tk-donut svg {
            width: 100%;
            height: 100%;
            display: block;
        }

    .tk-donut-c {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        line-height: 1.25;
    }

        .tk-donut-c .l {
            font-size: .75rem;
            color: var(--muted);
        }

        .tk-donut-c .v {
            font-size: .95rem;
            font-weight: 700;
            color: var(--ink);
        }

    /* ===== Biểu đồ cột theo giờ ===== */
    .tk-hplot {
        display: flex;
        gap: .4rem;
        height: 210px;
    }

    .tk-hcol {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .tk-htrack {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
        padding-top: 24px;
        border-bottom: 1px solid var(--line);
    }

    .tk-hbar {
        position: relative;
        width: 100%;
        max-width: 36px;
        min-height: 3px;
        border-radius: 6px 6px 0 0;
        background: var(--brand-soft);
        transition: background .15s;
    }

        .tk-hbar.zero {
            background: #e2e8f0;
        }

    .tk-hcol:hover .tk-hbar:not(.zero) {
        background: #22c55e;
    }

    .tk-hcol.top .tk-hbar {
        background: var(--brand-deep);
    }

    .tk-hval {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        margin-bottom: 3px;
        font-size: .8125rem;
        font-weight: 600;
        color: var(--ink);
    }

    .tk-hlab {
        text-align: center;
        font-size: .8125rem;
        color: var(--muted);
        padding-top: .35rem;
        white-space: nowrap;
    }

    .tk-hcol.top .tk-hlab {
        color: var(--pitch-2);
        font-weight: 700;
    }

    /* ===== Thẻ nhận định ===== */
    .tk-insight-card {
        background: #f0fdf4;
        border-color: #bbf7d0;
    }

    .tk-insights {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: .6rem;
        font-size: .875rem;
        line-height: 1.6;
        color: var(--ink);
    }

        .tk-insights li {
            padding-left: 1.1rem;
            position: relative;
        }

            .tk-insights li::before {
                content: "";
                position: absolute;
                left: 0;
                top: .65em;
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--brand);
            }

        .tk-insights .muted {
            color: var(--muted);
            font-size: .8125rem;
        }

    /* ===== Biểu đồ cột doanh thu (do partial _BieuDoCot vẽ) ===== */
    .tk-chart-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .tk-seg {
        display: inline-flex;
        background: #e8edf3;
        border-radius: 9px;
        padding: 2px;
        gap: 2px;
    }

        .tk-seg button {
            border: 0;
            background: transparent;
            color: var(--muted);
            font-size: .8125rem;
            font-weight: 600;
            padding: .28rem .75rem;
            border-radius: 7px;
            cursor: pointer;
            transition: background .2s ease, color .2s ease, box-shadow .2s ease, transform .1s ease;
        }

            .tk-seg button:hover:not(.on) {
                background: #d5dde7;
                color: var(--ink);
            }

            .tk-seg button:active {
                transform: scale(.97);
            }

            .tk-seg button.on {
                background: var(--pitch-2);
                color: #fff;
                box-shadow: 0 1px 3px rgba(20,83,45,.35);
            }

    /* Chiều cao vùng vẽ tự co theo màn hình: 170px - 290px */
    .tk-plot {
        --h: clamp(170px, calc(100vh - 480px), 290px);
        --pad: 36px;
        display: grid;
        grid-template-columns: 78px 1fr;
    }

    .tk-axis {
        position: relative;
        height: var(--h);
        margin-top: var(--pad);
    }

        .tk-axis span {
            position: absolute;
            right: 10px;
            transform: translateY(-50%);
            font-size: .8125rem;
            color: var(--muted);
            white-space: nowrap;
        }

    .tk-area {
        position: relative;
        padding-top: var(--pad);
        min-width: 0;
    }

        .tk-area::before {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            top: var(--pad);
            height: var(--h);
            background: linear-gradient(to bottom, var(--line) 1px, transparent 1px) 0 0 / 100% calc(var(--h) / 4);
            pointer-events: none;
        }

    .tk-cols {
        position: relative;
        display: flex;
        gap: .5rem;
    }

        .tk-cols.dense {
            gap: .25rem;
        }

    .tk-col {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .tk-col .track {
            height: var(--h);
            width: 100%;
            display: flex;
            align-items: flex-end;
            justify-content: center;
        }

        .tk-col .bar {
            position: relative;
            width: 100%;
            max-width: 48px;
            border-radius: 8px 8px 0 0;
            background: var(--brand-soft);
            min-height: 3px;
            transition: background .15s, height .25s ease;
        }

    .tk-cols.dense .tk-col .bar {
        border-radius: 4px 4px 0 0;
    }

    .tk-col:hover .bar {
        background: #22c55e;
    }

    .tk-col.top .bar {
        background: var(--brand-deep);
    }

    .tk-col.zero .bar {
        background: #cbd5e1;
    }

    .tk-col .pill {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        margin-bottom: 6px;
        white-space: nowrap;
        background: var(--ink);
        color: #fff;
        font-size: .8125rem;
        font-weight: 600;
        padding: .15rem .55rem;
        border-radius: 6px;
        opacity: 0;
        pointer-events: none;
        transition: opacity .15s;
        z-index: 2;
    }

    .tk-col.top .pill {
        background: var(--pitch);
        opacity: 1;
    }

    .tk-col:hover .pill {
        opacity: 1;
        z-index: 3;
    }

    /* Nhãn cột 13px; cột hẹp thì tự xuống dòng thay vì đè lên nhau */
    .tk-col .m {
        width: 100%;
        min-height: 1.6rem;
        text-align: center;
        font-size: .8125rem;
        line-height: 1.25;
        color: var(--muted);
        border-top: 1px solid var(--line);
        padding-top: .4rem;
        white-space: normal;
    }

    .tk-col.top .m {
        color: var(--pitch-2);
        font-weight: 700;
    }

    /* ===== Cửa sổ danh sách đơn hủy ===== */
    .tk-dialog {
        border: 0;
        border-radius: 14px;
        padding: 0;
        width: min(760px, 94vw);
        box-shadow: 0 20px 50px rgba(15,23,42,.3);
    }

        .tk-dialog::backdrop {
            background: rgba(15,23,42,.45);
        }

    .tk-dialog-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: .9rem 1.25rem;
        border-bottom: 1px solid var(--line);
    }

        .tk-dialog-head button {
            border: 0;
            background: #f1f5f9;
            border-radius: 8px;
            width: 32px;
            height: 32px;
            font-size: 1.1rem;
            line-height: 1;
            cursor: pointer;
            color: var(--muted);
        }

            .tk-dialog-head button:hover {
                background: #e2e8f0;
                color: var(--ink);
            }

    .tk-dialog-body {
        padding: .75rem 1.25rem 1.1rem;
    }

    .tk-scroll {
        max-height: 55vh;
        overflow: auto;
        border: 1px solid var(--line);
        border-radius: 10px;
    }

    .tk-table thead th {
        position: sticky;
        top: 0;
        background: #f8fafc;
        font-size: .8125rem;
        color: var(--muted);
        z-index: 1;
    }

    .tk-table td {
        font-size: .875rem;
    }

    /* ===== Trạng thái chưa có dữ liệu (giữa trang) ===== */
    .tk-void {
        min-height: 45vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: .35rem;
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        padding: 1.5rem 1rem;
    }

        .tk-void .ico {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #f0fdf4;
            color: var(--brand);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: .3rem;
        }

        .tk-void .t {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--ink);
        }

        .tk-void .s {
            color: var(--muted);
            font-size: .9rem;
        }

        .tk-void a {
            margin-top: .5rem;
            display: inline-block;
            padding: .4rem 1rem;
            border-radius: 99px;
            background: var(--pitch-2);
            color: #fff;
            font-weight: 600;
            font-size: .875rem;
            text-decoration: none;
        }

            .tk-void a:hover {
                background: var(--pitch);
            }

    /* ===== Responsive ===== */
    @@media (max-width: 1100px) {
        .tk-kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 992px) {
        .tk-body {
            grid-template-columns: 1fr;
        }

        .tk-filter {
            margin-left: 0;
        }

        .tk-tabs {
            flex-basis: 100%;
            order: 3;
        }
    }

    @@media (max-width: 760px) {
        .tk-mstats {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .tk-kpis {
            grid-template-columns: 1fr;
        }

        .tk-plot {
            grid-template-columns: 58px 1fr;
        }

        .tk-hplot {
            gap: .15rem;
        }

        .tk-hlab,
        .tk-hval {
            font-size: .75rem;
        }

        .tk-cols {
            gap: .25rem;
        }
    }
</style>

<div class="tk">

    @* ===== THANH TRÊN CÙNG (1 hàng): Tiêu đề | Tabs | Bộ lọc thời gian ===== *@
    <div class="tk-top">
        <div class="tk-title">
            <h2>Thống kê</h2>
            <div class="sub">Đang xem: <b>@nhan</b></div>
        </div>

        @if (coDuLieu)
        {
            <div class="tk-tabs" role="tablist">
                <button type="button" class="tk-tab active" role="tab" data-tab="doanh-thu" aria-selected="true">Doanh thu</button>
                <button type="button" class="tk-tab" role="tab" data-tab="hieu-suat" aria-selected="false">Hiệu suất sân</button>
                <button type="button" class="tk-tab" role="tab" data-tab="dich-vu" aria-selected="false">Dịch vụ</button>
            </div>
        }
        else
        {
            <div class="tk-tabs"></div>
        }

        <form method="get" id="tk-form" class="tk-filter">
            <input type="hidden" name="kieu" id="tk-kieu" value="@kieu" />

            <div class="tk-seg" role="group" aria-label="Khoảng thời gian">
                @foreach (var p in presets)
                {
                    <button type="button" class="@(kieu == p.Key ? "on" : "")" data-kieu="@p.Key">@p.Text</button>
                }
            </div>

            <div class="tk-sub" id="tk-sub-nam" hidden="@(kieu != "nam")">
                <select id="nam" name="nam" class="form-select" aria-label="Năm thống kê">
                    @foreach (var n in danhSachNam)
                    {
                        <option value="@n" selected="@(n == Model.Nam)">@n</option>
                    }
                </select>
            </div>

            <div class="tk-sub" id="tk-sub-tuychon" hidden="@(kieu != "tuychon")">
                <label for="tk-tu" class="mb-0">Từ</label>
                <input type="date" id="tk-tu" name="tu" class="form-control" value="@tu.ToString("yyyy-MM-dd", inv)" />
                <label for="tk-den" class="mb-0">đến</label>
                <input type="date" id="tk-den" name="den" class="form-control" value="@den.ToString("yyyy-MM-dd", inv)" />
                <button type="submit" class="tk-apply">Áp dụng</button>
            </div>
        </form>

        @if (coDuLieu)
        {
            <div class="tk-tools">
                <button type="button" class="tk-tool" id="tk-export-csv" title="Xuất Excel (.xlsx)" aria-label="Xuất Excel (.xlsx)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                </button>
                <button type="button" class="tk-tool" id="tk-export-pdf" title="In / Lưu PDF" aria-label="In / Lưu PDF">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                </button>
            </div>
        }
    </div>

    @if (!coDuLieu)
    {
        @* ===== Chưa có dữ liệu: hiện giữa trang ===== *@
        <div class="tk-void">
            <div class="ico">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="18" y1="20" x2="18" y2="10"></line>
                    <line x1="12" y1="20" x2="12" y2="4"></line>
                    <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
            </div>
            <div class="t">Chưa có dữ liệu</div>
            <div class="s">Không có đơn đặt sân nào trong khoảng thời gian này.</div>
            <a href="?kieu=nam&nam=@DateTime.Today.Year">Xem cả năm @DateTime.Today.Year</a>
        </div>
    }
    else
    {
        @* ===== Tab 1: Doanh thu - biểu đồ cột (60%) + biểu đồ tròn theo loại sân (40%) ===== *@
        <section class="tk-pane" data-pane="doanh-thu" role="tabpanel">
            @* ===== 4 thẻ chỉ số của kỳ đang xem: chỉ nằm trong tab Doanh thu ===== *@
        <div class="tk-kpis">
            <div class="tk-kpi" title="Kỳ trước (@kyTruocKhoang): @Model.DoanhThuKyTruoc.ToString("N0") đ">
                <div class="tk-kpi-top">
                    <span class="tk-kpi-label">Doanh thu</span>
                    <div class="tk-ico" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    </div>
                </div>
                <div class="tk-kpi-val">@Model.TongDoanhThuNam.ToString("N0") đ</div>
                <div class="tk-kpi-foot">
                    <span class="tk-badge @dtDelta[0]">@dtDelta[1]</span>
                    <span>@kyTruocNhan</span>
                </div>
            </div>

            <div class="tk-kpi" title="Kỳ trước (@kyTruocKhoang): @Model.LuotDatKyTruoc.ToString("N0") lượt">
                <div class="tk-kpi-top">
                    <span class="tk-kpi-label">Lượt đặt</span>
                    <div class="tk-ico" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    </div>
                </div>
                <div class="tk-kpi-val">@Model.TongLuotDat.ToString("N0")</div>
                <div class="tk-kpi-foot">
                    <span class="tk-badge @luotDelta[0]">@luotDelta[1]</span>
                    <span>@kyTruocNhan</span>
                </div>
            </div>

            <div class="tk-kpi">
                <div class="tk-kpi-top">
                    <span class="tk-kpi-label">Giá trị TB / đơn</span>
                    <div class="tk-ico" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                    </div>
                </div>
                <div class="tk-kpi-val">@trungBinh.ToString("N0") đ</div>
                <div class="tk-kpi-foot">
                    <span>Trên @Model.SoDonHoanThanh đơn hoàn thành</span>
                </div>
            </div>

            <button type="button" class="tk-kpi tk-click@(huyLop == "bad" ? " bad" : "")" id="tk-open-huy" disabled="@(Model.SoLuotHuy == 0)">
                <div class="tk-kpi-top">
                    <span class="tk-kpi-label">Tỷ lệ hủy đơn</span>
                    <div class="tk-ico red" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                    </div>
                </div>
                <div class="tk-kpi-val" style="color:@huyMau">@Model.TyLeHuy%<small>(@Model.SoLuotHuy / @Model.TongLuotDat đơn)</small></div>
                <div class="tk-kpi-foot">
                    <span class="tk-badge @huyLop">@huyIcon @huyNhan</span>
                    @if (Model.SoLuotHuy > 0)
                    {
                        <span class="tk-loss">Thất thoát <b>@(tienHuyTruncated ? "≥ " : "")@tienHuy.ToString("N0") đ</b></span>
                        <span class="go">Xem ›</span>
                    }
                </div>
                <div class="tk-meter"><span style="width:@(huyRong)%; background:@huyMau"></span></div>
            </button>
        </div>

            <div class="tk-body">
                <div>
                    <partial name="_BieuDoCot" model='new BangThongKe { TieuDe = "Doanh thu theo " + Model.DonViBieuDo, MoTa = moTaBieuDo, DonVi = "đ", LaTien = true, Items = Model.DoanhThuTheoThang }' />
                </div>

                <div class="tk-panel">
                    <div class="tk-panel-title">Cơ cấu doanh thu theo loại sân</div>
                    <div class="tk-panel-sub">Chỉ tính đơn hoàn thành · lượt đặt không tính đơn hủy</div>

                    @if (loaiRows.Count == 0)
                    {
                        <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                    }
                    else
                    {
                        <div class="tk-donut" id="tk-donut">
                            <svg viewBox="0 0 120 120" aria-hidden="true">
                                <circle cx="60" cy="60" r="44" fill="none" stroke="#e8edf3" stroke-width="18"></circle>
                                @foreach (var seg in donut)
                                {
                                    <circle cx="60" cy="60" r="44" fill="none" stroke="@seg.Mau" stroke-width="18" class="tk-arc" data-idx="@seg.Idx"
                                            stroke-dasharray="@seg.Day" stroke-dashoffset="@seg.Lech" transform="rotate(-90 60 60)"></circle>
                                }
                            </svg>
                            <div class="tk-donut-c">
                                <span class="l">Tổng</span>
                                <span class="v">@gon(tongTienLoai)</span>
                            </div>
                        </div>

                        <table class="tk-tbl">
                            <thead>
                                <tr>
                                    <th>Loại sân</th>
                                    <th class="r">Lượt đặt</th>
                                    <th class="r">Doanh thu</th>
                                    <th class="r">Tỷ lệ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int idx = 0; idx < loaiRows.Count; idx++)
                                {
                                    var dong = loaiRows[idx];
                                    string mauDot = dong.Tien > 0 ? mau[idx % mau.Length] : "#cbd5e1";
                                    string tyLeLoai = tongTienLoai > 0 ? (dong.Tien / tongTienLoai * 100m).ToString("0.#") + "%" : "–";
                                    string rongLoai = tongTienLoai > 0 ? (dong.Tien / tongTienLoai * 100m).ToString("0.##", inv) : "0";
                                    <tr class="tk-lrow @(idx == 0 && dong.Tien > 0 ? "top" : "")" data-idx="@idx">
                                        <td>
                                            <span class="tk-dot" style="background:@mauDot"></span>@dong.Ten
                                            <div class="tk-mini"><span style="width:@(rongLoai)%; background:@mauDot"></span></div>
                                        </td>
                                        <td class="r">@dong.Luot</td>
                                        <td class="r">@dong.Tien.ToString("N0") đ</td>
                                        <td class="r">@tyLeLoai</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </section>

        @* ===== Tab 2: Hiệu suất sân - khung giờ + loại sân (trái) | nhận định + xếp hạng dạng tab (phải) ===== *@
        <section class="tk-pane" data-pane="hieu-suat" role="tabpanel" hidden>
            <div class="tk-mstats">
                <div class="tk-mstat">
                    <span class="l">Sân có lượt đặt</span>
                    <span class="v">@sanCoDat / @tongSan<small>@tyLeStr(sanCoDat, tongSan)</small></span>
                </div>
                <div class="tk-mstat">
                    <span class="l">Lượt đặt TB / sân</span>
                    <span class="v">@luotTbSan.ToString("0.#")<small>lượt</small></span>
                </div>
                <div class="tk-mstat">
                    <span class="l">Khung giờ cao điểm</span>
                    <span class="v">@(kgCao != null ? kgCao.Ten : "–")</span>
                </div>
            </div>

            <div class="tk-body eq">
                <div class="tk-stack">
                    <div class="tk-panel">
                        <div class="tk-head-row">
                            <div>
                                <div class="tk-panel-title">Khung giờ khách đặt nhiều nhất</div>
                                <div class="tk-panel-sub">Số lượt đặt theo giờ bắt đầu, không tính đơn hủy</div>
                            </div>
                            @if (gioMap.Count > 0)
                            {
                                <div class="tk-seg" id="tk-gio-mode" role="group" aria-label="Cách nhóm khung giờ">
                                    <button type="button" class="on" data-gio="gio" aria-pressed="true">Theo giờ</button>
                                    <button type="button" data-gio="buoi" aria-pressed="false">Theo buổi</button>
                                </div>
                            }
                        </div>

                        @if (gioMap.Count == 0)
                        {
                            <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                        }
                        else
                        {
                            <div class="tk-buoi" id="tk-buoi" hidden>
                                @foreach (var buoi in buoiRows)
                                {
                                    string rongBuoi = buoiMax == 0 ? "0" : (buoi.Luot * 100.0 / buoiMax).ToString("0.##", inv);
                                    bool buoiDau = buoiMax > 0 && buoi.Luot == buoiMax && buoiRows.Count(x => x.Luot == buoiMax) == 1;
                                    <div class="tk-buoi-row@(buoiDau ? " top" : "")">
                                        <div class="n"><b>@buoi.Ten</b><span>@buoi.Mo</span></div>
                                        <div class="tr"><span style="width:@(rongBuoi)%"></span></div>
                                        <div class="v">@buoi.Luot<small>@tyLeStr(buoi.Luot, buoiTong)</small></div>
                                    </div>
                                }
                            </div>
                            <div class="tk-hplot" id="tk-hplot">
                                @for (int gio = gioDau; gio <= gioCuoi; gio++)
                                {
                                    var mucGioNay = gioMap.GetValueOrDefault(gio);
                                    int luotGio = mucGioNay?.SoLuong ?? 0;
                                    double phanTram = gioMax == 0 ? 0 : luotGio * 100.0 / gioMax;
                                    string lopCot = gio == gioCaoDiem ? "tk-hcol top" : "tk-hcol";
                                    string lopThanh = luotGio == 0 ? "tk-hbar zero" : "tk-hbar";
                                    string goiY = gio.ToString("00") + ":00 - " + (gio + 1).ToString("00") + ":00 · " + luotGio + " lượt"
                                                  + (mucGioNay != null ? " (" + mucGioNay.TyLe.ToString("0.#") + "%)" : "");
                                    <div class="@lopCot" title="@goiY">
                                        <div class="tk-htrack">
                                            <div class="@lopThanh" style="height:@(phanTram.ToString("0.##", inv))%">
                                                @if (luotGio > 0)
                                                {
                                                    <span class="tk-hval">@luotGio</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="tk-hlab">@(gio)h</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="tk-panel">
                        <div class="tk-panel-title">Khai thác theo loại sân</div>
                        <div class="tk-panel-sub">Tổng cộng @tongSan sân · thanh thể hiện số lượt đặt trung bình mỗi sân</div>
                        @if (sanLoaiRows.Count == 0)
                        {
                            <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                        }
                        else
                        {
                            <table class="tk-tbl">
                                <thead>
                                    <tr>
                                        <th>Loại sân</th>
                                        <th class="r">Số sân</th>
                                        <th class="r">Lượt đặt</th>
                                        <th class="r">Lượt / sân</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lr in sanLoaiRows)
                                    {
                                        string rongLr = sanLoaiMax > 0 ? (lr.TbSan / sanLoaiMax * 100).ToString("0.##", inv) : "0";
                                        <tr>
                                            <td>
                                                @lr.Ten
                                                <div class="tk-mini" style="margin:.3rem 0 0"><span style="width:@(rongLr)%; background:var(--brand)"></span></div>
                                            </td>
                                            <td class="r">@lr.SoSan</td>
                                            <td class="r">@lr.Luot</td>
                                            <td class="r">@lr.TbSan.ToString("0.#")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>

                <div class="tk-stack">
                    <div class="tk-panel tk-insight-card">
                        <div class="tk-panel-title">Nhận định nhanh</div>
                        <div class="tk-panel-sub">Dựa trên giờ bắt đầu của các đơn không bị hủy</div>
                        @if (kgCao == null)
                        {
                            <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                        }
                        else
                        {
                            <ul class="tk-insights">
                                <li>Cao điểm: <b>@kgCao.Ten</b> với @kgCao.SoLuong lượt (@kgCao.TyLe.ToString("0.#")% tổng lượt đặt).</li>
                                @if (kgThap != null && kgThap.Ten != kgCao.Ten)
                                {
                                    <li>Vắng nhất: <b>@kgThap.Ten</b>, chỉ @kgThap.SoLuong lượt. <span class="muted">Có thể cân nhắc ưu đãi cho giờ thấp điểm.</span></li>
                                }
                                @if (kg.Count == 1)
                                {
                                    <li>Toàn bộ lượt đặt tập trung vào một khung giờ duy nhất.</li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="tk-panel">
                        <div class="tk-head-row">
                            <div>
                                <div class="tk-panel-title">Xếp hạng sân</div>
                                <div class="tk-panel-sub">Tối đa 5 sân · không tính đơn hủy</div>
                            </div>
                            <div class="tk-seg" id="tk-rk-mode" role="group" aria-label="Loại xếp hạng">
                                <button type="button" class="on" data-rk="top" aria-pressed="true">Đắt khách</button>
                                <button type="button" data-rk="low" aria-pressed="false">Ít khách</button>
                            </div>
                        </div>

                        <div id="tk-rk-top">
                            @if (topSanRows.Count == 0)
                            {
                                <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                            }
                            else
                            {
                                <table class="tk-tbl">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Sân đặt nhiều nhất</th>
                                            <th class="r">Lượt đặt</th>
                                            <th class="r">Tỷ lệ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < topSanRows.Count; i++)
                                        {
                                            var san = topSanRows[i];
                                            int cungLuot = Model.LuotDatTheoSan.Count(x => x.SoLuong == san.SoLuong);
                                            <tr class="@(i == 0 ? "top" : "")">
                                                <td class="rk">#@(i + 1)</td>
                                                <td>
                                                    @san.Ten
                                                    @if (cungLuot > 1)
                                                    {
                                                        <span class="tk-tag" title="@cungLuot sân cùng @san.SoLuong lượt">Đồng hạng</span>
                                                    }
                                                </td>
                                                <td class="r">@san.SoLuong</td>
                                                <td class="r">@tyLeStr(san.SoLuong, tongLuotSan)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                int dongHangNhat = Model.LuotDatTheoSan.Count(x => x.SoLuong == topSanRows[0].SoLuong);
                                if (dongHangNhat > 1)
                                {
                                    <div class="tk-note">@dongHangNhat sân cùng dẫn đầu @topSanRows[0].SoLuong lượt; tạm xếp theo tên sân. Cần doanh thu theo sân để phân định.</div>
                                }
                            }
                        </div>

                        <div id="tk-rk-low" hidden>
                            @if (sanIt.Count == 0)
                            {
                                <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                            }
                            else
                            {
                                <table class="tk-tbl">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Sân ít khách nhất</th>
                                            <th class="r">Lượt đặt</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < sanIt.Count; i++)
                                        {
                                            <tr>
                                                <td class="rk">#@(i + 1)</td>
                                                <td>@sanIt[i].Ten</td>
                                                <td class="r">@sanIt[i].SoLuong</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="tk-note">Gồm cả sân chưa có lượt đặt nào trong kỳ. Có thể cân nhắc ưu đãi kích cầu.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @* ===== Tab 3: Dịch vụ ===== *@
        <section class="tk-pane" data-pane="dich-vu" role="tabpanel" hidden>
            <div class="tk-panel">
                <div class="tk-panel-title">Dịch vụ bán chạy</div>
                <div class="tk-panel-sub">Top 10 theo số lượng sử dụng trong kỳ, không tính đơn hủy</div>
                @if (Model.DichVuPhoBien.Count > 0)
                {
                    <div class="tk-svc-total">
                        Tổng doanh thu dịch vụ (top 10): <b>@tongDichVu.ToString("N0") đ</b>
                        @if (Model.TongDoanhThuNam > 0 && tongDichVu <= Model.TongDoanhThuNam)
                        {
                            <span class="tk-badge flat">@((tongDichVu / Model.TongDoanhThuNam * 100m).ToString("0.#"))% tổng doanh thu kỳ</span>
                        }
                    </div>
                }
                @if (Model.DichVuPhoBien.Count == 0)
                {
                    <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                }
                else
                {
                    <table class="tk-tbl" id="tk-dv-tbl">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Dịch vụ</th>
                                <th class="r tk-sortable" data-sort="q" title="Bấm để sắp xếp">Số lượng</th>
                                <th class="r tk-sortable" data-sort="v" title="Bấm để sắp xếp">Doanh thu</th>
                                <th style="width:28%">Đóng góp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int thuTu = 0; thuTu < Model.DichVuPhoBien.Count; thuTu++)
                            {
                                var dv = Model.DichVuPhoBien[thuTu];
                                decimal dongGop = tongDichVu > 0 ? dv.GiaTri / tongDichVu * 100m : 0m;
                                <tr class="@(thuTu == 0 ? "top" : "")" data-q="@dv.SoLuong" data-v="@dv.GiaTri.ToString("0.##", inv)">
                                    <td class="rk">#@(thuTu + 1)</td>
                                    <td>@dv.Ten</td>
                                    <td class="r">@dv.SoLuong.ToString("N0")</td>
                                    <td class="r">@dv.GiaTri.ToString("N0") đ</td>
                                    <td>
                                        <div class="tk-share">
                                            <div class="tk-mini" style="margin:0;flex:1"><span style="width:@(dongGop.ToString("0.##", inv))%; background:var(--brand)"></span></div>
                                            <span>@dongGop.ToString("0.#")%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="tk-note">Đóng góp = tỷ trọng doanh thu của dịch vụ trong top 10. Lợi nhuận gộp cần có giá vốn dịch vụ trong dữ liệu.</div>
                }
            </div>
        </section>

        @* ===== Báo cáo để in / lưu PDF (ẩn trên màn hình, chỉ hiện khi in) ===== *@
        @* ===== Dữ liệu cho nút "Xuất Excel": số liệu thô lấy thẳng từ model (không đọc lại từ giao diện) ===== *@
        var exportObj = new
        {
            nhan = nhan,
            soVoi = kyTruocNhan,
            ky = kyBaoCao,
            kyTruoc = kyTruocKhoang,
            kieu = kieu,
            tuISO = tu.ToString("yyyy-MM-dd", inv),
            denISO = den.ToString("yyyy-MM-dd", inv),
            donVi = Model.DonViBieuDo,
            doanhThu = Model.TongDoanhThuNam,
            doanhThuTruoc = Model.DoanhThuKyTruoc,
            luotDat = Model.TongLuotDat,
            luotDatTruoc = Model.LuotDatKyTruoc,
            donHoanThanh = Model.SoDonHoanThanh,
            luotHuy = Model.SoLuotHuy,
            thatThoat = tienHuy,
            thatThoatCat = tienHuyTruncated,
            theoKy = Model.DoanhThuTheoThang.Where(x => x.GiaTri > 0 || x.SoLuong > 0).Select(x => new { ten = x.Ten, tien = x.GiaTri, don = x.SoLuong }).ToList(),
            loai = loaiRows.Select(x => new { ten = x.Ten, luot = x.Luot, tien = x.Tien }).ToList(),
            buoi = buoiRows.Select(x => new { ten = x.Ten, mo = x.Mo, luot = x.Luot }).ToList(),
            gio = Model.KhungGio.OrderBy(x => x.Ten, StringComparer.Ordinal).Select(x => new { ten = x.Ten, luot = x.SoLuong }).ToList(),
            gioCao = kgCao == null ? null : new { ten = kgCao.Ten, luot = kgCao.SoLuong },
            gioFull = Enumerable.Range(gioDau, gioCuoi - gioDau + 1).Select(g => new { gio = g, luot = gioMap.ContainsKey(g) ? gioMap[g].SoLuong : 0 }).ToList(),
            tongSan = tongSan,
            sanCoDat = sanCoDat,
            luotTbSan = Math.Round(luotTbSan, 2),
            tongLuotSan = tongLuotSan,
            topSan = topSanRows.Select(x => new { ten = x.Ten, luot = x.SoLuong }).ToList(),
            sanIt = sanIt.Select(x => new { ten = x.Ten, luot = x.SoLuong }).ToList(),
            khaiThac = sanLoaiRows.Select(x => new { ten = x.Ten, soSan = x.SoSan, luot = x.Luot }).ToList(),
            dichVu = Model.DichVuPhoBien.Select(x => new { ten = x.Ten, soLuong = x.SoLuong, tien = x.GiaTri }).ToList(),
            donHuy = Model.DonHuy.Select(x => new
            {
                ma = x.MaDatSan,
                san = x.TenSan,
                ngayDat = x.NgayDat.ToString("yyyy-MM-dd", inv),
                gio = x.GioBatDau.ToString("HH:mm", inv) + " - " + x.GioKetThuc.ToString("HH:mm", inv) + " (" + x.GioBatDau.ToString("dd/MM", inv) + ")",
                donGia = x.DonGia
            }).ToList(),
            phanTich = phanTich
        };
        string exportJson = System.Text.Json.JsonSerializer.Serialize(exportObj);
        <script type="application/json" id="tk-export-data">@Html.Raw(exportJson)</script>

        <div class="tk-report" id="tk-report" data-title="@tieuDeTrang">
            <div class="rp-head">
                <div class="rp-org">Hệ thống quản lý đặt sân thể thao</div>
                <div class="rp-title">@tieuDeBaoCao</div>
                <div class="rp-meta">Kỳ báo cáo: <b>@kyBaoCao</b> · So sánh với kỳ trước: @kyTruocKhoang</div>
            </div>

            <div class="rp-sec">
                <h3>1. Dữ liệu tổng quan</h3>
                <table class="rp-table">
                    <thead><tr><th>Chỉ số</th><th class="r">Giá trị</th><th>So với kỳ trước</th></tr></thead>
                    <tbody>
                        <tr><td>Doanh thu (đơn hoàn thành)</td><td class="r">@tien(Model.TongDoanhThuNam)</td><td>@dtDelta[1] (kỳ trước: @tien(Model.DoanhThuKyTruoc))</td></tr>
                        <tr><td>Tổng lượt đặt</td><td class="r">@Model.TongLuotDat.ToString("N0")</td><td>@luotDelta[1] (kỳ trước: @Model.LuotDatKyTruoc.ToString("N0"))</td></tr>
                        <tr><td>Số đơn hoàn thành</td><td class="r">@Model.SoDonHoanThanh.ToString("N0")</td><td></td></tr>
                        <tr><td>Giá trị trung bình / đơn</td><td class="r">@tien(trungBinh)</td><td></td></tr>
                        <tr><td>Đơn bị hủy</td><td class="r">@Model.SoLuotHuy.ToString("N0") (@Model.TyLeHuy%)</td><td>@huyNhan</td></tr>
                        @if (Model.SoLuotHuy > 0)
                        {
                            <tr><td>Thất thoát do hủy đơn</td><td class="r">@(tienHuyTruncated ? "≥ " : "")@tien(tienHuy)</td><td></td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="rp-sec">
                <h3>2. Doanh thu theo @Model.DonViBieuDo</h3>
                @{
                    var kyCoSo = Model.DoanhThuTheoThang.Where(x => x.GiaTri > 0 || x.SoLuong > 0).ToList();
                    decimal tongKy = kyCoSo.Sum(x => x.GiaTri);
                }
                @if (kyCoSo.Count == 0)
                {
                    <div class="rp-note">Chưa có đơn hoàn thành trong kỳ này.</div>
                }
                else
                {
                    <table class="rp-table">
                        <thead><tr><th>Kỳ</th><th class="r">Doanh thu</th><th class="r">Đơn hoàn thành</th><th style="width:30%">Tỷ trọng</th></tr></thead>
                        <tbody>
                            @foreach (var ky in kyCoSo)
                            {
                                string tyKy = tongKy > 0 ? (ky.GiaTri / tongKy * 100m).ToString("0.#") : "0";
                                string rongKy = tongKy > 0 ? (ky.GiaTri / tongKy * 100m).ToString("0.##", inv) : "0";
                                <tr>
                                    <td>@ky.Ten</td>
                                    <td class="r">@tien(ky.GiaTri)</td>
                                    <td class="r">@ky.SoLuong.ToString("N0")</td>
                                    <td>@(tyKy)%<div class="rp-bar"><span style="width:@(rongKy)%"></span></div></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr><td>Tổng</td><td class="r">@tien(tongKy)</td><td class="r">@kyCoSo.Sum(x => x.SoLuong).ToString("N0")</td><td></td></tr>
                        </tfoot>
                    </table>
                    <div class="rp-note">Chỉ liệt kê các kỳ có phát sinh.</div>
                }
            </div>

            <div class="rp-sec">
                <h3>3. Cơ cấu doanh thu theo loại sân</h3>
                @if (loaiRows.Count == 0)
                {
                    <div class="rp-note">Chưa có dữ liệu.</div>
                }
                else
                {
                    <table class="rp-table">
                        <thead><tr><th>Loại sân</th><th class="r">Lượt đặt</th><th class="r">Doanh thu</th><th style="width:30%">Tỷ lệ</th></tr></thead>
                        <tbody>
                            @foreach (var lo in loaiRows)
                            {
                                string tyLo = tongTienLoai > 0 ? (lo.Tien / tongTienLoai * 100m).ToString("0.#") : "0";
                                string rongLo = tongTienLoai > 0 ? (lo.Tien / tongTienLoai * 100m).ToString("0.##", inv) : "0";
                                <tr>
                                    <td>@lo.Ten</td>
                                    <td class="r">@lo.Luot</td>
                                    <td class="r">@tien(lo.Tien)</td>
                                    <td>@(tyLo)%<div class="rp-bar"><span style="width:@(rongLo)%"></span></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="rp-sec">
                <h3>4. Hiệu suất sân</h3>
                <h4>Khung giờ đặt sân (theo buổi)</h4>
                <table class="rp-table">
                    <thead><tr><th>Buổi</th><th>Khoảng giờ</th><th class="r">Lượt đặt</th><th class="r">Tỷ lệ</th></tr></thead>
                    <tbody>
                        @foreach (var bu in buoiRows)
                        {
                            <tr><td>@bu.Ten</td><td>@bu.Mo</td><td class="r">@bu.Luot</td><td class="r">@tyLeStr(bu.Luot, buoiTong)</td></tr>
                        }
                    </tbody>
                </table>
                @if (kgCao != null)
                {
                    <div class="rp-note">Khung giờ cao điểm: @kgCao.Ten (@kgCao.SoLuong lượt, @kgCao.TyLe.ToString("0.#")%).</div>
                }

                <h4>Sân được đặt nhiều nhất</h4>
                @if (topSanRows.Count == 0)
                {
                    <div class="rp-note">Chưa có dữ liệu.</div>
                }
                else
                {
                    <table class="rp-table">
                        <thead><tr><th>#</th><th>Sân</th><th class="r">Lượt đặt</th><th class="r">Tỷ lệ</th></tr></thead>
                        <tbody>
                            @for (int ri = 0; ri < topSanRows.Count; ri++)
                            {
                                var sr = topSanRows[ri];
                                bool dongH = Model.LuotDatTheoSan.Count(x => x.SoLuong == sr.SoLuong) > 1;
                                <tr><td>@(ri + 1)</td><td>@(sr.Ten + (dongH ? " (đồng hạng)" : ""))</td><td class="r">@sr.SoLuong</td><td class="r">@tyLeStr(sr.SoLuong, tongLuotSan)</td></tr>
                            }
                        </tbody>
                    </table>
                }

                <h4>Sân ít khách nhất</h4>
                @if (sanIt.Count == 0)
                {
                    <div class="rp-note">Chưa có dữ liệu.</div>
                }
                else
                {
                    <table class="rp-table">
                        <thead><tr><th>#</th><th>Sân</th><th class="r">Lượt đặt</th></tr></thead>
                        <tbody>
                            @for (int ri = 0; ri < sanIt.Count; ri++)
                            {
                                <tr><td>@(ri + 1)</td><td>@sanIt[ri].Ten</td><td class="r">@sanIt[ri].SoLuong</td></tr>
                            }
                        </tbody>
                    </table>
                }

                <h4>Khai thác theo loại sân</h4>
                @if (sanLoaiRows.Count == 0)
                {
                    <div class="rp-note">Chưa có dữ liệu.</div>
                }
                else
                {
                    <table class="rp-table">
                        <thead><tr><th>Loại sân</th><th class="r">Số sân</th><th class="r">Lượt đặt</th><th class="r">Lượt / sân</th></tr></thead>
                        <tbody>
                            @foreach (var lk in sanLoaiRows)
                            {
                                <tr><td>@lk.Ten</td><td class="r">@lk.SoSan</td><td class="r">@lk.Luot</td><td class="r">@lk.TbSan.ToString("0.#")</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="rp-sec">
                <h3>5. Dịch vụ bán chạy</h3>
                @if (Model.DichVuPhoBien.Count == 0)
                {
                    <div class="rp-note">Chưa có dữ liệu.</div>
                }
                else
                {
                    <table class="rp-table">
                        <thead><tr><th>#</th><th>Dịch vụ</th><th class="r">Số lượng</th><th class="r">Doanh thu</th><th class="r">Đóng góp</th></tr></thead>
                        <tbody>
                            @for (int ri = 0; ri < Model.DichVuPhoBien.Count; ri++)
                            {
                                var dvr = Model.DichVuPhoBien[ri];
                                <tr>
                                    <td>@(ri + 1)</td><td>@dvr.Ten</td><td class="r">@dvr.SoLuong.ToString("N0")</td>
                                    <td class="r">@tien(dvr.GiaTri)</td>
                                    <td class="r">@(tongDichVu > 0 ? (dvr.GiaTri / tongDichVu * 100m).ToString("0.#") + "%" : "–")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr><td></td><td>Tổng (top @Model.DichVuPhoBien.Count)</td><td class="r"></td><td class="r">@tien(tongDichVu)</td><td></td></tr></tfoot>
                    </table>
                }
            </div>

            <div class="rp-sec">
                <h3>6. Phân tích &amp; nhận định</h3>
                <ul class="rp-list">
                    @foreach (var y in phanTich)
                    {
                        <li>@y</li>
                    }
                </ul>
            </div>

            <div class="rp-foot">
                <span>Doanh thu chỉ tính đơn hoàn thành; lượt đặt theo khung giờ và theo sân không tính đơn hủy.</span>
                <span>Lập lúc @DateTime.Now.ToString("HH:mm dd/MM/yyyy", inv)</span>
            </div>
        </div>

        @* ===== Cửa sổ: danh sách đơn bị hủy ===== *@
        <dialog id="tk-huy" class="tk-dialog">
            <div class="tk-dialog-head">
                <div>
                    <div class="fw-bold">Đơn bị hủy</div>
                    <div class="text-secondary small">@Model.SoLuotHuy đơn trong @nhan</div>
                </div>
                <button type="button" data-close aria-label="Đóng">&times;</button>
            </div>
            <div class="tk-dialog-body">
                <div class="tk-scroll">
                    <table class="table table-sm tk-table mb-0">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Sân</th>
                                <th>Ngày đặt</th>
                                <th>Giờ thuê</th>
                                <th class="text-end">Đơn giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var donHuy in Model.DonHuy)
                            {
                                <tr>
                                    <td>#@donHuy.MaDatSan</td>
                                    <td>@donHuy.TenSan</td>
                                    <td>@f(donHuy.NgayDat)</td>
                                    <td>@donHuy.GioBatDau.ToString("HH:mm", inv) - @donHuy.GioKetThuc.ToString("HH:mm", inv) <span class="text-secondary">(@donHuy.GioBatDau.ToString("dd/MM", inv))</span></td>
                                    <td class="text-end">@donHuy.DonGia.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.SoLuotHuy > Model.DonHuy.Count)
                {
                    <div class="text-secondary small mt-2">Chỉ hiện @Model.DonHuy.Count đơn mới nhất.</div>
                }
            </div>
        </dialog>
    }

</div>

<script>
    (function () {
        var form = document.getElementById('tk-form');
        var kieuInp = document.getElementById('tk-kieu');
        var subNam = document.getElementById('tk-sub-nam');
        var subCustom = document.getElementById('tk-sub-tuychon');
        var current = 'doanh-thu';

        // ----- Tabs (chỉ có khi đã có dữ liệu) -----
        var tabs = [].slice.call(document.querySelectorAll('.tk-tab'));
        var panes = [].slice.call(document.querySelectorAll('.tk-pane'));

        if (tabs.length) {
            current = tabs[0].dataset.tab;

            var show = function (name) {
                if (!tabs.some(function (t) { return t.dataset.tab === name; })) name = tabs[0].dataset.tab;
                current = name;
                tabs.forEach(function (t) {
                    var on = t.dataset.tab === name;
                    t.classList.toggle('active', on);
                    t.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                panes.forEach(function (p) { p.hidden = p.dataset.pane !== name; });
                // Cho biểu đồ (đường xu hướng) tính lại kích thước sau khi tab hiện ra
                window.dispatchEvent(new Event('resize'));
            };

            tabs.forEach(function (t) {
                t.addEventListener('click', function () {
                    show(t.dataset.tab);
                    history.replaceState(null, '', '#' + t.dataset.tab);
                });
            });

            show(location.hash.replace('#', ''));
        }

        // Giữ nguyên tab đang xem khi đổi bộ lọc
        form.addEventListener('submit', function () {
            if (tabs.length) form.action = location.pathname + '#' + current;
        });

        // ----- Bộ lọc thời gian -----
        var presetBtns = [].slice.call(form.querySelectorAll('[data-kieu]'));

        presetBtns.forEach(function (b) {
            b.addEventListener('click', function () {
                var k = b.dataset.kieu;
                kieuInp.value = k;

                if (k === 'tuychon') {
                    // Chỉ hiện ô chọn ngày, bấm "Áp dụng" để xem
                    presetBtns.forEach(function (x) { x.classList.toggle('on', x === b); });
                    subNam.hidden = true;
                    subCustom.hidden = false;
                    document.getElementById('tk-tu').focus();
                    return;
                }
                form.requestSubmit();
            });
        });

        document.getElementById('nam').addEventListener('change', function () {
            kieuInp.value = 'nam';
            form.requestSubmit();
        });

        // Đảo ngày nếu người dùng chọn "đến" nhỏ hơn "từ"
        var tuInp = document.getElementById('tk-tu');
        var denInp = document.getElementById('tk-den');
        form.addEventListener('submit', function () {
            if (kieuInp.value === 'tuychon' && tuInp.value && denInp.value && denInp.value < tuInp.value) {
                var tmp = tuInp.value; tuInp.value = denInp.value; denInp.value = tmp;
            }
        });

        // ----- Chuyển khung giờ: theo giờ / theo buổi -----
        var gioBtns = [].slice.call(document.querySelectorAll('#tk-gio-mode [data-gio]'));
        var gioPlot = document.getElementById('tk-hplot');
        var buoiBox = document.getElementById('tk-buoi');
        gioBtns.forEach(function (b) {
            b.addEventListener('click', function () {
                var theoBuoi = b.dataset.gio === 'buoi';
                if (gioPlot) gioPlot.hidden = theoBuoi;
                if (buoiBox) buoiBox.hidden = !theoBuoi;
                gioBtns.forEach(function (x) {
                    var on = x === b;
                    x.classList.toggle('on', on);
                    x.setAttribute('aria-pressed', on ? 'true' : 'false');
                });
            });
        });

        // ----- Xếp hạng sân: đắt khách / ít khách -----
        var rkBtns = [].slice.call(document.querySelectorAll('#tk-rk-mode [data-rk]'));
        var rkTop = document.getElementById('tk-rk-top');
        var rkLow = document.getElementById('tk-rk-low');
        rkBtns.forEach(function (b) {
            b.addEventListener('click', function () {
                var low = b.dataset.rk === 'low';
                if (rkTop) rkTop.hidden = low;
                if (rkLow) rkLow.hidden = !low;
                rkBtns.forEach(function (x) {
                    var on = x === b;
                    x.classList.toggle('on', on);
                    x.setAttribute('aria-pressed', on ? 'true' : 'false');
                });
            });
        });

        // ----- Xuất báo cáo -----
        var pdfBtn = document.getElementById('tk-export-pdf');
        if (pdfBtn) pdfBtn.addEventListener('click', function () { window.print(); });

        // Khi in / lưu PDF: tiêu đề trình duyệt (và tên file PDF) là "Báo cáo tuần ..." thay vì tên trang
        var goc = document.title;
        window.addEventListener('beforeprint', function () {
            var r = document.getElementById('tk-report');
            if (r && r.dataset.title) document.title = r.dataset.title;
        });
        window.addEventListener('afterprint', function () { document.title = goc; });

        // ----- Xuất Excel (.xlsx): tạo file ngay trên trình duyệt, không cần thư viện -----
        // XLSX-BEGIN
        var crcTable = (function () {
            var t = [], c;
            for (var n = 0; n < 256; n++) {
                c = n;
                for (var k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
                t[n] = c >>> 0;
            }
            return t;
        })();

        function crc32(b) {
            var c = 0xFFFFFFFF;
            for (var i = 0; i < b.length; i++) c = crcTable[(c ^ b[i]) & 255] ^ (c >>> 8);
            return (c ^ 0xFFFFFFFF) >>> 0;
        }

        // Đóng gói zip kiểu "store" (không nén) - đủ để Excel mở được
        function zipFiles(files) {
            var enc = new TextEncoder(), parts = [], central = [], offset = 0;
            files.forEach(function (f) {
                var name = enc.encode(f.name), data = enc.encode(f.text);
                var crc = crc32(data), size = data.length;

                var lh = new DataView(new ArrayBuffer(30));
                lh.setUint32(0, 0x04034b50, true); lh.setUint16(4, 20, true); lh.setUint16(6, 0x0800, true);
                lh.setUint16(8, 0, true); lh.setUint16(10, 0, true); lh.setUint16(12, 0x21, true);
                lh.setUint32(14, crc, true); lh.setUint32(18, size, true); lh.setUint32(22, size, true);
                lh.setUint16(26, name.length, true); lh.setUint16(28, 0, true);
                parts.push(new Uint8Array(lh.buffer), name, data);

                var ch = new DataView(new ArrayBuffer(46));
                ch.setUint32(0, 0x02014b50, true); ch.setUint16(4, 20, true); ch.setUint16(6, 20, true);
                ch.setUint16(8, 0x0800, true); ch.setUint16(10, 0, true); ch.setUint16(12, 0, true); ch.setUint16(14, 0x21, true);
                ch.setUint32(16, crc, true); ch.setUint32(20, size, true); ch.setUint32(24, size, true);
                ch.setUint16(28, name.length, true); ch.setUint16(30, 0, true); ch.setUint16(32, 0, true);
                ch.setUint16(34, 0, true); ch.setUint16(36, 0, true); ch.setUint32(38, 0, true); ch.setUint32(42, offset, true);
                central.push(new Uint8Array(ch.buffer), name);

                offset += 30 + name.length + size;
            });
            var cdSize = 0;
            central.forEach(function (p) { cdSize += p.length; });
            var end = new DataView(new ArrayBuffer(22));
            end.setUint32(0, 0x06054b50, true); end.setUint16(4, 0, true); end.setUint16(6, 0, true);
            end.setUint16(8, files.length, true); end.setUint16(10, files.length, true);
            end.setUint32(12, cdSize, true); end.setUint32(16, offset, true); end.setUint16(20, 0, true);
            return parts.concat(central, [new Uint8Array(end.buffer)]);
        }

        function colName(i) {                 // 0 -> A, 1 -> B ...
            var s = '';
            i++;
            while (i > 0) {
                var m = (i - 1) % 26;
                s = String.fromCharCode(65 + m) + s;
                i = Math.floor((i - 1) / 26);
            }
            return s;
        }
        function cn(c) { return colName(c - 1); }                 // cột đánh số từ 1
        function xref(r, c) { return cn(c) + r; }

        function xmlEsc(x) {
            return String(x).replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g, '')
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // ===== Bảng màu (cùng tông với giao diện thống kê) =====
        var P = { dark: '14532D', head: '166534', green: '16A34A', light: 'F0FDF4', mint: 'DCFCE7', zebra: 'F8FAFC',
                  line: 'CBD5E1', gray: '64748B', text: '334155', red: 'DC2626', orange: 'D97706', blue: '0EA5E9', amber: 'F59E0B' };
        var PALETTE = ['14532D', '16A34A', '4ADE80', '0EA5E9', 'F59E0B', '94A3B8'];
        var FM = {
            money: '#,##0" đ";-#,##0" đ";"–"', int: '#,##0;-#,##0;"–"', pct: '0.0%;-0.0%;"–"', dec: '0.0;-0.0;"–"',
            moneyZ: '#,##0" đ"', intZ: '#,##0', pctZ: '0.0%', decZ: '0.0', date: 'dd/mm/yyyy'
        };
        var EDGE = 'thin:' + P.line;
        var BOX = { l: EDGE, r: EDGE, t: EDGE, b: EDGE };
        var BOXTOT = { l: EDGE, r: EDGE, t: 'medium:' + P.green, b: EDGE };
        var COLW = 9.6;                                           // độ rộng 1 ô lưới
        var GRID = [2].concat([1, 2, 3, 4, 5, 6, 7, 8].map(function () { return COLW; }), [2.5],
                            [1, 2, 3, 4, 5, 6, 7, 8].map(function () { return COLW; }), [2]);   // A, B..I, J, K..R, S

        // ===== Kho kiểu ô: mỗi tổ hợp font/màu/viền/căn lề được đăng ký 1 lần =====
        function styleReg() {
            var fonts = ['<font><sz val="11"/><name val="Calibri"/></font>'];
            var fills = ['<fill><patternFill patternType="none"/></fill>', '<fill><patternFill patternType="gray125"/></fill>'];
            var borders = ['<border><left/><right/><top/><bottom/><diagonal/></border>'];
            var xfs = ['<xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/>'];
            var fmts = [], cache = {};
            var BUILTIN = { 'General': 0, '0': 1, '#,##0': 3, '0%': 9 };
            function pos(arr, x) { var i = arr.indexOf(x); if (i < 0) { arr.push(x); i = arr.length - 1; } return i; }
            function edge(tag, spec) {
                if (!spec) return '<' + tag + '/>';
                var p = spec.split(':');
                return '<' + tag + ' style="' + p[0] + '"><color rgb="FF' + p[1] + '"/></' + tag + '>';
            }
            return {
                get: function (o) {
                    var key = JSON.stringify(o);
                    if (cache[key] != null) return cache[key];
                    var fi = pos(fonts, '<font>' + (o.b ? '<b/>' : '') + (o.i ? '<i/>' : '') + '<sz val="' + (o.sz || 11) + '"/>'
                        + (o.color ? '<color rgb="FF' + o.color + '"/>' : '') + '<name val="Calibri"/></font>');
                    var fl = o.bg ? pos(fills, '<fill><patternFill patternType="solid"><fgColor rgb="FF' + o.bg + '"/><bgColor indexed="64"/></patternFill></fill>') : 0;
                    var bd = o.bd ? pos(borders, '<border>' + edge('left', o.bd.l) + edge('right', o.bd.r) + edge('top', o.bd.t) + edge('bottom', o.bd.b) + '<diagonal/></border>') : 0;
                    var nf = 0;
                    if (o.fmt) {
                        nf = BUILTIN[o.fmt];
                        if (nf == null) { var k = fmts.indexOf(o.fmt); if (k < 0) { fmts.push(o.fmt); k = fmts.length - 1; } nf = 164 + k; }
                    }
                    var al = (o.h || o.v || o.wrap || o.indent || o.shrink)
                        ? '<alignment' + (o.h ? ' horizontal="' + o.h + '"' : '') + ' vertical="' + (o.v || 'center') + '"'
                          + (o.wrap ? ' wrapText="1"' : '') + (o.indent ? ' indent="' + o.indent + '"' : '') + (o.shrink ? ' shrinkToFit="1"' : '') + '/>'
                        : '';
                    var xf = '<xf numFmtId="' + nf + '" fontId="' + fi + '" fillId="' + fl + '" borderId="' + bd + '" xfId="0"'
                        + (nf ? ' applyNumberFormat="1"' : '') + (fi ? ' applyFont="1"' : '') + (fl ? ' applyFill="1"' : '') + (bd ? ' applyBorder="1"' : '')
                        + (al ? ' applyAlignment="1">' + al + '</xf>' : '/>');
                    var idx = pos(xfs, xf);
                    cache[key] = idx;
                    return idx;
                },
                xml: function (head, NS) {
                    return head + '<styleSheet xmlns="' + NS + '">'
                        + (fmts.length ? '<numFmts count="' + fmts.length + '">' + fmts.map(function (f, i) { return '<numFmt numFmtId="' + (164 + i) + '" formatCode="' + xmlEsc(f) + '"/>'; }).join('') + '</numFmts>' : '')
                        + '<fonts count="' + fonts.length + '">' + fonts.join('') + '</fonts>'
                        + '<fills count="' + fills.length + '">' + fills.join('') + '</fills>'
                        + '<borders count="' + borders.length + '">' + borders.join('') + '</borders>'
                        + '<cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs>'
                        + '<cellXfs count="' + xfs.length + '">' + xfs.join('') + '</cellXfs>'
                        + '<cellStyles count="1"><cellStyle name="Normal" xfId="0" builtinId="0"/></cellStyles></styleSheet>';
                }
            };
        }

        // ===== Ô và Sheet =====
        function cT(v, s) { return { k: 't', v: v == null ? '' : String(v), s: s || 0 }; }
        function cN(v, s) { return { k: 'n', v: +v || 0, s: s || 0 }; }
        function cF(f, v, s) { return { k: 'f', f: f, v: v, s: s || 0 }; }

        function Sheet(name, tab) {
            this.name = name; this.tab = tab; this.cells = {}; this.merges = []; this.hts = {};
            this.cf = []; this.charts = []; this.maxR = 1; this.maxC = 1;
        }
        Sheet.prototype.put = function (r, c, cell) {
            (this.cells[r] = this.cells[r] || {})[c] = cell;
            if (r > this.maxR) this.maxR = r;
            if (c > this.maxC) this.maxC = c;
        };
        // Ô gộp ngang: giá trị ở ô đầu, các ô còn lại cùng kiểu để viền/màu vẽ đủ
        Sheet.prototype.span = function (r, c1, c2, cell) {
            this.put(r, c1, cell);
            for (var c = c1 + 1; c <= c2; c++) this.put(r, c, { k: 't', v: '', s: cell.s });
            if (c2 > c1) this.merges.push(xref(r, c1) + ':' + xref(r, c2));
        };
        Sheet.prototype.rect = function (r1, c1, r2, c2, cell) {     // ô gộp cả khối (dòng x cột)
            for (var r = r1; r <= r2; r++) for (var c = c1; c <= c2; c++) this.put(r, c, (r === r1 && c === c1) ? cell : { k: 't', v: '', s: cell.s });
            this.merges.push(xref(r1, c1) + ':' + xref(r2, c2));
        };

        // ===== Thành phần giao diện =====
        function banner(sh, S, title, sub) {
            sh.span(1, 2, 18, cT(title, S.get({ sz: 18, b: 1, color: 'FFFFFF', bg: P.dark, h: 'left', indent: 1 })));
            sh.hts[1] = 38;
            sh.span(2, 2, 18, cT(sub, S.get({ sz: 10, color: '475569', bg: P.mint, h: 'left', indent: 1 })));
            sh.hts[2] = 22;
            sh.hts[3] = 10;
        }

        function section(sh, S, r, c1, c2, text) {
            sh.span(r, c1, c2, cT(text, S.get({ sz: 12, b: 1, color: P.dark, h: 'left', bd: { b: 'medium:' + P.green } })));
            sh.hts[r] = 24;
        }

        // Thẻ chỉ số 3 dòng: nhãn - giá trị lớn - ghi chú
        function card(sh, S, r, c1, c2, label, val, note) {
            var white = 'medium:FFFFFF';
            sh.span(r, c1, c2, cT(label, S.get({ sz: 9, b: 1, color: P.gray, bg: P.light, h: 'center', bd: { l: white, r: white, t: 'medium:' + P.green } })));
            var vs = S.get({ sz: val.sz || 20, b: 1, color: val.color || P.dark, bg: P.light, h: 'center', fmt: val.fmt, shrink: 1, bd: { l: white, r: white } });
            sh.span(r + 1, c1, c2, val.text != null ? cT(val.text, vs) : cN(val.v, vs));
            sh.span(r + 2, c1, c2, cT(note.t, S.get({ sz: 9, color: note.c || P.gray, bg: P.light, h: 'center', bd: { l: white, r: white } })));
            sh.hts[r] = 20; sh.hts[r + 1] = 36; sh.hts[r + 2] = 20;
        }

        // Đoạn chữ gộp ô, tự ước lượng chiều cao
        function para(sh, S, r, c1, c2, text, kind) {
            var st = kind === 'note'
                ? S.get({ sz: 9, i: 1, color: P.gray, h: 'left', v: 'top', wrap: 1 })
                : S.get({ sz: 10, color: P.text, h: 'left', v: 'top', wrap: 1, indent: 1 });
            sh.span(r, c1, c2, cT(text, st));
            var cap = (c2 - c1 + 1) * COLW * 1.05;
            sh.hts[r] = Math.max(16, Math.ceil(String(text).length / cap) * 14 + 4);
        }

        function cellStyle(S, t, bg, tot) {
            var o = { bd: tot ? BOXTOT : BOX, v: 'center', wrap: 1 };
            if (bg) o.bg = bg;
            if (tot) o.b = 1;
            if (t === 'text') { o.h = 'left'; o.indent = 1; }
            else if (t === 'money') { o.h = 'right'; o.indent = 1; }
            else o.h = 'center';
            if (FM[t]) o.fmt = FM[t];
            return S.get(o);
        }

        // cols: [{ h, t: 'text'|'center'|'int'|'money'|'dec'|'pct'|'date', span, total:'sum', share: chỉ số cột gốc, calc: fn }]
        // Trả về vị trí các dòng để vẽ biểu đồ / đặt khối kế tiếp.
        function table(sh, S, r0, c0, cols, data, opts) {
            opts = opts || {};
            var starts = [], c = c0;
            cols.forEach(function (col) { starts.push(c); c += col.span; });
            var cEnd = c - 1, L = starts.map(cn);
            var info = { hdr: r0, first: r0 + 1, last: r0 + data.length, total: null, end: r0, starts: starts, cEnd: cEnd };

            cols.forEach(function (col, i) {
                sh.span(r0, starts[i], starts[i] + col.span - 1, cT(col.h, S.get({ b: 1, color: 'FFFFFF', bg: P.head, h: 'center', v: 'center', wrap: 1, bd: BOX })));
            });
            sh.hts[r0] = 28;

            if (!data.length) {
                sh.span(r0 + 1, c0, cEnd, cT('Chưa có dữ liệu trong kỳ này.', S.get({ sz: 10, i: 1, color: P.gray, h: 'center', bd: BOX })));
                sh.hts[r0 + 1] = 24; info.end = r0 + 1;
                return info;
            }

            var totalRow = info.last + 1;
            var sums = cols.map(function (col, i) {
                return col.total === 'sum' ? data.reduce(function (s, r) { return s + (+r[i] || 0); }, 0) : null;
            });

            data.forEach(function (row, ri) {
                var rn = info.first + ri, bg = ri % 2 ? P.zebra : null, ht = 21;
                cols.forEach(function (col, ci) {
                    var t = col.t || 'text', st = cellStyle(S, t, bg, false), a = starts[ci], b = a + col.span - 1, cell;
                    if (col.calc) { var x = col.calc(rn, L, row); cell = cF(x.f, x.v, st); }
                    else if (col.share != null) {
                        var ref = '$' + L[col.share] + '$' + totalRow, base = sums[col.share];
                        cell = cF('IF(' + ref + '=0,0,' + L[col.share] + rn + '/' + ref + ')', base ? (+row[col.share] || 0) / base : 0, st);
                    } else if (t === 'text' || t === 'center') {
                        cell = cT(row[ci], st);
                        var cap = col.span * COLW * 0.95 - 2, len = String(row[ci] == null ? '' : row[ci]).length;
                        if (len > cap) ht = Math.max(ht, Math.ceil(len / cap) * 15 + 6);
                    } else cell = cN(row[ci], st);
                    sh.span(rn, a, b, cell);
                });
                sh.hts[rn] = ht;
            });

            // Dòng tổng (công thức SUM)
            if (opts.total) {
                info.total = totalRow;
                cols.forEach(function (col, ci) {
                    var t = col.t || 'text', st = cellStyle(S, t, P.mint, true), a = starts[ci], b = a + col.span - 1, cell;
                    if (ci === 0) cell = cT(opts.totalLabel || 'Tổng', cellStyle(S, 'text', P.mint, true));
                    else if (col.calc) { var x = col.calc(totalRow, L, sums); cell = cF(x.f, x.v, st); }
                    else if (col.total === 'sum') cell = cF('SUM(' + L[ci] + info.first + ':' + L[ci] + info.last + ')', sums[ci], st);
                    else if (col.share != null) cell = cF('SUM(' + L[ci] + info.first + ':' + L[ci] + info.last + ')', sums[col.share] ? 1 : 0, st);
                    else cell = cT('', st);
                    sh.span(totalRow, a, b, cell);
                });
                sh.hts[totalRow] = 23;
                info.end = totalRow;
            } else info.end = info.last;

            // Thanh dữ liệu cho cột tỷ lệ / tỷ trọng
            cols.forEach(function (col, ci) {
                if (col.share != null) sh.cf.push(xref(info.first, starts[ci]) + ':' + xref(info.last, starts[ci] + col.span - 1));
            });
            return info;
        }

        function qref(sheetName, r1, c1, r2, c2) {
            return "'" + sheetName + "'!$" + cn(c1) + '$' + r1 + ':$' + cn(c2) + '$' + r2;
        }

        // Khung trống khi chưa có dữ liệu để vẽ biểu đồ
        function emptyChart(sh, S, r1, r2, c1, c2, msg) {
            sh.rect(r1, c1, r2, c2, cT(msg, S.get({ sz: 10, i: 1, color: P.gray, bg: P.zebra, h: 'center', bd: BOX })));
        }

        // ===== Biểu đồ (chart XML) =====
        function chartXml(ch) {
            var sz = function (n, color, bold) {
                return '<c:txPr><a:bodyPr/><a:lstStyle/><a:p><a:pPr><a:defRPr sz="' + n + '" b="' + (bold ? 1 : 0) + '"><a:solidFill><a:srgbClr val="' + color + '"/></a:solidFill></a:defRPr></a:pPr><a:endParaRPr lang="vi-VN"/></a:p></c:txPr>';
            };
            var noLine = '<c:spPr><a:ln><a:noFill/></a:ln></c:spPr>';
            var cat = '<c:cat><c:strRef><c:f>' + xmlEsc(ch.cat) + '</c:f></c:strRef></c:cat>';
            var val = '<c:val><c:numRef><c:f>' + xmlEsc(ch.val) + '</c:f></c:numRef></c:val>';
            var tx = '<c:tx><c:v>' + xmlEsc(ch.name) + '</c:v></c:tx>';
            var plot, legend = '';

            if (ch.kind === 'doughnut') {
                var pts = '';
                for (var i = 0; i < ch.n; i++) {
                    pts += '<c:dPt><c:idx val="' + i + '"/><c:bubble3D val="0"/><c:spPr><a:solidFill><a:srgbClr val="' + PALETTE[i % PALETTE.length] + '"/></a:solidFill><a:ln w="19050"><a:solidFill><a:srgbClr val="FFFFFF"/></a:solidFill></a:ln></c:spPr></c:dPt>';
                }
                plot = '<c:doughnutChart><c:varyColors val="1"/><c:ser><c:idx val="0"/><c:order val="0"/>' + tx + pts
                    + '<c:dLbls><c:numFmt formatCode="0.0%;;" sourceLinked="0"/><c:spPr><a:noFill/><a:ln><a:noFill/></a:ln></c:spPr>' + sz(900, 'FFFFFF', true)
                    + '<c:showLegendKey val="0"/><c:showVal val="0"/><c:showCatName val="0"/><c:showSerName val="0"/><c:showPercent val="1"/><c:showBubbleSize val="0"/><c:showLeaderLines val="0"/></c:dLbls>'
                    + cat + val + '</c:ser><c:firstSliceAng val="0"/><c:holeSize val="55"/></c:doughnutChart>';
                legend = '<c:legend><c:legendPos val="r"/><c:overlay val="0"/>' + sz(900, '475569', false) + '</c:legend>';
            } else {
                var horiz = ch.kind === 'bar';
                var lblFmt = ch.money ? (ch.big ? '#,##0.0,,&quot; tr&quot;;;' : '#,##0;;') : '#,##0;;';
                var axFmt = ch.money && ch.big ? '#,##0.0,,&quot; tr&quot;' : '#,##0';
                var dl = '<c:dLbls><c:numFmt formatCode="' + lblFmt + '" sourceLinked="0"/><c:spPr><a:noFill/><a:ln><a:noFill/></a:ln></c:spPr>' + sz(800, '334155', false)
                    + '<c:dLblPos val="outEnd"/><c:showLegendKey val="0"/><c:showVal val="1"/><c:showCatName val="0"/><c:showSerName val="0"/><c:showPercent val="0"/><c:showBubbleSize val="0"/></c:dLbls>';
                plot = '<c:barChart><c:barDir val="' + (horiz ? 'bar' : 'col') + '"/><c:grouping val="clustered"/><c:varyColors val="0"/>'
                    + '<c:ser><c:idx val="0"/><c:order val="0"/>' + tx + '<c:spPr><a:solidFill><a:srgbClr val="' + P.green + '"/></a:solidFill></c:spPr><c:invertIfNegative val="0"/>' + dl + cat + val + '</c:ser>'
                    + '<c:gapWidth val="' + (horiz ? 45 : 55) + '"/><c:axId val="50010"/><c:axId val="50020"/></c:barChart>'
                    + '<c:catAx><c:axId val="50010"/><c:scaling><c:orientation val="' + (horiz ? 'maxMin' : 'minMax') + '"/></c:scaling><c:delete val="0"/><c:axPos val="' + (horiz ? 'l' : 'b') + '"/>'
                    + '<c:numFmt formatCode="General" sourceLinked="0"/><c:majorTickMark val="none"/><c:minorTickMark val="none"/><c:tickLblPos val="nextTo"/>'
                    + '<c:spPr><a:ln w="9525"><a:solidFill><a:srgbClr val="CBD5E1"/></a:solidFill></a:ln></c:spPr>' + sz(800, '475569', false)
                    + '<c:crossAx val="50020"/><c:crosses val="autoZero"/><c:auto val="1"/><c:lblAlgn val="ctr"/><c:lblOffset val="100"/><c:noMultiLvlLbl val="0"/></c:catAx>'
                    + '<c:valAx><c:axId val="50020"/><c:scaling><c:orientation val="minMax"/></c:scaling><c:delete val="0"/><c:axPos val="' + (horiz ? 'b' : 'l') + '"/>'
                    + '<c:majorGridlines><c:spPr><a:ln w="6350"><a:solidFill><a:srgbClr val="E2E8F0"/></a:solidFill></a:ln></c:spPr></c:majorGridlines>'
                    + '<c:numFmt formatCode="' + axFmt + '" sourceLinked="0"/><c:majorTickMark val="none"/><c:minorTickMark val="none"/><c:tickLblPos val="nextTo"/>' + noLine + sz(800, '64748B', false)
                    + '<c:crossAx val="50010"/><c:crosses val="' + (horiz ? 'max' : 'autoZero') + '"/><c:crossBetween val="between"/></c:valAx>';
            }
            return '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                + '<c:chartSpace xmlns:c="http://schemas.openxmlformats.org/drawingml/2006/chart" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">'
                + '<c:roundedCorners val="0"/><c:chart><c:autoTitleDeleted val="1"/><c:plotArea><c:layout/>' + plot + '</c:plotArea>' + legend
                + '<c:plotVisOnly val="1"/><c:dispBlanksAs val="gap"/></c:chart>'
                + '<c:spPr><a:solidFill><a:srgbClr val="FFFFFF"/></a:solidFill><a:ln w="9525"><a:solidFill><a:srgbClr val="E2E8F0"/></a:solidFill></a:ln></c:spPr>'
                + sz(900, '475569', false) + '</c:chartSpace>';
        }

        function drawingXml(charts) {
            return '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
                + '<xdr:wsDr xmlns:xdr="http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main">'
                + charts.map(function (ch, i) {
                    return '<xdr:twoCellAnchor editAs="oneCell"><xdr:from><xdr:col>' + ch.from.c + '</xdr:col><xdr:colOff>0</xdr:colOff><xdr:row>' + ch.from.r + '</xdr:row><xdr:rowOff>0</xdr:rowOff></xdr:from>'
                        + '<xdr:to><xdr:col>' + ch.to.c + '</xdr:col><xdr:colOff>0</xdr:colOff><xdr:row>' + ch.to.r + '</xdr:row><xdr:rowOff>0</xdr:rowOff></xdr:to>'
                        + '<xdr:graphicFrame macro=""><xdr:nvGraphicFramePr><xdr:cNvPr id="' + (i + 2) + '" name="Biểu đồ ' + (i + 1) + '"/><xdr:cNvGraphicFramePr/></xdr:nvGraphicFramePr>'
                        + '<xdr:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/></xdr:xfrm><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/chart">'
                        + '<c:chart xmlns:c="http://schemas.openxmlformats.org/drawingml/2006/chart" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" r:id="rId' + (i + 1) + '"/>'
                        + '</a:graphicData></a:graphic></xdr:graphicFrame><xdr:clientData/></xdr:twoCellAnchor>';
                }).join('') + '</xdr:wsDr>';
        }

        function cellXml(c, ref) {
            if (c.k === 't') {
                if (c.v === '') return '<c r="' + ref + '" s="' + c.s + '"/>';
                return '<c r="' + ref + '" s="' + c.s + '" t="inlineStr"><is><t xml:space="preserve">' + xmlEsc(c.v) + '</t></is></c>';
            }
            if (c.k === 'n') return '<c r="' + ref + '" s="' + c.s + '"><v>' + c.v + '</v></c>';
            var isStr = typeof c.v === 'string';
            return '<c r="' + ref + '" s="' + c.s + '"' + (isStr ? ' t="str"' : '') + '><f>' + xmlEsc(c.f) + '</f><v>' + xmlEsc(c.v) + '</v></c>';
        }

        function sheetXml(sh, selected, head, NS, RNS) {
            var rows = {}, r, c;
            Object.keys(sh.cells).forEach(function (k) { rows[k] = true; });
            Object.keys(sh.hts).forEach(function (k) { rows[k] = true; });
            var data = Object.keys(rows).map(Number).sort(function (a, b) { return a - b; }).map(function (rn) {
                var ht = sh.hts[rn], attrs = ht ? ' ht="' + ht + '" customHeight="1"' : '';
                var rc = sh.cells[rn];
                if (!rc) return '<row r="' + rn + '"' + attrs + '/>';
                return '<row r="' + rn + '"' + attrs + '>' + Object.keys(rc).map(Number).sort(function (a, b) { return a - b; })
                    .map(function (cc) { return cellXml(rc[cc], xref(rn, cc)); }).join('') + '</row>';
            }).join('');

            var cols = '<cols>' + GRID.map(function (w, i) { return '<col min="' + (i + 1) + '" max="' + (i + 1) + '" width="' + w + '" customWidth="1"/>'; }).join('') + '</cols>';
            var cf = sh.cf.map(function (ref, i) {
                return '<conditionalFormatting sqref="' + ref + '"><cfRule type="dataBar" priority="' + (i + 1) + '"><dataBar><cfvo type="num" val="0"/><cfvo type="num" val="1"/><color rgb="FFBBF7D0"/></dataBar></cfRule></conditionalFormatting>';
            }).join('');

            return head + '<worksheet xmlns="' + NS + '" xmlns:r="' + RNS + '"><sheetPr><tabColor rgb="FF' + sh.tab + '"/><pageSetUpPr fitToPage="1"/></sheetPr>'
                + '<dimension ref="A1:' + xref(sh.maxR, Math.max(sh.maxC, 19)) + '"/>'
                + '<sheetViews><sheetView showGridLines="0"' + (selected ? ' tabSelected="1"' : '') + ' workbookViewId="0"><selection activeCell="A1" sqref="A1"/></sheetView></sheetViews>'
                + '<sheetFormatPr defaultRowHeight="15"/>' + cols + '<sheetData>' + data + '</sheetData>'
                + (sh.merges.length ? '<mergeCells count="' + sh.merges.length + '">' + sh.merges.map(function (m) { return '<mergeCell ref="' + m + '"/>'; }).join('') + '</mergeCells>' : '')
                + cf
                + '<pageMargins left="0.4" right="0.4" top="0.5" bottom="0.5" header="0.3" footer="0.3"/>'
                + '<pageSetup paperSize="9" orientation="landscape" fitToWidth="1" fitToHeight="0"/>'
                + (sh.charts.length ? '<drawing r:id="rId1"/>' : '')
                + '</worksheet>';
        }

        function buildXlsx(sheets, S) {
            var NS = 'http://schemas.openxmlformats.org/spreadsheetml/2006/main';
            var RNS = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships';
            var PKG = 'http://schemas.openxmlformats.org/package/2006/relationships';
            var head = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>';
            var files = [], overrides = '', sheetTags = '', rels = '', chartNo = 0, drawNo = 0;

            sheets.forEach(function (sh, i) {
                var n = i + 1;
                files.push({ name: 'xl/worksheets/sheet' + n + '.xml', text: sheetXml(sh, i === 0, head, NS, RNS) });
                overrides += '<Override PartName="/xl/worksheets/sheet' + n + '.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>';
                sheetTags += '<sheet name="' + xmlEsc(sh.name) + '" sheetId="' + n + '" r:id="rId' + n + '"/>';
                rels += '<Relationship Id="rId' + n + '" Type="' + RNS + '/worksheet" Target="worksheets/sheet' + n + '.xml"/>';

                if (sh.charts.length) {
                    drawNo++;
                    files.push({ name: 'xl/worksheets/_rels/sheet' + n + '.xml.rels', text: head + '<Relationships xmlns="' + PKG + '"><Relationship Id="rId1" Type="' + RNS + '/drawing" Target="../drawings/drawing' + drawNo + '.xml"/></Relationships>' });
                    files.push({ name: 'xl/drawings/drawing' + drawNo + '.xml', text: drawingXml(sh.charts) });
                    overrides += '<Override PartName="/xl/drawings/drawing' + drawNo + '.xml" ContentType="application/vnd.openxmlformats-officedocument.drawing+xml"/>';
                    var drels = '';
                    sh.charts.forEach(function (ch, j) {
                        chartNo++;
                        files.push({ name: 'xl/charts/chart' + chartNo + '.xml', text: chartXml(ch) });
                        overrides += '<Override PartName="/xl/charts/chart' + chartNo + '.xml" ContentType="application/vnd.openxmlformats-officedocument.drawingml.chart+xml"/>';
                        drels += '<Relationship Id="rId' + (j + 1) + '" Type="' + RNS + '/chart" Target="../charts/chart' + chartNo + '.xml"/>';
                    });
                    files.push({ name: 'xl/drawings/_rels/drawing' + drawNo + '.xml.rels', text: head + '<Relationships xmlns="' + PKG + '">' + drels + '</Relationships>' });
                }
            });
            rels += '<Relationship Id="rId' + (sheets.length + 1) + '" Type="' + RNS + '/styles" Target="styles.xml"/>';

            return zipFiles([
                { name: '[Content_Types].xml', text: head + '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>' + overrides + '</Types>' },
                { name: '_rels/.rels', text: head + '<Relationships xmlns="' + PKG + '"><Relationship Id="rId1" Type="' + RNS + '/officeDocument" Target="xl/workbook.xml"/></Relationships>' },
                { name: 'xl/workbook.xml', text: head + '<workbook xmlns="' + NS + '" xmlns:r="' + RNS + '"><bookViews><workbookView activeTab="0" tabRatio="800"/></bookViews><sheets>' + sheetTags + '</sheets><calcPr fullCalcOnLoad="1"/></workbook>' },
                { name: 'xl/_rels/workbook.xml.rels', text: head + '<Relationships xmlns="' + PKG + '">' + rels + '</Relationships>' },
                { name: 'xl/styles.xml', text: S.xml(head, NS) }
            ].concat(files));
        }
        // XLSX-END

        // ===== Dựng nội dung từng tab (dữ liệu thô do server nhúng trong trang) =====
        function buildSheets(d, S) {
            var sheets = [];
            var xuatLuc = new Date().toLocaleString('vi-VN');
            var pad2 = function (n) { return (n < 10 ? '0' : '') + n; };
            var cap1 = function (s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; };
            var ratio = function (a, b) { return b ? a / b : 0; };
            var vnPct = function (x) { return (x * 100).toFixed(1).replace('.', ',') + '%'; };
            var vnMoney = function (v) { return Math.round(v).toLocaleString('vi-VN') + ' đ'; };
            var sub = 'Kỳ báo cáo: ' + d.nhan + '   |   So sánh với: ' + d.kyTruoc + '   |   Xuất lúc ' + xuatLuc;

            function delta(cur, prev) {
                if (!prev) return { t: cur ? 'Chưa có dữ liệu kỳ trước' : '–', c: P.gray };
                var p = (cur - prev) / prev;
                if (Math.abs(p) < 0.0005) return { t: '= 0% ' + d.soVoi, c: P.gray };
                return { t: (p > 0 ? '▲ ' : '▼ ') + vnPct(Math.abs(p)) + ' ' + d.soVoi, c: p > 0 ? P.green : P.red };
            }
            var tbBinh = d.donHoanThanh > 0 ? Math.round(d.doanhThu / d.donHoanThanh) : 0;
            var tyHuy = ratio(d.luotHuy, d.luotDat);
            var huyMau = tyHuy < 0.1 ? P.green : (tyHuy < 0.2 ? P.orange : P.red);
            var thatThoatTxt = (d.thatThoatCat ? '≥ ' : '') + vnMoney(d.thatThoat);

            // ================= TAB 1: DOANH THU =================
            var s1 = new Sheet('Doanh thu', P.green);
            banner(s1, S, 'THỐNG KÊ ĐẶT SÂN  ·  DOANH THU', sub);
            card(s1, S, 4, 2, 5, 'DOANH THU', { v: d.doanhThu, fmt: FM.moneyZ }, delta(d.doanhThu, d.doanhThuTruoc));
            card(s1, S, 4, 6, 9, 'LƯỢT ĐẶT', { v: d.luotDat, fmt: FM.intZ }, delta(d.luotDat, d.luotDatTruoc));
            card(s1, S, 4, 11, 14, 'GIÁ TRỊ TB / ĐƠN', { v: tbBinh, fmt: FM.moneyZ }, { t: 'Trên ' + d.donHoanThanh + ' đơn hoàn thành' });
            card(s1, S, 4, 15, 18, 'TỶ LỆ HỦY ĐƠN', { v: tyHuy, fmt: FM.pctZ, color: huyMau },
                { t: d.luotHuy + ' / ' + d.luotDat + ' đơn' + (d.luotHuy > 0 ? '  ·  mất ' + thatThoatTxt : ''), c: d.luotHuy > 0 ? huyMau : P.gray });
            s1.hts[7] = 12;

            section(s1, S, 8, 2, 9, 'Doanh thu theo ' + d.donVi);
            section(s1, S, 8, 11, 18, 'Cơ cấu doanh thu theo loại sân');
            var CH1 = 9, CH2 = 23;                                   // vùng đặt biểu đồ: dòng 9 - 23
            s1.hts[24] = 12;

            var tl = table(s1, S, 25, 2, [
                { h: cap1(d.donVi), t: 'text', span: 2 },
                { h: 'Doanh thu', t: 'money', span: 2, total: 'sum' },
                { h: 'Đơn hoàn thành', t: 'int', span: 2, total: 'sum' },
                { h: 'Tỷ trọng', t: 'pct', span: 2, share: 1 }
            ], d.theoKy.map(function (x) { return [x.ten, x.tien, x.don, 0]; }), { total: true });

            var tr = table(s1, S, 25, 11, [
                { h: 'Loại sân', t: 'text', span: 3 },
                { h: 'Lượt đặt', t: 'int', span: 2, total: 'sum' },
                { h: 'Doanh thu', t: 'money', span: 2, total: 'sum' },
                { h: 'Tỷ lệ', t: 'pct', span: 1, share: 2 }
            ], d.loai.map(function (x) { return [x.ten, x.luot, x.tien, 0]; }), { total: true });

            var coDT = d.theoKy.some(function (x) { return x.tien > 0; });
            if (coDT) {
                var maxKy = Math.max.apply(null, d.theoKy.map(function (x) { return x.tien; }));
                s1.charts.push({ kind: 'col', name: 'Doanh thu', money: true, big: maxKy >= 1000000, from: { c: 1, r: CH1 - 1 }, to: { c: 9, r: CH2 },
                    cat: qref(s1.name, tl.first, tl.starts[0], tl.last, tl.starts[0]), val: qref(s1.name, tl.first, tl.starts[1], tl.last, tl.starts[1]) });
                s1.charts.push({ kind: 'doughnut', name: 'Doanh thu', n: d.loai.length, from: { c: 10, r: CH1 - 1 }, to: { c: 18, r: CH2 },
                    cat: qref(s1.name, tr.first, tr.starts[0], tr.last, tr.starts[0]), val: qref(s1.name, tr.first, tr.starts[2], tr.last, tr.starts[2]) });
            } else {
                emptyChart(s1, S, CH1, CH2, 2, 9, 'Chưa có doanh thu trong kỳ này');
                emptyChart(s1, S, CH1, CH2, 11, 18, 'Chưa có doanh thu trong kỳ này');
            }

            // Nhận định đặt dưới cả hai bảng, trải hết chiều ngang để không làm lệch chiều cao các dòng bảng
            var rn1 = Math.max(tl.end, tr.end) + 2;
            section(s1, S, rn1, 2, 18, 'Nhận định nhanh');
            d.phanTich.forEach(function (t, i) { para(s1, S, rn1 + 1 + i, 2, 18, '• ' + t, 'para'); });
            para(s1, S, rn1 + d.phanTich.length + 2, 2, 18, 'Doanh thu chỉ tính đơn hoàn thành; lượt đặt không tính đơn hủy.', 'note');
            sheets.push(s1);

            // ================= TAB 2: HIỆU SUẤT SÂN =================
            var s2 = new Sheet('Hiệu suất sân', P.blue);
            banner(s2, S, 'THỐNG KÊ ĐẶT SÂN  ·  HIỆU SUẤT SÂN', sub);
            card(s2, S, 4, 2, 5, 'KHUNG GIỜ CAO ĐIỂM', d.gioCao ? { text: d.gioCao.ten, sz: 16 } : { text: '–', sz: 16 },
                { t: d.gioCao ? d.gioCao.luot + ' lượt  ·  ' + vnPct(ratio(d.gioCao.luot, d.tongLuotSan)) + ' tổng lượt' : 'Chưa có dữ liệu' });
            card(s2, S, 4, 6, 9, 'TỔNG LƯỢT ĐẶT', { v: d.tongLuotSan, fmt: FM.intZ }, { t: 'Không tính đơn hủy' });
            card(s2, S, 4, 11, 14, 'SỐ SÂN', { v: d.tongSan, fmt: FM.intZ }, { t: d.sanCoDat + ' sân có lượt đặt' });
            card(s2, S, 4, 15, 18, 'LƯỢT TB / SÂN', { v: d.luotTbSan, fmt: FM.decZ }, { t: 'Trung bình mỗi sân' });
            s2.hts[7] = 12;

            section(s2, S, 8, 2, 9, 'Lượt đặt theo khung giờ');
            s2.hts[24] = 12;
            var buoiCua = function (h) { return h < 12 ? 'Sáng' : (h < 18 ? 'Chiều' : 'Tối'); };
            var tg = table(s2, S, 25, 2, [
                { h: 'Giờ bắt đầu', t: 'center', span: 2 },
                { h: 'Lượt đặt', t: 'int', span: 2, total: 'sum' },
                { h: 'Tỷ lệ', t: 'pct', span: 2, share: 1 },
                { h: 'Buổi', t: 'center', span: 2 }
            ], d.gioFull.map(function (x) { return [pad2(x.gio) + ':00', x.luot, 0, buoiCua(x.gio)]; }), { total: true });
            if (d.gioFull.some(function (x) { return x.luot > 0; })) {
                s2.charts.push({ kind: 'col', name: 'Lượt đặt', from: { c: 1, r: 8 }, to: { c: 9, r: 23 },
                    cat: qref(s2.name, tg.first, tg.starts[0], tg.last, tg.starts[0]), val: qref(s2.name, tg.first, tg.starts[1], tg.last, tg.starts[1]) });
            } else emptyChart(s2, S, 9, 23, 2, 9, 'Chưa có lượt đặt trong kỳ này');

            section(s2, S, 8, 11, 18, 'Theo buổi trong ngày');
            var tb = table(s2, S, 9, 11, [
                { h: 'Buổi', t: 'text', span: 2 },
                { h: 'Khoảng giờ', t: 'center', span: 2 },
                { h: 'Lượt đặt', t: 'int', span: 2, total: 'sum' },
                { h: 'Tỷ lệ', t: 'pct', span: 2, share: 2 }
            ], d.buoi.map(function (x) { return [x.ten, x.mo, x.luot, 0]; }), { total: true });

            var rkCols = [
                { h: 'Hạng', t: 'center', span: 1 }, { h: 'Sân', t: 'text', span: 4 },
                { h: 'Lượt đặt', t: 'int', span: 1 }, { h: 'Tỷ lệ', t: 'pct', span: 2 }
            ];
            var rr = tb.end + 2;
            section(s2, S, rr, 11, 18, 'Sân được đặt nhiều nhất');
            var t3 = table(s2, S, rr + 1, 11, rkCols, d.topSan.map(function (x, i) { return ['#' + (i + 1), x.ten, x.luot, ratio(x.luot, d.tongLuotSan)]; }));
            rr = t3.end + 2;
            section(s2, S, rr, 11, 18, 'Sân ít khách nhất');
            var t4 = table(s2, S, rr + 1, 11, rkCols, d.sanIt.map(function (x, i) { return ['#' + (i + 1), x.ten, x.luot, ratio(x.luot, d.tongLuotSan)]; }));
            rr = t4.end + 2;
            section(s2, S, rr, 11, 18, 'Khai thác theo loại sân');
            table(s2, S, rr + 1, 11, [
                { h: 'Loại sân', t: 'text', span: 3 },
                { h: 'Số sân', t: 'int', span: 1, total: 'sum' },
                { h: 'Lượt đặt', t: 'int', span: 2, total: 'sum' },
                { h: 'Lượt / sân', t: 'dec', span: 2, calc: function (rn, L, row) {
                    var so = +row[1] || 0, luot = +row[2] || 0;
                    return { f: 'IF(' + L[1] + rn + '=0,0,' + L[2] + rn + '/' + L[1] + rn + ')', v: so ? luot / so : 0 };
                } }
            ], d.khaiThac.map(function (x) { return [x.ten, x.soSan, x.luot, 0]; }), { total: true });
            sheets.push(s2);

            // ================= TAB 3: DỊCH VỤ =================
            var s3 = new Sheet('Dịch vụ', P.amber);
            banner(s3, S, 'THỐNG KÊ ĐẶT SÂN  ·  DỊCH VỤ', sub);
            var dv = d.dichVu, tongDv = dv.reduce(function (a, x) { return a + x.tien; }, 0), tongSl = dv.reduce(function (a, x) { return a + x.soLuong; }, 0);
            var dvTop = dv.length ? dv.reduce(function (a, x) { return x.soLuong > a.soLuong ? x : a; }, dv[0]) : null;
            var dvTien = dv.length ? dv.reduce(function (a, x) { return x.tien > a.tien ? x : a; }, dv[0]) : null;
            card(s3, S, 4, 2, 5, 'DOANH THU DỊCH VỤ', { v: tongDv, fmt: FM.moneyZ }, { t: d.doanhThu > 0 ? vnPct(ratio(tongDv, d.doanhThu)) + ' tổng doanh thu kỳ' : 'Chưa có doanh thu' });
            card(s3, S, 4, 6, 9, 'TỔNG SỐ LƯỢNG', { v: tongSl, fmt: FM.intZ }, { t: 'Top ' + dv.length + ' dịch vụ' });
            card(s3, S, 4, 11, 14, 'DÙNG NHIỀU NHẤT', { text: dvTop ? dvTop.ten : '–', sz: 14 }, { t: dvTop ? dvTop.soLuong + ' lượt sử dụng' : 'Chưa có dữ liệu' });
            card(s3, S, 4, 15, 18, 'DOANH THU CAO NHẤT', { text: dvTien ? dvTien.ten : '–', sz: 14 }, { t: dvTien ? vnMoney(dvTien.tien) : 'Chưa có dữ liệu' });
            s3.hts[7] = 12;
            section(s3, S, 8, 2, 9, 'Doanh thu theo dịch vụ');
            section(s3, S, 8, 11, 18, 'Tỷ trọng đóng góp');
            s3.hts[24] = 12;
            var t5 = table(s3, S, 25, 2, [
                { h: 'Hạng', t: 'center', span: 1 }, { h: 'Dịch vụ', t: 'text', span: 7 },
                { h: 'Số lượng', t: 'int', span: 3, total: 'sum' }, { h: 'Doanh thu', t: 'money', span: 3, total: 'sum' },
                { h: 'Đóng góp', t: 'pct', span: 3, share: 3 }
            ], dv.map(function (x, i) { return ['#' + (i + 1), x.ten, x.soLuong, x.tien, 0]; }), { total: true, totalLabel: 'Tổng' });
            para(s3, S, t5.end + 1, 2, 18, 'Đóng góp = tỷ trọng doanh thu của từng dịch vụ trong nhóm top; không tính đơn hủy.', 'note');
            if (tongDv > 0) {
                s3.charts.push({ kind: 'bar', name: 'Doanh thu', money: true, big: false, from: { c: 1, r: 8 }, to: { c: 9, r: 23 },
                    cat: qref(s3.name, t5.first, t5.starts[1], t5.last, t5.starts[1]), val: qref(s3.name, t5.first, t5.starts[3], t5.last, t5.starts[3]) });
                s3.charts.push({ kind: 'doughnut', name: 'Doanh thu', n: dv.length, from: { c: 10, r: 8 }, to: { c: 18, r: 23 },
                    cat: qref(s3.name, t5.first, t5.starts[1], t5.last, t5.starts[1]), val: qref(s3.name, t5.first, t5.starts[3], t5.last, t5.starts[3]) });
            } else {
                emptyChart(s3, S, 9, 23, 2, 9, 'Chưa có doanh thu dịch vụ trong kỳ này');
                emptyChart(s3, S, 9, 23, 11, 18, 'Chưa có doanh thu dịch vụ trong kỳ này');
            }
            sheets.push(s3);

            // ================= TAB 4: ĐƠN HỦY (chỉ khi có) =================
            if (d.donHuy.length) {
                var s4 = new Sheet('Đơn hủy', P.red);
                banner(s4, S, 'THỐNG KÊ ĐẶT SÂN  ·  ĐƠN BỊ HỦY', sub);
                var tongHuy = d.donHuy.reduce(function (a, x) { return a + x.donGia; }, 0);
                card(s4, S, 4, 2, 5, 'SỐ ĐƠN HỦY', { v: d.luotHuy, fmt: FM.intZ, color: P.red }, { t: 'Trên tổng ' + d.luotDat + ' lượt đặt' });
                card(s4, S, 4, 6, 9, 'TỶ LỆ HỦY', { v: tyHuy, fmt: FM.pctZ, color: huyMau }, { t: tyHuy < 0.1 ? 'Ở mức tốt' : (tyHuy < 0.2 ? 'Cần theo dõi' : 'Tỷ lệ cao'), c: huyMau });
                card(s4, S, 4, 11, 14, 'THẤT THOÁT', { v: d.thatThoat, fmt: FM.moneyZ, color: P.red }, { t: d.thatThoatCat ? 'Tối thiểu (danh sách bị cắt bớt)' : 'Tổng đơn giá các đơn hủy' });
                card(s4, S, 4, 15, 18, 'ĐƠN GIÁ TB / ĐƠN HỦY', { v: d.donHuy.length ? Math.round(tongHuy / d.donHuy.length) : 0, fmt: FM.moneyZ }, { t: 'Tính trên ' + d.donHuy.length + ' đơn trong danh sách' });
                s4.hts[7] = 12;
                section(s4, S, 8, 2, 18, 'Danh sách đơn bị hủy');
                var t6 = table(s4, S, 9, 2, [
                    { h: 'Mã đơn', t: 'center', span: 2 }, { h: 'Sân', t: 'text', span: 6 },
                    { h: 'Ngày đặt', t: 'date', span: 3 }, { h: 'Giờ thuê', t: 'center', span: 3 },
                    { h: 'Đơn giá', t: 'money', span: 3, total: 'sum' }
                ], d.donHuy.map(function (x) { return ['#' + x.ma, x.san, excelDate(x.ngayDat), x.gio, x.donGia]; }), { total: true });
                if (d.thatThoatCat) para(s4, S, t6.end + 1, 2, 18, 'Danh sách đã bị cắt bớt: tổng tiền chỉ là mức tối thiểu so với tổng ' + d.luotHuy + ' đơn hủy.', 'note');
                sheets.push(s4);
            }
            return sheets;
        }

        // 'yyyy-MM-dd' -> số ngày kiểu Excel
        function excelDate(iso) {
            var p = String(iso).split('-');
            return Math.round(Date.UTC(+p[0], +p[1] - 1, +p[2]) / 86400000) + 25569;
        }

        var xlsxBtn = document.getElementById('tk-export-csv');
        if (xlsxBtn) xlsxBtn.addEventListener('click', function () {
            try {
                var d = JSON.parse(document.getElementById('tk-export-data').textContent);
                var S = styleReg();
                var blob = new Blob(buildXlsx(buildSheets(d, S), S), { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                var a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = 'thong-ke-dat-san_' + d.tuISO + '_' + d.denISO + '.xlsx';
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
            } catch (err) {
                console.error(err);
                alert('Không thể xuất file Excel: ' + (err && err.message ? err.message : err));
            }
        });

        // ----- Cửa sổ danh sách đơn hủy -----
        var dlg = document.getElementById('tk-huy');
        var openBtn = document.getElementById('tk-open-huy');
        if (dlg && openBtn) {
            openBtn.addEventListener('click', function () { dlg.showModal(); });
            dlg.querySelector('[data-close]').addEventListener('click', function () { dlg.close(); });
            dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
        }
    })();
</script>
