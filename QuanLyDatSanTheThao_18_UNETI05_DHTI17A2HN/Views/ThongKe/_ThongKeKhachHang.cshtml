    .kh-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16px; }
    .kh-grid.w32 { grid-template-columns:minmax(0,3fr) minmax(0,2fr); }
    .kh-card { background:#fff; border:1px solid var(--kh-line); border-radius:12px; padding:16px 20px; }
    .kh-card + .kh-card { margin-top:16px; }
    .kh-grid > .kh-card + .kh-card { margin-top:0; }
    .kh-card h3 { font-size:17px; font-weight:600; color:var(--kh-head); margin:0 0 2px; }
