    .kh-ins .t .ic { flex:none; font-size:12px; font-weight:700; padding:1px 8px; border-radius:999px; margin-top:2px; }
    .kh-ins.good .ic { background:#d1fae5; color:#065f46; } .kh-ins.warn .ic { background:#fef3c7; color:#78350f; }
    .kh-ins.bad .ic { background:#fee2e2; color:#991b1b; } .kh-ins.info .ic { background:#dbeafe; color:#1e40af; }
