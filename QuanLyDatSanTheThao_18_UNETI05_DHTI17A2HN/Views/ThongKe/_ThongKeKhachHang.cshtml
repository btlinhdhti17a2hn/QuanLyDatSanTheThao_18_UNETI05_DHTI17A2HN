    .kh-sec .no { color:var(--kh-accent); margin-right:8px; }
    .kh-sec small { display:block; font-size:14px; font-weight:400; color:var(--kh-sub); margin-top:2px; }

    .kh-period { background:var(--kh-bg); border:1px solid var(--kh-line); border-radius:10px; padding:10px 16px; margin-bottom:8px; font-size:14.5px; color:var(--kh-text); }
