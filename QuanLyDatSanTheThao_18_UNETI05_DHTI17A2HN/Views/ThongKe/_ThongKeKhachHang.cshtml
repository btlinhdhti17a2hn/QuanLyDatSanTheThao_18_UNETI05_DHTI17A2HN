               color:var(--kh-text); font-size:15px; line-height:1.5; }
    .kh-wrap * { box-sizing:border-box; }
    .kh-wrap b { font-weight:600; color:var(--kh-ink); }
    .kh-sec { font-size:18px; font-weight:600; color:var(--kh-head); margin:32px 0 12px; scroll-margin-top:12px; }
