@*
    Tab "Khách hàng" của trang Thống kê chi tiết.
    Dữ liệu do ThongKeController.TinhThongKeKhachHangAsync tạo ra (nằm ở ThongKeViewModel.KhachHang).
    Model của partial là ThongKeViewModel (giống các tab khác), nên gọi trong ThongKe.cshtml
    không cần truyền model:
        <partial name="_ThongKeKhachHang" />
    Biểu đồ vẽ bằng HTML/CSS (không dùng thư viện ngoài) nên không thể lỗi JS/CDN.

    Bố cục (đi từ "tình hình" đến "hành động"):
        01 Tình hình khách hàng       - 4 KPI chính, đọc trong 10-15 giây
        02 Những vấn đề cần chú ý     - 3 cảnh báo tổng hợp (rủi ro vận hành / giữ chân / doanh thu), bấm để nhảy tới chi tiết
        03 Xu hướng khách hàng        - khách đăng ký mới, khách đặt lại
        04 Phân tích nhóm khách       - giá trị khách tái đặt, hạng thành viên, A. phân loại trong kỳ (loại trừ nhau), B. nhóm cần chăm sóc
        05 Khách hàng giá trị nhất    - top khách + mức độ tập trung doanh thu
        06 Cảnh báo và rủi ro         - đơn hủy, khách hủy lặp lại

    Quy ước chữ: nội dung #334155 (14-15px), mô tả #475569 (14px), tiêu đề #1E293B,
    số liệu chính #172B4D; không dùng chữ nhỏ hơn 12px (bảng không nhỏ hơn 13px).
    Màu: xanh lá = tốt / khách trung thành, xanh dương = thông tin / trung tính,
         vàng cam = cần chú ý, đỏ = rủi ro, xám = phụ / chưa có dữ liệu.
*@
@using System.Globalization
@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.ViewModels.ThongKeViewModel

@functions {
    static readonly CultureInfo Vn = new CultureInfo("vi-VN");

    // Ngưỡng cảnh báo tỷ lệ hủy (%). Đổi một chỗ này nếu chính sách của sân thay đổi.
    const double NguongHuy = 20;
    const double NguongHuyChuY = 10;
    // Ngưỡng coi là "doanh thu phụ thuộc vào ít khách" (% doanh thu thuộc nhóm Top)
    const double NguongTapTrungDoanhThu = 80;

    static string Tien(decimal v) => v.ToString("N0", Vn) + " đ";

    // Số tiền gọn cho thẻ KPI: 3.700.000 -> "3,7 triệu"
    static string TienGon(decimal v) => v >= 1000000m
        ? (v / 1000000m).ToString("0.##", Vn) + " triệu"
        : Tien(v);

    // Che một phần số điện thoại: 0987654005 -> 0987***005
    static string MaSdt(string s) => string.IsNullOrEmpty(s) || s.Length < 8
        ? (s ?? "")
        : s.Substring(0, 4) + "***" + s.Substring(s.Length - 3);

    // Chiều rộng/độ cao % cho CSS: luôn dùng dấu chấm, kẹp trong 0..100
    static string W(double v) => Math.Max(0, Math.Min(100, v)).ToString("0.##", CultureInfo.InvariantCulture);

    static string Pct(double v) => v.ToString("0.#", Vn) + "%";

    static string HangCss(string ten) => ten switch
    {
        "Bạc" => "bac",
        "Vàng" => "vang",
        "Kim cương" => "kc",
        _ => "tv"
    };

    // Mức cảnh báo cho tỷ lệ hủy
    static string MucHuy(double tyLe) => tyLe >= NguongHuy ? "bad" : (tyLe >= NguongHuyChuY ? "warn" : "good");

    // Cột "T11" của biểu đồ theo tháng: có phải tháng chưa diễn ra trong năm hiện tại không
    static bool LaTuongLai(string ten, string donVi, DateTime homNay, bool cungNamHienTai)
    {
        if (!cungNamHienTai || string.IsNullOrEmpty(ten) || string.IsNullOrEmpty(donVi)) return false;
        if (donVi.IndexOf("tháng", StringComparison.OrdinalIgnoreCase) < 0) return false;
        if (!ten.StartsWith("T")) return false;
        return int.TryParse(ten.Substring(1), out int thang) && thang > homNay.Month;
    }

    // So sánh với kỳ trước. upGood = true nếu tăng là tốt (hủy đơn thì ngược lại).
    // Chưa có dữ liệu kỳ trước thì trả về chuỗi rỗng: không hiện số so sánh giả.
    static (string Css, string Text) Delta(double cur, double prev, bool coKyTruoc, bool upGood, bool tyLe)
    {
        if (!coKyTruoc) return ("none", "");
        double diff = Math.Round(cur - prev, 1);
        string truoc = tyLe ? Pct(prev) : prev.ToString("0", Vn);
        if (diff == 0) return ("flat", "Không đổi so với kỳ trước (" + truoc + ")");
        string mui = diff > 0 ? "▲" : "▼";
        string so = tyLe ? Math.Abs(diff).ToString("0.#", Vn) + " điểm %" : Math.Abs(diff).ToString("0", Vn);
        string css = (diff > 0) == upGood ? "good" : "bad";
        return (css, mui + " " + so + " so với kỳ trước (" + truoc + ")");
    }
}

<style>
    .kh-wrap { --kh-ink:#172B4D; --kh-head:#1E293B; --kh-text:#334155; --kh-sub:#475569; --kh-line:#D7DEE8; --kh-bg:#F8FAFC;
