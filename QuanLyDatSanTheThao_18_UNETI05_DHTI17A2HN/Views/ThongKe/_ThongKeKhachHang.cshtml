    .kh-kpi.click { cursor:pointer; transition:box-shadow .15s, transform .15s; }
    .kh-kpi.click:hover, .kh-kpi.click:focus-visible { box-shadow:0 4px 14px rgba(23,43,77,.12); transform:translateY(-1px); outline:none; }
    .kh-kpi.click:focus-visible { outline:2px solid var(--kh-accent); outline-offset:2px; }
    .kh-kpi.good { border-top-color:var(--kh-good); } .kh-kpi.warn { border-top-color:var(--kh-warn); } .kh-kpi.bad { border-top-color:var(--kh-bad); }
    .kh-kpi.info { border-top-color:var(--kh-accent); }
    .kh-kpi .lb { font-size:14px; font-weight:500; color:var(--kh-sub); display:flex; align-items:center; gap:6px; }
    .kh-kpi .vl { font-size:28px; font-weight:700; margin-top:0; line-height:1.15; color:var(--kh-ink); }
    .kh-kpi.good .vl { color:var(--kh-good); } .kh-kpi.warn .vl { color:var(--kh-warn); } .kh-kpi.bad .vl { color:var(--kh-bad); }
    .kh-kpi .sb { font-size:14px; color:var(--kh-sub); margin-top:2px; }
    .kh-delta { font-size:13.5px; font-weight:600; margin-top:2px; }
    .kh-delta.good { color:var(--kh-good); } .kh-delta.bad { color:var(--kh-bad); }
    .kh-delta.flat { color:var(--kh-sub); font-weight:500; }
    .kh-status { font-size:13.5px; font-weight:500; margin-top:2px; color:var(--kh-sub); }
    .kh-status.good { color:var(--kh-good); } .kh-status.warn { color:var(--kh-warn); } .kh-status.bad { color:var(--kh-bad); }
    .kh-info { display:inline-flex; width:16px; height:16px; border-radius:50%; border:1px solid var(--kh-sub); color:var(--kh-sub);
               font-size:11px; font-weight:700; align-items:center; justify-content:center; cursor:help; flex:none; line-height:1; }

    /* Điều admin cần chú ý */
    .kh-insights { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:16px; }
    .kh-ins { display:block; text-align:left; background:#fff; border:1px solid var(--kh-line); border-left:4px solid var(--kh-accent); border-radius:12px;
