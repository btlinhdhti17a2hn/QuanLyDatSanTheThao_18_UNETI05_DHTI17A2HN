    .kh-tag.tv { background:#EEF2F7; color:#334155; } .kh-tag.bac { background:#dfe6ef; color:#334155; }
    .kh-tag.vang { background:#fde68a; color:#78350f; } .kh-tag.kc { background:#dbeafe; color:#1e40af; }
    .kh-tag.bad { background:#fee2e2; color:#991b1b; } .kh-tag.warn { background:#fef3c7; color:#78350f; } .kh-tag.good { background:#d1fae5; color:#065f46; }
    .kh-tag.info { background:#dbeafe; color:#1e40af; } .kh-tag.gray { background:#EEF2F7; color:#475569; }

