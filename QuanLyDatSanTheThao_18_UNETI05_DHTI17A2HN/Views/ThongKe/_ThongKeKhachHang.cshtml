    .kh-table-wrap { overflow-x:auto; }
    .kh-dim { font-size:13px; color:var(--kh-sub); }
    .kh-pane:not(.kh-expanded) .kh-more { display:none; }

    .kh-rank { display:inline-flex; width:26px; height:26px; border-radius:50%; align-items:center; justify-content:center;
