    .kh-block { margin-top:16px; }

    .kh-seg { display:inline-flex; background:var(--kh-bg); border:1px solid var(--kh-line); border-radius:8px; padding:2px; }
    .kh-seg button { border:0; background:transparent; padding:6px 14px; font-size:14px; border-radius:6px; cursor:pointer; color:var(--kh-sub); font-weight:500; }
    .kh-seg button.on { background:#fff; color:var(--kh-accent); font-weight:600; box-shadow:0 1px 2px rgba(0,0,0,.1); }
    .kh-seg.sm button { padding:4px 12px; }
    .kh-linkbtn { border:1px solid var(--kh-line); background:#fff; color:var(--kh-accent); font-size:14px; font-weight:600;
                  padding:6px 14px; border-radius:8px; cursor:pointer; margin-top:12px; }
    .kh-linkbtn:hover { background:var(--kh-bg); }

    .kh-table { width:100%; border-collapse:collapse; font-size:14px; color:var(--kh-text); }
    .kh-table th { text-align:left; font-size:13px; color:var(--kh-text); font-weight:600; padding:8px; border-bottom:1px solid var(--kh-line); vertical-align:bottom; }
    .kh-table td { padding:10px 8px; border-bottom:1px solid var(--kh-line); vertical-align:middle; }
    .kh-table tr:last-child td { border-bottom:0; }
    .kh-table tbody tr:hover td { background:#F8FAFC; }
    .kh-table tfoot td { border-top:2px solid var(--kh-line); border-bottom:0; font-weight:600; color:var(--kh-ink); }
    .kh-table .num { text-align:right; white-space:nowrap; }
    .kh-table .nm { font-weight:600; color:var(--kh-ink); }
