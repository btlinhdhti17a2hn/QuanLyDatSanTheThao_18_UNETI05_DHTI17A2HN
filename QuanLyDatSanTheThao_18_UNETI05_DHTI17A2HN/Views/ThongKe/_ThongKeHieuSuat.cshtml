@* Tab Hiệu suất sân (nhúng từ ThongKe.cshtml)
   Trả lời 3 câu hỏi: đang khai thác tốt đến đâu? công suất bị bỏ trống ở đâu? cần làm gì?
   Số liệu lấy từ Model.HieuSuat (ThongKeController.TinhHieuSuatSanAsync):
   tính theo NGÀY SỬ DỤNG sân, không tính đơn hủy, chỉ tính sân khả dụng và giờ đã diễn ra. *@
@using System.Globalization
@using QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.ViewModels
@model ThongKeViewModel
@{
    var hs = Model.HieuSuat;
    var vi = new CultureInfo("vi-VN");
    var inv = CultureInfo.InvariantCulture;
    var homNay = DateTime.UtcNow.AddHours(7).Date;
    bool coSan = hs.SoSanKhaDung > 0;
    bool coDat = hs.GioDaDat > 0;
    int nGio = hs.GioDong - hs.GioMo;

    string P(double v) => (v > 0 && v < 1 ? v.ToString("0.##", vi) : v.ToString("0.#", vi)) + "%";
    string G(double v) => v.ToString("#,##0.#", vi);
    string Num(double v) => v.ToString("0.##", inv);
    string Mau(double r) => r >= 60 ? "good" : (r >= 40 ? "fair" : (r >= 20 ? "mid" : "low"));
    string Nhan(double r) => r >= 60 ? "Tốt" : (r >= 40 ? "Khá" : (r >= 20 ? "Trung bình" : "Thấp"));
    double Rong(double r) => r > 0 ? Math.Max(r, 1.5) : 0;   // thanh luôn thấy được khi có giờ đặt
    string Khung(int g) => g.ToString("00") + ":00–" + (g + 1).ToString("00") + ":00";

    // ----- So sánh kỳ trước -----
    double? delta = hs.CoKyTruoc ? Math.Round(hs.TyLeKhaiThac - hs.TyLeKyTruoc, 1) : (double?)null;
    string deltaCss = "flat", deltaTxt = "Chưa có dữ liệu kỳ trước để so sánh";
    if (delta != null)
    {
        string soDelta = Math.Abs(delta.Value).ToString("0.#", vi);
        if (delta >= 0.5) { deltaCss = "good"; deltaTxt = "▲ +" + soDelta + " điểm % so với kỳ trước"; }
        else if (delta <= -0.5) { deltaCss = "bad"; deltaTxt = "▼ −" + soDelta + " điểm % so với kỳ trước"; }
        else { deltaCss = "flat"; deltaTxt = "● Gần như không đổi so với kỳ trước"; }
    }

    // ----- Bản đồ nhiệt: mức màu -----
    // Thang màu TƯƠNG ĐỐI theo ô cao nhất của kỳ: khi tỷ lệ chung rất thấp (vài %) các ô có booking vẫn
    // phân biệt rõ nhau. 0% giữ nền xám nhạt. Ô cao nhất luôn là mức đậm nhất.
    double maxTyLeO = hs.Heatmap.SelectMany(x => x.O).Where(o => o.TyLe != null).Select(o => o.TyLe!.Value).DefaultIfEmpty(0).Max();
    int LvTyLe(double? r)
    {
        if (r == null) return -1;
        if (r.Value <= 0 || maxTyLeO <= 0) return 0;
        return Math.Clamp((int)Math.Ceiling(r.Value / maxTyLeO * 5.0), 1, 5);
    }
    string TyLeO(double? r) => r == null ? "–" : (r.Value <= 0 ? "" : (r.Value < 10 ? r.Value.ToString("0.#", vi) : Math.Round(r.Value).ToString("0", vi)) + "%");
    int maxLuot = hs.Heatmap.SelectMany(x => x.O).Select(o => o.Luot).DefaultIfEmpty(0).Max();
    int LvLuot(HeatOItem o)
    {
        if (o.Luot <= 0) return o.TyLe == null ? -1 : 0;
        return maxLuot == 0 ? 0 : Math.Min(5, (int)Math.Ceiling(o.Luot * 5.0 / maxLuot));
    }

    // ----- Tổng hợp theo giờ (cộng qua 7 thứ) để tìm giờ cao điểm / giờ vắng -----
    var theoGio = Enumerable.Range(0, nGio).Select(g => new
    {
        Gio = hs.GioMo + g,
        Cap = hs.Heatmap.Sum(h => h.O[g].GioKhaDung),
        Dat = hs.Heatmap.Sum(h => h.O[g].GioDat),
        Luot = hs.Heatmap.Sum(h => h.O[g].Luot)
    }).ToList();
    var gioCaoDiem = theoGio.Where(x => x.Luot > 0).OrderByDescending(x => x.Luot).ThenBy(x => x.Gio).FirstOrDefault();
    var gioVang = theoGio.Where(x => x.Cap > 0).OrderBy(x => x.Dat / x.Cap).ThenBy(x => x.Gio).FirstOrDefault();

    // ----- Khung giờ: mỗi khung có mục tiêu riêng (ngưỡng khởi đầu, nên chỉnh theo thực tế kinh doanh) -----
    var khungDinhNghia = new List<(string Ten, int Tu, int Den, double Muc)>
    {
        ("Sáng sớm", 6, 9, 20), ("Ban ngày", 9, 16, 30), ("Giờ cao điểm", 16, 20, 60), ("Buổi tối", 20, 22, 30)
    };
    var khungRows = khungDinhNghia.Select(kd =>
    {
        int tuG = Math.Max(kd.Tu, hs.GioMo), denG = Math.Min(kd.Den, hs.GioDong);
        var gs = theoGio.Where(x => x.Gio >= tuG && x.Gio < denG).ToList();
        return new { kd.Ten, Tu = tuG, Den = denG, kd.Muc, Cap = gs.Sum(x => x.Cap), Dat = gs.Sum(x => x.Dat), Luot = gs.Sum(x => x.Luot) };
    }).Where(k => k.Den > k.Tu).ToList();

    // Ô nhu cầu cao nhất (thứ + giờ)
    var oCao = new List<(string Thu, int Gio, HeatOItem O)>();
    foreach (var hang in hs.Heatmap)
        for (int g = 0; g < nGio; g++)
            if (hang.O[g].TyLe != null && hang.O[g].GioDat > 0)
                oCao.Add((hang.Ten, hs.GioMo + g, hang.O[g]));
    oCao = oCao.OrderByDescending(x => x.O.TyLe).ThenByDescending(x => x.O.GioDat).ToList();

    // ----- Từng sân -----
    // Xếp hạng kiểu "đồng hạng": thứ tự theo tỷ lệ giảm dần, rồi giờ đặt giảm dần, rồi tên sân.
    // Chỉ đồng hạng khi cả tỷ lệ lẫn giờ đặt bằng nhau (1, 1, 1, 4...).
    var rankMap = new Dictionary<int, int>();
    var dongHangIds = new HashSet<int>();
    for (int i = 0; i < hs.San.Count; i++)
    {
        bool bangTruoc = i > 0 && hs.San[i].TyLe == hs.San[i - 1].TyLe && hs.San[i].GioDat == hs.San[i - 1].GioDat;
        rankMap[hs.San[i].MaSan] = bangTruoc ? rankMap[hs.San[i - 1].MaSan] : i + 1;
        if (bangTruoc) { dongHangIds.Add(hs.San[i].MaSan); dongHangIds.Add(hs.San[i - 1].MaSan); }
    }
    const int TRANG_SAN = 10;
    var topList = hs.San.Take(5).ToList();
    var lowList = hs.San.OrderBy(s => s.TyLe).ThenBy(s => s.GioDat).ThenBy(s => s.Ten).Take(5).ToList();
    var khoiSan = new List<(string Key, List<HieuSuatSanItem> Ds)> { ("top", topList), ("low", lowList), ("all", hs.San) };

    // Sân dưới một nửa mức trung bình: dùng cho nhận định + lọc nhanh
    double tb = hs.TyLeKhaiThac;
    var sanYeu = hs.San.Where(s => tb > 0 && s.TyLe < tb * 0.5).ToList();
    var yeuIds = sanYeu.Select(s => s.MaSan).ToHashSet();
    int sanChuaCoLuot = hs.San.Count(s => s.Luot == 0);

    // ----- Điểm cần chú ý: tính động từ dữ liệu, chỉ hiện khi đủ dữ liệu -----
    var ins = new List<(string Css, string Chip, string Tieu, string Nd, bool Loc)>();
    if (coDat)
    {
        if (delta != null)
        {
            string tt = P(hs.TyLeKyTruoc) + " → " + P(hs.TyLeKhaiThac);
            if (delta >= 0.5) ins.Add(("good", "Tích cực", "Xu hướng", "Tỷ lệ khai thác tăng " + Math.Abs(delta.Value).ToString("0.#", vi) + " điểm % so với kỳ trước (" + tt + ").", false));
            else if (delta <= -0.5) ins.Add(("bad", "Cần xử lý", "Xu hướng", "Tỷ lệ khai thác giảm " + Math.Abs(delta.Value).ToString("0.#", vi) + " điểm % so với kỳ trước (" + tt + "). Nên kiểm tra khung giờ và loại sân bị giảm.", false));
            else ins.Add(("flat", "Ổn định", "Xu hướng", "Tỷ lệ khai thác gần như không đổi so với kỳ trước (" + tt + ").", false));
        }
        else
        {
            ins.Add(("flat", "Lưu ý", "Xu hướng", "Kỳ trước chưa có giờ đặt nên chưa so sánh được.", false));
        }

        if (oCao.Count > 0)
        {
            var c0 = oCao[0];
            bool ganKin = c0.O.TyLe >= 80;
            ins.Add((ganKin ? "warn" : "good", ganKin ? "Gần kín" : "Nhu cầu cao", "Nhu cầu cao",
                c0.Thu + " " + Khung(c0.Gio) + " đạt " + P(c0.O.TyLe!.Value) + " (" + G(c0.O.GioDat) + "/" + G(c0.O.GioKhaDung) + " giờ)."
                + (ganKin ? " Gần hết chỗ, cần theo dõi khả năng đáp ứng." : " Là ô khai thác cao nhất trong kỳ."), false));
        }

        if (sanYeu.Count > 0)
        {
            string ten = string.Join(", ", sanYeu.Take(3).Select(s => s.Ten)) + (sanYeu.Count > 3 ? "…" : "");
            ins.Add(("warn", "Cần cải thiện", "Sân khai thác thấp",
                sanYeu.Count + " sân thấp hơn một nửa mức trung bình (" + P(tb) + "): " + ten + ". Nên kiểm tra lịch hoạt động, bảo trì và nhu cầu trước khi kết luận.", true));
        }
        else if (sanChuaCoLuot > 0)
        {
            ins.Add(("warn", "Cần cải thiện", "Sân chưa có lượt đặt", sanChuaCoLuot + " sân chưa có lượt đặt nào trong kỳ.", false));
        }

        if (gioVang != null && gioVang.Dat / gioVang.Cap * 100 < tb
            && (gioCaoDiem == null || gioVang.Gio != gioCaoDiem.Gio))
        {
            double tlv = gioVang.Dat / gioVang.Cap * 100;
            ins.Add(("flat", "Cơ hội", "Giờ vắng nhất",
                Khung(gioVang.Gio) + " chỉ đạt " + P(Math.Round(tlv, 1)) + ", còn khoảng " + G(gioVang.Cap - gioVang.Dat) + " giờ trống. Có thể cân nhắc ưu đãi giờ thấp điểm.", false));
        }

        if (hs.Loai.Count >= 2 && hs.Loai.Last().TyLe < tb)
        {
            var yeuNhat = hs.Loai.Last();
            ins.Add(("warn", "Cần cải thiện", "Loại sân thấp nhất", yeuNhat.Ten + " chỉ đạt " + P(yeuNhat.TyLe) + " (" + G(yeuNhat.GioDat) + "/" + G(yeuNhat.GioKhaDung) + " giờ), thấp nhất trong các loại sân.", false));
        }
    }

    // ----- Biểu đồ xu hướng (SVG vẽ phía máy chủ) -----
    int nC = hs.XuHuong.Count;
    bool veDuoc = coDat && nC >= 2;
    const double W = 640, H = 250, pL = 46, pR = 16, pT = 16, pB = 36;
    double maxV = hs.XuHuong.SelectMany(x => new double?[] { x.TyLe, x.TyLeTruoc }).Where(v => v.HasValue).Select(v => v!.Value).DefaultIfEmpty(0).Max();
    maxV = Math.Max(maxV, hs.TyLeKhaiThac);
    // Trục Y tự co theo dữ liệu (1, 2, 5, 10, 20, 50, 100%) để đường không bị dẹt sát đáy khi tỷ lệ chỉ vài phần trăm
    double topY = 100;
    foreach (var bac in new double[] { 1, 2, 5, 10, 20, 50, 100 })
    {
        if (maxV * 1.15 <= bac) { topY = bac; break; }
    }
    bool kyTruocCoSo = hs.XuHuong.Any(x => x.TyLeTruoc != null && x.TyLeTruoc > 0);
    int soCotCoDat = hs.XuHuong.Count(x => x.GioDat > 0);
    string NhanTruc(double v) => v.ToString(topY < 5 ? "0.##" : "0.#", vi) + "%";
    double X(int i) => pL + i * (W - pL - pR) / Math.Max(1, nC - 1);
    double Y(double v) => pT + (H - pT - pB) * (1 - v / topY);
    string DuongVe(Func<HieuSuatCotItem, double?> chon)
    {
        var sb = new System.Text.StringBuilder();
        bool dau = true;
        for (int i = 0; i < nC; i++)
        {
            var v = chon(hs.XuHuong[i]);
            if (v == null) { dau = true; continue; }
            sb.Append(dau ? "M" : "L").Append(X(i).ToString("0.#", inv)).Append(' ').Append(Y(v.Value).ToString("0.#", inv)).Append(' ');
            dau = false;
        }
        return sb.ToString();
    }
    bool coTruoc = kyTruocCoSo;   // kỳ trước toàn 0% thì không vẽ đường kỳ trước (tránh hai đường đè nhau gây khó hiểu)
    int buocNhan = nC > 12 ? (int)Math.Ceiling(nC / 10.0) : 1;
    string donViTxt = Model.DonViBieuDo;
}

@* CSS riêng của tab (tiền tố hs-) để tab không phụ thuộc kiểu của partial khác. Màu chữ đã chọn đạt tương phản WCAG AA. *@
<style>
    .hs-bar-info { display: flex; flex-wrap: wrap; gap: .25rem .9rem; align-items: baseline; margin: 0 0 .75rem; font-size: .875rem; color: #475569; }
    .hs-bar-info b { color: #1F2937; }

    .hs-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin-bottom: .75rem; }
    .hs-kpi { background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; padding: .85rem 1rem; display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
    .hs-kpi.main { border-color: #86EFAC; background: #F0FDF4; }
    .hs-kpi .l { font-size: .75rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #475569; }
    .hs-kpi .v { font-size: 1.875rem; line-height: 1.15; font-weight: 800; color: #1F2937; font-variant-numeric: tabular-nums; }
    .hs-kpi .v small { font-size: .9375rem; font-weight: 600; color: #475569; margin-left: .25rem; }
    .hs-kpi .d { font-size: .8125rem; font-weight: 700; }
    .hs-kpi .d.good { color: #166534; }
    .hs-kpi .d.bad { color: #B91C1C; }
    .hs-kpi .d.flat { color: #475569; font-weight: 600; }
    .hs-kpi .s { font-size: .8125rem; color: #475569; }

    .hs-sub { font-size: .8125rem; color: #475569; margin: .5rem 0 0; }
    .hs-legend { display: flex; flex-wrap: wrap; gap: .3rem 1rem; margin-top: .5rem; font-size: .8125rem; color: #475569; }
    .hs-legend span { display: inline-flex; align-items: center; gap: .35rem; }
    .hs-legend i { display: inline-block; width: 22px; height: 0; border-top: 3px solid #15803D; }
    .hs-legend i.prev { border-top: 2px dashed #64748B; }
    .hs-legend i.avg { border-top: 2px dashed #D97706; }

    .hs-svg { width: 100%; height: auto; display: block; }
    .hs-svg text { font-size: 13px; fill: #475569; font-family: inherit; }
    .hs-svg .grid { stroke: #E2E8F0; stroke-width: 1; }
    .hs-svg .cur { fill: none; stroke: #15803D; stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; }
    .hs-svg .prev { fill: none; stroke: #64748B; stroke-width: 2; stroke-dasharray: 5 4; stroke-linejoin: round; }
    .hs-svg .avg { stroke: #D97706; stroke-width: 2; stroke-dasharray: 6 4; }
    .hs-svg .avglab { fill: #92400E; font-weight: 700; }
    .hs-svg circle { fill: #fff; stroke: #15803D; stroke-width: 2.5; }

    .hs-heat-wrap { overflow-x: auto; padding-bottom: .25rem; }
    .hs-heat { display: grid; grid-template-columns: 4.2rem repeat(var(--n), minmax(36px, 1fr)); gap: 3px; min-width: calc(4.2rem + var(--n) * 39px); }
    .hs-heat .corner, .hs-heat .hlab, .hs-heat .rlab { font-size: .8125rem; color: #475569; display: flex; align-items: center; }
    .hs-heat .hlab { justify-content: center; padding-bottom: 2px; font-weight: 600; }
    .hs-heat .rlab { font-weight: 600; color: #1F2937; }
    .hs-cell { height: 38px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: .75rem; font-weight: 700; font-variant-numeric: tabular-nums; cursor: default; outline: none; }
    .hs-cell:hover, .hs-cell:focus-visible { box-shadow: 0 0 0 2px #1F2937 inset; }
    .hs-cell .hv-l { display: none; }
    .hs-heat.mode-l .hs-cell .hv-r { display: none; }
    .hs-heat.mode-l .hs-cell .hv-l { display: inline; }
    .hs-heat:not(.mode-l) .hs-cell[data-lr="-1"], .hs-heat.mode-l .hs-cell[data-ll="-1"] { background: #E5E7EB; color: #475569; }
    .hs-heat:not(.mode-l) .hs-cell[data-lr="0"], .hs-heat.mode-l .hs-cell[data-ll="0"] { background: #F1F5F9; color: #475569; }
    .hs-heat:not(.mode-l) .hs-cell[data-lr="1"], .hs-heat.mode-l .hs-cell[data-ll="1"] { background: #BBF7D0; color: #14532D; }
    .hs-heat:not(.mode-l) .hs-cell[data-lr="2"], .hs-heat.mode-l .hs-cell[data-ll="2"] { background: #86EFAC; color: #14532D; }
    .hs-heat:not(.mode-l) .hs-cell[data-lr="3"], .hs-heat.mode-l .hs-cell[data-ll="3"] { background: #4ADE80; color: #14532D; }
    .hs-heat:not(.mode-l) .hs-cell[data-lr="4"], .hs-heat.mode-l .hs-cell[data-ll="4"] { background: #15803D; color: #fff; }
    .hs-heat:not(.mode-l) .hs-cell[data-lr="5"], .hs-heat.mode-l .hs-cell[data-ll="5"] { background: #14532D; color: #fff; }
    .hs-scale { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .5rem; margin-top: .6rem; font-size: .8125rem; color: #475569; }
    .hs-scale i { display: inline-block; width: 22px; height: 14px; border-radius: 3px; border: 1px solid #CBD5E1; }

    .hs-type { padding: .6rem 0; border-top: 1px solid #E2E8F0; }
    .hs-type:first-of-type { border-top: 0; }
    .hs-type .top { display: flex; justify-content: space-between; align-items: baseline; gap: .75rem; }
    .hs-type .nm { font-size: .9375rem; font-weight: 700; color: #1F2937; }
    .hs-type .rt { font-size: 1.125rem; font-weight: 800; color: #1F2937; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .hs-type .meta { font-size: .875rem; color: #334155; margin-top: .3rem; }
    .hs-type .meta b { color: #1F2937; }

    .hs-track { height: 9px; border-radius: 99px; background: #E2E8F0; overflow: hidden; margin-top: .4rem; }
    .hs-track > span { display: block; height: 100%; border-radius: 99px; }
    .hs-track .good, .hs-fill.good { background: #15803D; }
    .hs-track .mid, .hs-fill.mid { background: #D97706; }
    .hs-track .low, .hs-fill.low { background: #DC2626; }
    .hs-track .fair { background: #4D7C0F; }

    .hs-chip { display: inline-block; padding: .05rem .5rem; border-radius: 99px; font-size: .75rem; font-weight: 700; white-space: nowrap; }
    .hs-chip.good { background: #DCFCE7; color: #166534; }
    .hs-chip.mid, .hs-chip.warn { background: #FEF3C7; color: #92400E; }
    .hs-chip.low, .hs-chip.bad { background: #FEE2E2; color: #991B1B; }
    .hs-chip.flat { background: #E2E8F0; color: #334155; }
    .hs-chip.fair { background: #ECFCCB; color: #3F6212; }

    .hs-moc { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; margin-bottom: .75rem; }
    .hs-mo { background: #fff; border: 1px solid #E2E8F0; border-radius: 12px; padding: .7rem 1rem; display: flex; flex-direction: column; gap: .15rem; min-width: 0; }
    .hs-mo .l { font-size: .8125rem; font-weight: 700; color: #475569; }
    .hs-mo .v { display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; font-size: 1.5rem; font-weight: 800; color: #1F2937; font-variant-numeric: tabular-nums; }
    .hs-mo .s { font-size: .8125rem; color: #475569; }
    .hs-mo .s b { color: #1F2937; }

    .hs-band { padding: .6rem 0; border-top: 1px solid #E2E8F0; }
    .hs-band:first-of-type { border-top: 0; }
    .hs-band .top { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; }
    .hs-band .nm { font-weight: 700; color: #1F2937; font-size: .9375rem; }
    .hs-band .nm small { font-weight: 600; color: #475569; font-size: .8125rem; margin-left: .35rem; }
    .hs-band .rt { font-weight: 800; color: #1F2937; font-variant-numeric: tabular-nums; }
    .hs-band .meta { font-size: .8125rem; color: #475569; margin-top: .2rem; }
    .hs-band .meta b { color: #1F2937; }
    .hs-band .hint { font-size: .8125rem; color: #334155; margin-top: .2rem; }

    .hs-ins { list-style: none; margin: .75rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .6rem; }
    .hs-ins li { background: #fff; border: 1px solid #E2E8F0; border-left-width: 4px; border-radius: 10px; padding: .6rem .8rem; }
    .hs-ins li.good { border-left-color: #15803D; }
    .hs-ins li.warn { border-left-color: #D97706; }
    .hs-ins li.bad { border-left-color: #DC2626; }
    .hs-ins li.flat { border-left-color: #64748B; }
    .hs-ins .t { display: flex; justify-content: space-between; align-items: center; gap: .5rem; font-weight: 700; color: #1F2937; font-size: .9375rem; }
    .hs-ins .n { margin: .25rem 0 0; font-size: .875rem; line-height: 1.45; color: #334155; }
    .hs-link { margin-top: .4rem; padding: .2rem .6rem; border: 1px solid #15803D; border-radius: 8px; background: #fff; color: #166534; font-weight: 700; font-size: .8125rem; cursor: pointer; }
    .hs-link:hover { background: #F0FDF4; }

    .hs-row { display: grid; grid-template-columns: 2.2rem minmax(0, 1fr) minmax(70px, 28%) 3.4rem 4.4rem; align-items: center; gap: .6rem; padding: .5rem .25rem; border-top: 1px solid #E2E8F0; font-size: .9375rem; }
    .hs-row:first-child { border-top: 0; }
    .hs-row .rk { font-weight: 700; color: #475569; font-size: .875rem; }
    .hs-row .nm { color: #1F2937; line-height: 1.3; }
    .hs-row .pc { text-align: right; font-weight: 800; color: #1F2937; font-variant-numeric: tabular-nums; }
    .hs-row .gh { text-align: right; font-size: .8125rem; color: #475569; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .hs-row .hs-track { margin: 0; }
    .hs-list.filter-yeu .hs-row:not([data-yeu="1"]) { display: none; }
    .hs-filter { display: flex; justify-content: space-between; align-items: center; gap: .5rem; margin: .5rem 0 0; padding: .4rem .7rem; background: #FEF3C7; border-radius: 8px; font-size: .8125rem; color: #92400E; font-weight: 600; }
    .hs-filter[hidden], .hs-list[hidden] { display: none; }
    .hs-filter button { border: 0; background: transparent; color: #92400E; font-weight: 700; text-decoration: underline; cursor: pointer; font-size: .8125rem; }
    .hs-th { display: grid; grid-template-columns: 2.2rem minmax(0, 1fr) minmax(70px, 28%) 3.4rem 4.4rem; gap: .6rem; padding: .25rem .25rem .4rem; font-size: .75rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #475569; border-bottom: 1px solid #E2E8F0; margin-top: .5rem; }
    .hs-th span:nth-child(n+4) { text-align: right; }

    .hs-notice { margin: .6rem 0 0; padding: .5rem .75rem; background: #F1F5F9; border-radius: 8px; font-size: .8125rem; color: #334155; }
    .hs-empty-chart { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .25rem; min-height: 220px; text-align: center; color: #475569; border: 1px dashed #CBD5E1; border-radius: 10px; padding: 1rem; }
    .hs-empty-chart b { color: #1F2937; font-size: .9375rem; }
    .hs-empty-chart span { font-size: .8125rem; }

    .hs-tip { position: fixed; z-index: 1080; pointer-events: none; background: #1F2937; color: #fff; border-radius: 8px; padding: .5rem .7rem; font-size: .8125rem; line-height: 1.5; box-shadow: 0 6px 18px rgba(15,23,42,.3); max-width: 240px; }
    .hs-tip[hidden] { display: none; }
    .hs-tip b { display: block; margin-bottom: .15rem; font-size: .875rem; }
    .hs-tip div { display: flex; justify-content: space-between; gap: 1rem; }
    .hs-tip div span:last-child { font-weight: 700; font-variant-numeric: tabular-nums; }

    .hs-row .rk.tie { color: #92400E; }
    .hs-tie-tag { display: inline-block; margin-left: .35rem; padding: 0 .4rem; border-radius: 99px; background: #FEF3C7; color: #92400E; font-size: .6875rem; font-weight: 700; vertical-align: 1px; }
    .hs-more { width: 100%; margin-top: .5rem; padding: .4rem; border: 1px dashed #CBD5E1; background: #fff; border-radius: 10px; color: #166534; font-weight: 600; font-size: .875rem; cursor: pointer; }
    .hs-more:hover { background: #F0FDF4; }
    .hs-more[hidden] { display: none; }
    .hs-row[data-pg-hide="1"] { display: none; }
    .hs-list.filter-yeu .hs-row[data-pg-hide="1"][data-yeu="1"] { display: grid; }

    @@media (max-width: 992px) { .hs-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 576px) {
        .hs-row, .hs-th { grid-template-columns: 2rem minmax(0, 1fr) 3.2rem 4rem; }
        .hs-row .hs-track, .hs-th span:nth-child(3) { display: none; }
        .hs-kpi .v { font-size: 1.5rem; }
        .hs-moc { grid-template-columns: minmax(0, 1fr); }
    }
</style>

<section class="tk-pane" data-pane="hieu-suat" role="tabpanel" hidden>

    <div class="hs-bar-info">
        <span>Kỳ xem: <b>@Model.TuNgay.ToString("dd/MM/yyyy") – @Model.DenNgay.ToString("dd/MM/yyyy")</b>@(Model.DenNgay.Date >= homNay ? " (đến hôm nay)" : "")</span>
        <span>So sánh với: <b>@Model.TuNgayTruoc.ToString("dd/MM/yyyy") – @Model.DenNgayTruoc.ToString("dd/MM/yyyy")</b></span>
        <span>Giờ kinh doanh: <b>@hs.GioMo.ToString("00"):00–@hs.GioDong.ToString("00"):00</b> · <b>@hs.SoSanKhaDung</b> sân khả dụng</span>
    </div>

    @* ===== 01. KPI: tỷ lệ khai thác là chỉ số trung tâm ===== *@
    <div class="hs-kpis">
        <div class="hs-kpi main">
            <span class="l">Tỷ lệ khai thác</span>
            <span class="v">@(coSan ? P(hs.TyLeKhaiThac) : "–")</span>
            <span class="d @deltaCss">@deltaTxt</span>
            <span class="s">Giờ đã đặt / giờ có thể kinh doanh</span>
        </div>
        <div class="hs-kpi">
            <span class="l">Giờ sân đã đặt</span>
            <span class="v">@G(hs.GioDaDat)<small>giờ</small></span>
            <span class="s">Trên tổng @G(hs.GioKhaDung) giờ khả dụng</span>
        </div>
        <div class="hs-kpi">
            <span class="l">Giờ sân còn trống</span>
            <span class="v">@G(hs.GioTrong)<small>giờ</small></span>
            <span class="s">Công suất chưa được khai thác</span>
        </div>
        <div class="hs-kpi">
            <span class="l">Sân có phát sinh đặt</span>
            <span class="v">@hs.SoSanCoHoatDong / @hs.SoSanKhaDung<small>sân</small></span>
            <span class="s">Số sân có ít nhất một lượt đặt trong kỳ</span>
        </div>
    </div>

    @* ===== Ba mốc thời gian: tổng thể / tháng này / 7 ngày gần nhất ===== *@
    <div class="hs-moc">
        @foreach (var m in hs.Moc)
        {
            <div class="hs-mo">
                <span class="l">@m.Nhan</span>
                <span class="v">@(m.CoCongSuat ? P(m.TyLe) : "—")@if (m.CoCongSuat) { <span class="hs-chip @Mau(m.TyLe)">@Nhan(m.TyLe)</span> }</span>
                <span class="s"><b>@G(m.GioDat)</b>/@G(m.GioKhaDung) giờ · @m.Tu.ToString("dd/MM")–@m.Den.ToString("dd/MM")</span>
            </div>
        }
    </div>

    <div class="hs-sub" style="margin:-.25rem 0 .75rem">Công suất chỉ tính các giờ đã trôi qua đến thời điểm hiện tại (@DateTime.UtcNow.AddHours(7).ToString("HH:mm dd/MM")), không tính cả ngày hay cả tháng. Vì vậy "Tháng @homNay.Month" là từ đầu tháng đến nay.</div>

    <div class="tk-mstats">
        <div class="tk-mstat">
            <span class="l">Lượt đặt hợp lệ</span>
            <span class="v">@hs.SoLuotDat.ToString("N0", vi)<small>lượt</small></span>
        </div>
        <div class="tk-mstat">
            <span class="l">Lượt đặt TB / sân / ngày</span>
            <span class="v">@hs.LuotTbSanNgay.ToString("0.##", vi)<small>lượt</small></span>
        </div>
        <div class="tk-mstat">
            <span class="l">Khung giờ nhiều lượt nhất</span>
            <span class="v">@(gioCaoDiem != null ? Khung(gioCaoDiem.Gio).Replace("–", " - ") : "–")</span>
        </div>
    </div>

    <div class="tk-body eq">
        <div class="tk-stack">

            @* ===== 02. Xu hướng khai thác ===== *@
            <div class="tk-panel">
                <div class="tk-panel-title">Xu hướng khai thác sân</div>
                <div class="tk-panel-sub">Tỷ lệ khai thác theo @donViTxt · kỳ đang xem so với kỳ trước</div>

                @if (!coSan)
                {
                    <div class="tk-empty"><span>Chưa có sân khả dụng</span></div>
                }
                else if (!coDat)
                {
                    <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                }
                else if (!veDuoc)
                {
                    <div class="tk-empty"><span>Kỳ quá ngắn để vẽ xu hướng. Hãy chọn Tuần này, Tháng này, Quý này hoặc Năm.</span></div>
                }
                else if (soCotCoDat < 2)
                {
                    <div class="hs-empty-chart">
                        <b>Chưa đủ dữ liệu để hiển thị xu hướng</b>
                        <span>Mới có @soCotCoDat @donViTxt phát sinh giờ đặt trong kỳ này. Cần ít nhất 2 @donViTxt có dữ liệu để vẽ đường xu hướng.</span>
                        <span>Tỷ lệ khai thác hiện tại: <b>@P(hs.TyLeKhaiThac)</b> (@G(hs.GioDaDat)/@G(hs.GioKhaDung) giờ)</span>
                    </div>
                }
                else
                {
                    <svg class="hs-svg" viewBox="0 0 @(Num(W)) @(Num(H))" role="img"
                         aria-label="Biểu đồ đường tỷ lệ khai thác sân theo @donViTxt, trung bình @P(hs.TyLeKhaiThac)">
                        @for (int k = 0; k <= 4; k++)
                        {
                            double gv = topY / 4 * k;
                            <line class="grid" x1="@(Num(pL))" x2="@(Num(W - pR))" y1="@(Num(Y(gv)))" y2="@(Num(Y(gv)))"></line>
                            @:<text x="@(Num(pL - 8))" y="@(Num(Y(gv) + 4))" text-anchor="end">@(NhanTruc(gv))</text>
                        }
                        @if (coTruoc)
                        {
                            <path class="prev" d="@(DuongVe(x => x.TyLeTruoc))"></path>
                        }
                        <line class="avg" x1="@(Num(pL))" x2="@(Num(W - pR))" y1="@(Num(Y(hs.TyLeKhaiThac)))" y2="@(Num(Y(hs.TyLeKhaiThac)))"></line>
                        <text class="avglab" x="@(Num(W - pR))" y="@(Num(Y(hs.TyLeKhaiThac) - 6))" text-anchor="end">TB @P(hs.TyLeKhaiThac)</text>
                        <path class="cur" d="@(DuongVe(x => x.TyLe))"></path>
                        @for (int i = 0; i < nC; i++)
                        {
                            var it = hs.XuHuong[i];
                            if (it.TyLe != null && nC <= 16)
                            {
                                <circle cx="@(Num(X(i)))" cy="@(Num(Y(it.TyLe.Value)))" r="4">
                                    <title>@it.Ten: @P(it.TyLe.Value) (@G(it.GioDat)/@G(it.GioKhaDung) giờ)@(it.TyLeTruoc != null ? " · kỳ trước " + P(it.TyLeTruoc.Value) : "")</title>
                                </circle>
                            }
                            if (i % buocNhan == 0)
                            {
                                @:<text x="@(Num(X(i)))" y="@(Num(H - 12))" text-anchor="middle">@it.Ten</text>
                            }
                        }
                    </svg>
                    <div class="hs-legend">
                        <span><i></i> Kỳ đang xem</span>
                        @if (coTruoc)
                        {
                            <span><i class="prev"></i> Kỳ trước</span>
                        }
                        <span><i class="avg"></i> Trung bình kỳ</span>
                    </div>
                    @if (!coTruoc)
                    {
                        <div class="hs-sub">Kỳ trước chưa có giờ đặt nên không hiển thị đường kỳ trước.</div>
                    }
                    @if (Model.DenNgay.Date >= homNay)
                    {
                        <div class="hs-sub">Cột cuối là kỳ đang diễn ra, chỉ tính các giờ đã trôi qua.</div>
                    }
                }
            </div>

            @* ===== 03. Nhu cầu theo thứ và giờ ===== *@
            <div class="tk-panel">
                <div class="tk-head-row">
                    <div>
                        <div class="tk-panel-title">Nhu cầu theo ngày và khung giờ</div>
                        <div class="tk-panel-sub">Tìm giờ cao điểm và giờ sân còn trống · thang màu tương đối theo ô cao nhất</div>
                    </div>
                    @if (coSan)
                    {
                        <div class="tk-seg" role="group" aria-label="Chỉ số bản đồ nhiệt">
                            <button type="button" class="on" data-hs-heat="r" aria-pressed="true">Tỷ lệ khai thác</button>
                            <button type="button" data-hs-heat="l" aria-pressed="false">Lượt đặt</button>
                        </div>
                    }
                </div>

                @if (!coSan)
                {
                    <div class="tk-empty"><span>Chưa có sân khả dụng</span></div>
                }
                else if (!coDat)
                {
                    <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                }
                else
                {
                    <div class="hs-heat-wrap">
                        <div class="hs-heat" id="hs-heat" style="--n:@nGio">
                            <div class="corner"></div>
                            @for (int g = 0; g < nGio; g++)
                            {
                                <div class="hlab">@(hs.GioMo + g)h</div>
                            }
                            @foreach (var hang in hs.Heatmap)
                            {
                                <div class="rlab">@hang.Ten</div>
                                for (int g = 0; g < nGio; g++)
                                {
                                    var o = hang.O[g];
                                    int gioO = hs.GioMo + g;
                                    string tenThuDay = hang.Ten + ", " + Khung(gioO);
                                    <div class="hs-cell" tabindex="0" data-lr="@LvTyLe(o.TyLe)" data-ll="@LvLuot(o)"
                                         data-t="@tenThuDay" data-co="@(o.TyLe != null ? "1" : "0")"
                                         data-r="@(o.TyLe != null ? P(o.TyLe.Value) : "")" data-d="@G(o.GioDat)" data-k="@G(o.GioKhaDung)" data-l="@o.Luot"
                                         aria-label="@tenThuDay: @(o.TyLe != null ? P(o.TyLe.Value) + ", " + G(o.GioDat) + " trên " + G(o.GioKhaDung) + " giờ, " + o.Luot + " lượt đặt" : "chưa có công suất")">
                                        <span class="hv-r">@TyLeO(o.TyLe)</span>
                                        <span class="hv-l">@(o.Luot > 0 ? o.Luot.ToString() : (o.TyLe != null ? "0" : "–"))</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="hs-scale" id="hs-scale-r">
                        <span>Thấp</span>
                        <i style="background:#F1F5F9"></i><i style="background:#BBF7D0"></i><i style="background:#86EFAC"></i><i style="background:#4ADE80"></i><i style="background:#15803D"></i><i style="background:#14532D"></i>
                        <span>Cao (@P(maxTyLeO)) · ô trống: chưa có giờ đặt · ô "–": chưa diễn ra</span>
                    </div>
                    <div class="hs-sub">Màu đậm dần theo tỷ lệ so với ô cao nhất của kỳ (@P(maxTyLeO)), nên các ô có booking vẫn dễ phân biệt dù tỷ lệ chung thấp. Mỗi ô cộng dồn mọi ngày cùng thứ trong kỳ. Rê chuột hoặc chọn ô để xem giờ đã đặt, giờ khả dụng, tỷ lệ và số lượt đặt.</div>
                    <div class="hs-tip" id="hs-tip" role="tooltip" hidden></div>
                }
            </div>
        </div>

        <div class="tk-stack">

            @* ===== 04. Điểm cần chú ý ===== *@
            <div class="tk-panel tk-insight-card">
                <div class="tk-panel-title">Điểm cần chú ý</div>
                <div class="tk-panel-sub">Tự phát hiện từ số liệu của kỳ đang xem</div>
                @if (ins.Count == 0)
                {
                    <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                }
                else
                {
                    <ul class="hs-ins">
                        @foreach (var x in ins)
                        {
                            <li class="@x.Css">
                                <div class="t"><span>@x.Tieu</span><span class="hs-chip @x.Css">@x.Chip</span></div>
                                <p class="n">@x.Nd</p>
                                @if (x.Loc)
                                {
                                    <button type="button" class="hs-link" data-hs-go="yeu">Xem @sanYeu.Count sân này</button>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>

            @* ===== 04b. Giờ cao điểm / giờ thấp điểm ===== *@
            <div class="tk-panel">
                <div class="tk-panel-title">Giờ cao điểm và giờ thấp điểm</div>
                <div class="tk-panel-sub">Mỗi khung giờ có mục tiêu riêng · cộng dồn mọi sân trong kỳ</div>
                @if (!coDat)
                {
                    <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                }
                else
                {
                    foreach (var k in khungRows)
                    {
                        double tlk = k.Cap > 0 ? Math.Min(k.Dat / k.Cap * 100, 100) : 0;
                        bool cao = k.Muc >= 60;
                        string cssK, chipK, goiYK = "";
                        if (k.Cap <= 0) { cssK = "flat"; chipK = "Chưa có công suất"; }
                        else if (k.Dat <= 0) { cssK = "low"; chipK = "Chưa có khách"; }
                        else if (tlk >= k.Muc) { cssK = "good"; chipK = "Đạt mục tiêu"; }
                        else { cssK = "mid"; chipK = "Chưa đạt mục tiêu"; }
                        if (k.Cap > 0 && tlk >= 80 && cao) goiYK = "Gần kín, có thể cân nhắc điều chỉnh giá giờ cao điểm.";
                        else if (k.Cap > 0 && tlk < k.Muc) goiYK = cao ? "Giờ cao điểm chưa đạt mục tiêu, nên xem lại quảng bá hoặc giá." : "Còn nhiều giờ trống, có thể thử ưu đãi giờ thấp điểm.";
                        <div class="hs-band">
                            <div class="top">
                                <span class="nm">@k.Ten<small>@(k.Tu)h–@(k.Den)h</small></span>
                                <span class="rt">@(k.Cap > 0 ? P(Math.Round(tlk, 2)) : "—")</span>
                            </div>
                            <div class="hs-track"><span class="@(cssK == "flat" ? "mid" : cssK)" style="width:@(Num(Rong(tlk)))%"></span></div>
                            <div class="meta"><span class="hs-chip @cssK">@chipK</span> <b>@G(k.Dat)</b>/@G(k.Cap) giờ · <b>@k.Luot</b> lượt · mục tiêu @P(k.Muc)</div>
                            @if (goiYK != "")
                            {
                                <div class="hint">@goiYK</div>
                            }
                        </div>
                    }
                    <div class="hs-sub">Mục tiêu là ngưỡng khởi đầu để tham khảo, hãy chỉnh theo thực tế kinh doanh của cơ sở.</div>
                }
            </div>

            @* ===== 05. Hiệu suất theo loại sân ===== *@
            <div class="tk-panel">
                <div class="tk-panel-title">Hiệu suất theo loại sân</div>
                <div class="tk-panel-sub">Kỳ @Model.TuNgay.ToString("dd/MM")–@Model.DenNgay.ToString("dd/MM/yyyy") · sắp theo tỷ lệ khai thác giảm dần</div>
                @if (hs.Loai.Count == 0 || !coDat)
                {
                    <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                }
                else
                {
                    foreach (var lo in hs.Loai)
                    {
                        <div class="hs-type">
                            <div class="top">
                                <span class="nm">@lo.Ten <span class="hs-chip @Mau(lo.TyLe)">@Nhan(lo.TyLe)</span></span>
                                <span class="rt">@P(lo.TyLe)</span>
                            </div>
                            <div class="hs-track" role="img" aria-label="@lo.Ten khai thác @P(lo.TyLe)"><span class="@Mau(lo.TyLe)" style="width:@(Num(Rong(lo.TyLe)))%"></span></div>
                            <div class="meta"><b>@G(lo.GioDat) giờ đã đặt</b> · <b>@lo.Luot lượt</b> · <b>@G(lo.GioKhaDung) giờ khả dụng</b> (@lo.SoSan sân) · tỷ lệ <b>@P(lo.TyLe)</b></div>
                        </div>
                    }
                    <div class="hs-sub">Đánh giá: Tốt từ 60% · Khá 40–60% · Trung bình 20–40% · Thấp dưới 20%. Đây là ngưỡng tham khảo, nên chỉnh sau khi có dữ liệu đủ dài.</div>
                }
            </div>

            @* ===== 06. Hiệu suất từng sân ===== *@
            <div class="tk-panel">
                <div class="tk-head-row">
                    <div>
                        <div class="tk-panel-title">Hiệu suất từng sân</div>
                        <div class="tk-panel-sub">Xếp theo tỷ lệ khai thác, đồng điểm xếp theo giờ đã đặt</div>
                    </div>
                    <div class="tk-seg" role="group" aria-label="Chế độ xem sân">
                        <button type="button" class="on" data-hs-rk="top" aria-pressed="true">Cao nhất</button>
                        <button type="button" data-hs-rk="low" aria-pressed="false">Thấp nhất</button>
                        <button type="button" data-hs-rk="all" aria-pressed="false">Tất cả @hs.San.Count</button>
                    </div>
                </div>

                @if (hs.San.Count == 0 || !coDat)
                {
                    <div class="tk-empty"><span>Chưa có dữ liệu</span></div>
                }
                else
                {
                    <div class="hs-th"><span>#</span><span>Sân</span><span></span><span>Tỷ lệ</span><span>Giờ đặt</span></div>
                    <div class="hs-filter" id="hs-filter" hidden>
                        <span>Đang lọc @sanYeu.Count sân khai thác thấp</span>
                        <button type="button" id="hs-filter-off">Bỏ lọc</button>
                    </div>
                    @foreach (var khoi in khoiSan)
                    {
                        <div class="hs-list" id="hs-rk-@khoi.Key" hidden="@(khoi.Key != "top")">
                            @{ int stt = 0; }
                            @foreach (var s in khoi.Ds)
                            {
                                stt++;
                                bool dongH = dongHangIds.Contains(s.MaSan);
                                bool anTrang = khoi.Key == "all" && stt > TRANG_SAN;
                                <div class="hs-row" data-yeu="@(yeuIds.Contains(s.MaSan) ? "1" : "0")" data-pg-hide="@(anTrang ? "1" : "0")">
                                    <span class="rk@(dongH ? " tie" : "")">#@rankMap[s.MaSan]</span>
                                    <span class="nm">@s.Ten @if (dongH) { <span class="hs-tie-tag">đồng hạng</span> }</span>
                                    <div class="hs-track" role="img" aria-label="@s.Ten khai thác @P(s.TyLe)"><span class="@Mau(s.TyLe)" style="width:@(Num(Rong(s.TyLe)))%"></span></div>
                                    <span class="pc">@P(s.TyLe)</span>
                                    <span class="gh" title="@G(s.GioDat) giờ đã đặt trên @G(s.GioKhaDung) giờ khả dụng · @s.Luot lượt">@G(s.GioDat)/@G(s.GioKhaDung)h</span>
                                </div>
                            }
                            @if (khoi.Key == "all" && khoi.Ds.Count > TRANG_SAN)
                            {
                                <button type="button" class="hs-more" id="hs-more" data-step="@TRANG_SAN" data-total="@khoi.Ds.Count">Xem thêm (@(khoi.Ds.Count - TRANG_SAN) sân)</button>
                            }
                        </div>
                    }
                    <div class="hs-sub">Đồng hạng khi cả tỷ lệ và giờ đặt bằng nhau; sân đồng hạng xếp theo tên. Một đơn đặt nhiều giờ chỉ tính là một lượt nhưng chiếm đủ số giờ công suất. Đơn hủy không được tính.</div>
                }
            </div>
        </div>
    </div>

    <div class="hs-sub">Cách tính: tỷ lệ khai thác = giờ sân đã đặt ÷ giờ có thể kinh doanh. Giờ có thể kinh doanh chỉ tính sân đang khả dụng, trong khung @hs.GioMo.ToString("00"):00–@hs.GioDong.ToString("00"):00 và các giờ đã diễn ra. Đơn chưa hoàn thành vẫn tính là đã giữ chỗ.</div>
</section>

<script>
    (function () {
        var root = document.querySelector('[data-pane="hieu-suat"]');
        if (!root) return;

        // Bản đồ nhiệt: chuyển giữa tỷ lệ khai thác và lượt đặt
        var heat = root.querySelector('#hs-heat');
        var heatBtns = [].slice.call(root.querySelectorAll('[data-hs-heat]'));
        heatBtns.forEach(function (b) {
            b.addEventListener('click', function () {
                var l = b.getAttribute('data-hs-heat') === 'l';
                if (heat) heat.classList.toggle('mode-l', l);
                heatBtns.forEach(function (x) {
                    var on = x === b;
                    x.classList.toggle('on', on);
                    x.setAttribute('aria-pressed', on ? 'true' : 'false');
                });
            });
        });

        // Bảng sân: Cao nhất / Thấp nhất / Tất cả, và lọc nhanh từ phần "Điểm cần chú ý"
        var rkBtns = [].slice.call(root.querySelectorAll('[data-hs-rk]'));
        var filterBar = root.querySelector('#hs-filter');
        var allList = root.querySelector('#hs-rk-all');

        function setFilter(on) {
            if (allList) allList.classList.toggle('filter-yeu', on);
            if (filterBar) filterBar.hidden = !on;
        }
        function showRk(key, keepFilter) {
            ['top', 'low', 'all'].forEach(function (k) {
                var el = root.querySelector('#hs-rk-' + k);
                if (el) el.hidden = (k !== key);
            });
            rkBtns.forEach(function (x) {
                var on = x.getAttribute('data-hs-rk') === key;
                x.classList.toggle('on', on);
                x.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
            if (!keepFilter) setFilter(false);
        }
        rkBtns.forEach(function (b) {
            b.addEventListener('click', function () { showRk(b.getAttribute('data-hs-rk'), false); });
        });
        [].slice.call(root.querySelectorAll('[data-hs-go="yeu"]')).forEach(function (b) {
            b.addEventListener('click', function () {
                showRk('all', true);
                setFilter(true);
                var target = root.querySelector('#hs-rk-all');
                if (target && target.scrollIntoView) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            });
        });
        // Phân trang bảng "Tất cả": mỗi lần hiện thêm 10 sân
        var more = root.querySelector('#hs-more');
        if (more) {
            more.addEventListener('click', function () {
                var step = parseInt(more.getAttribute('data-step'), 10) || 10;
                var hidden = [].slice.call(allList.querySelectorAll('.hs-row[data-pg-hide="1"]'));
                hidden.slice(0, step).forEach(function (r) { r.setAttribute('data-pg-hide', '0'); });
                var left = allList.querySelectorAll('.hs-row[data-pg-hide="1"]').length;
                if (left === 0) more.hidden = true; else more.textContent = 'Xem thêm (' + left + ' sân)';
            });
        }
        var _setFilter = setFilter;
        setFilter = function (on) { _setFilter(on); if (more) more.hidden = on || allList.querySelectorAll('.hs-row[data-pg-hide="1"]').length === 0; };

        // Tooltip bản đồ nhiệt: hiện khi rê chuột hoặc focus bàn phím
        var tip = root.querySelector('#hs-tip');
        if (heat && tip) {
            function row(a, b) { return '<div><span>' + a + '</span><span>' + b + '</span></div>'; }
            function showTip(c) {
                var html = '<b>' + c.dataset.t + '</b>';
                if (c.dataset.co === '1') {
                    html += row('Giờ đã đặt', c.dataset.d + ' giờ') + row('Giờ khả dụng', c.dataset.k + ' giờ')
                         + row('Tỷ lệ khai thác', c.dataset.r) + row('Số lượt đặt', c.dataset.l + ' lượt');
                } else {
                    html += '<div><span>Chưa diễn ra / chưa có công suất</span></div>' + row('Số lượt đặt', c.dataset.l + ' lượt');
                }
                tip.innerHTML = html;
                tip.hidden = false;
                var r = c.getBoundingClientRect(), t = tip.getBoundingClientRect();
                var x = Math.min(Math.max(8, r.left + r.width / 2 - t.width / 2), window.innerWidth - t.width - 8);
                var y = r.top - t.height - 8; if (y < 8) y = r.bottom + 8;
                tip.style.left = x + 'px'; tip.style.top = y + 'px';
            }
            function hideTip() { tip.hidden = true; }
            [].slice.call(heat.querySelectorAll('.hs-cell')).forEach(function (c) {
                c.addEventListener('mouseenter', function () { showTip(c); });
                c.addEventListener('mouseleave', hideTip);
                c.addEventListener('focus', function () { showTip(c); });
                c.addEventListener('blur', hideTip);
            });
            window.addEventListener('scroll', hideTip, true);
        }

        var off = root.querySelector('#hs-filter-off');
        if (off) off.addEventListener('click', function () { setFilter(false); });
    })();
</script>
