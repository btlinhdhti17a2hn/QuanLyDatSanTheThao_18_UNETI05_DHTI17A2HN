@* Họ và tên: Tạ Đình Kim
   Mã sinh viên: 23103100315
   Nội dung thực hiện: Form thêm dịch vụ (Admin). *@
@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.Entities.DichVu
@{
    ViewData["Title"] = "Thêm dịch vụ";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .dvc {
        max-width: 560px;
        margin: 0 auto;
        padding: 1.25rem 0;
    }

    .dvc-back {
        color: #64748b;
        font-size: .9rem;
        text-decoration: none;
    }

        .dvc-back:hover {
            color: #16a34a;
        }

    .dvc-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #14532d;
        margin: .35rem 0 .15rem;
    }

    .dvc-sub {
        color: #64748b;
        font-size: .9rem;
        margin-bottom: 1rem;
    }

    .dvc-card {
        background: #fff;
        border: 1px solid #e2ebe5;
        border-top: 4px solid #16a34a;
        border-radius: 14px;
        box-shadow: 0 6px 20px rgba(22, 101, 52, .08);
        padding: 1.25rem;
    }

    .dvc-label {
        font-size: .85rem;
        font-weight: 700;
        color: #14532d;
        margin-bottom: .3rem;
    }

    .dvc-icon-xt {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        font-size: 1.1rem;
        line-height: 1;
        vertical-align: middle;
    }

    .dvc .form-control, .dvc .input-group-text {
        border-color: #cfe0d6;
        border-radius: 10px;
        min-height: 42px;
    }

        .dvc .form-control:focus {
            border-color: #16a34a;
            box-shadow: 0 0 0 .2rem rgba(22, 163, 74, .15);
        }

    .dvc .input-group > .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    .dvc .input-group > .input-group-text {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        background: #f0fdf4;
        color: #15803d;
        font-weight: 700;
    }

    .dvc textarea.form-control {
        resize: none;
    }

    .dvc .input-validation-error {
        border-color: #dc3545;
    }

    .dvc .field-validation-error {
        display: block;
        font-size: .82rem;
        margin-top: .2rem;
    }

    .validation-summary-valid {
        display: none;
    }

    .dvc input[type=number] {
        -moz-appearance: textfield;
        appearance: textfield;
    }

        .dvc input[type=number]::-webkit-outer-spin-button,
        .dvc input[type=number]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

    .dvc-chip {
        padding: .1rem .7rem;
        border: 1px solid #cfe0d6;
        border-radius: 999px;
        background: #fff;
        color: #334155;
        font-size: .8rem;
        transition: .15s;
    }

        .dvc-chip:hover {
            border-color: #16a34a;
            background: #f0fdf4;
            color: #15803d;
        }

        .dvc-chip.active {
            background: #16a34a;
            border-color: #16a34a;
            color: #fff;
        }

    .dvc-status {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f0fdf4;
        border: 1px solid #d3f0de;
        border-radius: 10px;
        padding: .6rem .9rem;
    }

        .dvc-status .form-check-input {
            width: 2.6rem;
            height: 1.4rem;
            margin: 0;
            cursor: pointer;
        }

            .dvc-status .form-check-input:checked {
                background-color: #16a34a;
                border-color: #16a34a;
            }

        .dvc-status small {
            color: #64748b;
        }

    .dvc-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: .5rem;
        margin-top: 1.25rem;
    }

    .btn-green {
        background: #16a34a;
        color: #fff;
        border: 0;
        border-radius: 10px;
        font-weight: 600;
        padding: .5rem 1.4rem;
    }

        .btn-green:hover {
            background: #15803d;
            color: #fff;
        }

        .btn-green:disabled {
            background: #86c9a1;
            color: #fff;
        }

    .btn-cancel {
        color: #64748b;
        text-decoration: none;
        padding: .5rem 1rem;
        font-weight: 600;
        border-radius: 10px;
    }

        .btn-cancel:hover {
            background: #f1f5f9;
            color: #334155;
        }
</style>

<div class="dvc">
    <a asp-action="Index" class="dvc-back"><i class="bi bi-chevron-left"></i> Danh sách dịch vụ</a>
    <h1 class="dvc-title">Thêm dịch vụ</h1>
    <p class="dvc-sub">Dịch vụ khách có thể chọn thêm khi đặt sân.</p>

    <form asp-action="Create" method="post" id="serviceForm" class="dvc-card" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-end mb-1">
                <label asp-for="TenDichVu" class="dvc-label m-0">Tên dịch vụ <span class="text-danger">*</span></label>
                <small class="text-muted">Biểu tượng: <span class="dvc-icon-xt" id="iconXT">🏷️</span></small>
            </div>
            <input asp-for="TenDichVu" class="form-control" placeholder="Ví dụ: Thuê giày đá bóng" autocomplete="off" autofocus />
            <span asp-validation-for="TenDichVu" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DonGia" class="dvc-label">Đơn giá <span class="text-danger">*</span></label>
            <div class="input-group">
                <input asp-for="DonGia" type="number" min="0" step="1000" inputmode="numeric" class="form-control" placeholder="0" />
                <span class="input-group-text">đ</span>
            </div>
            <span asp-validation-for="DonGia" class="text-danger"></span>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                <button type="button" class="dvc-chip" data-value="10000">10.000</button>
                <button type="button" class="dvc-chip" data-value="20000">20.000</button>
                <button type="button" class="dvc-chip" data-value="50000">50.000</button>
                <button type="button" class="dvc-chip" data-value="100000">100.000</button>
                <small class="text-muted" id="giaHint">Nhập 0 nếu miễn phí</small>
            </div>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-end">
                <label asp-for="MoTa" class="dvc-label">Mô tả</label>
                <small class="text-muted" id="demMoTa"></small>
            </div>
            <textarea asp-for="MoTa" class="form-control" rows="2" placeholder="Ví dụ: Giày size 38–44, tính theo mỗi lượt thuê."></textarea>
            <span asp-validation-for="MoTa" class="text-danger"></span>
        </div>

        <div class="dvc-status">
            <div>
                <div class="dvc-label m-0" id="nhanTrangThai">Đang cung cấp</div>
                <small>Tắt để ẩn dịch vụ khỏi danh sách đặt sân.</small>
            </div>
            <div class="form-check form-switch m-0 p-0">
                <input asp-for="TrangThai" class="form-check-input" type="checkbox" role="switch" />
            </div>
        </div>

        <div class="dvc-actions">
            <a asp-action="Index" class="btn-cancel">Hủy</a>
            <button type="submit" class="btn btn-green" id="btnLuu"><i class="bi bi-check2-circle me-1"></i> Lưu dịch vụ</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var $ = function (id) { return document.getElementById(id); };
            var form = $('serviceForm'), btn = $('btnLuu');
            var ten = $('TenDichVu'), gia = $('DonGia'), moTa = $('MoTa'), tt = $('TrangThai');
            var chips = document.querySelectorAll('.dvc-chip');
            var fmt = new Intl.NumberFormat('vi-VN');
            var nutCu = btn.innerHTML;

            // Quy tắc chọn icon: giống hàm LayIcon ở trang Index
            function layIcon(s) {
                var t = (s || '').toLowerCase();
                if (/giày|giầy|giay/.test(t)) return '👟';
                if (/cầu lông|vợt/.test(t)) return '🏸';
                if (/tennis/.test(t)) return '🎾';
                if (/bóng rổ/.test(t)) return '🏀';
                if (/bóng/.test(t)) return '⚽';
                if (/áo|bib/.test(t)) return '👕';
                if (/tăng lực|redbull/.test(t)) return '⚡';
                if (/nước/.test(t)) return '🥤';
                if (/trọng tài/.test(t)) return '🏁';
                if (/khăn/.test(t)) return '🧣';
                return '🏷️';
            }

            // Giới hạn ký tự lấy từ [StringLength]/[MaxLength] của model (nếu có)
            var max = parseInt(moTa.getAttribute('data-val-length-max') || '', 10);
            if (max) moTa.setAttribute('maxlength', max);

            function capNhat() {
                var p = parseFloat(gia.value);
                if (isNaN(p) || p < 0) p = 0;

                $('iconXT').textContent = layIcon(ten.value);
                $('giaHint').textContent = p > 0 ? 'Khách thấy: ' + fmt.format(p) + ' đ' : 'Nhập 0 nếu miễn phí';
                chips.forEach(function (c) { c.classList.toggle('active', Number(c.dataset.value) === p); });
                $('nhanTrangThai').textContent = tt.checked ? 'Đang cung cấp' : 'Tạm ngưng';
                $('demMoTa').textContent = max ? moTa.value.length + '/' + max : '';
            }

            ten.addEventListener('input', capNhat);
            gia.addEventListener('input', capNhat);
            moTa.addEventListener('input', capNhat);
            tt.addEventListener('change', capNhat);

            chips.forEach(function (c) {
                c.addEventListener('click', function () {
                    gia.value = c.dataset.value;
                    capNhat();
                    if (window.jQuery && jQuery.fn.valid) { try { jQuery(gia).valid(); } catch (e) { } }
                });
            });

            // Ô giá: chọn hết khi focus, chặn cuộn chuột đổi giá trị và ký tự lạ
            gia.addEventListener('focus', function () { this.select(); });
            gia.addEventListener('wheel', function () { this.blur(); }, { passive: true });
            gia.addEventListener('keydown', function (e) {
                if (['e', 'E', '+', '-'].indexOf(e.key) !== -1) e.preventDefault();
            });

            // Chống bấm Lưu nhiều lần (chỉ khi form hợp lệ)
            form.addEventListener('submit', function () {
                if (window.jQuery && jQuery.fn.valid && !jQuery(form).valid()) return;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';
            });
            window.addEventListener('pageshow', function (e) {
                if (e.persisted) { btn.disabled = false; btn.innerHTML = nutCu; }
            });

            capNhat();
        })();
    </script>
}