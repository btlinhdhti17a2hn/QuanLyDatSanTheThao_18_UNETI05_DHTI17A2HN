@* Họ và tên: Tạ Đình Kim   Mã sinh viên: 23103100315   Nội dung thực hiện: Form sửa dịch vụ (Admin). *@
@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.Entities.DichVu
@{
    ViewData["Title"] = "Sửa dịch vụ";
}

<!-- Sử dụng Bootstrap Icons cho giao diện trực quan -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid px-4 py-4 bg-light min-vh-100">
    <!-- Tiêu đề trang & Nút quay lại -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Chỉnh sửa dịch vụ</h3>
            <p class="text-muted small mb-0">Cập nhật thông tin chi tiết, đơn giá và trạng thái cho dịch vụ.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 shadow-sm px-3 py-2">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <!-- Form chỉnh sửa đặt trong Card giao diện hiện đại -->
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border border-2 border-light shadow-sm rounded-4 overflow-hidden bg-white">
                <!-- Header Card -->
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">@Model.TenDichVu</h5>
                        <span class="text-muted small">Mã dịch vụ: #@Model.MaDichVu</span>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">Chế độ chỉnh sửa</span>
                </div>

                <!-- Thân Card chứa form -->
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 mb-3 shadow-sm small" role="alert"></div>

                        <input type="hidden" asp-for="MaDichVu" />

                        <div class="mb-3">
                            <label asp-for="TenDichVu" class="form-label fw-semibold text-secondary small text-uppercase">
                                Tên dịch vụ <span class="text-danger">*</span>
                            </label>
                            <input asp-for="TenDichVu" class="form-control rounded-3 shadow-none" placeholder="Nhập tên dịch vụ..." />
                            <span asp-validation-for="TenDichVu" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DonGia" class="form-label fw-semibold text-secondary small text-uppercase">
                                Đơn giá (đ) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="DonGia" type="number" min="0" step="1000" class="form-control rounded-start-3 shadow-none" placeholder="0" />
                                <span class="input-group-text bg-light text-muted fw-semibold rounded-end-3">VNĐ</span>
                            </div>
                            <span asp-validation-for="DonGia" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MoTa" class="form-label fw-semibold text-secondary small text-uppercase">
                                Mô tả chi tiết
                            </label>
                            <textarea asp-for="MoTa" class="form-control rounded-3 shadow-none" rows="3" placeholder="Nhập mô tả về dịch vụ (nếu có)..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                            <div class="form-check form-switch ps-0 d-flex justify-content-between align-items-center mb-0">
                                <label asp-for="TrangThai" class="form-check-label fw-semibold text-dark mb-0 cursor-pointer">
                                    Trạng thái hoạt động
                                </label>
                                <input asp-for="TrangThai" class="form-check-input fs-5 ms-3 shadow-none" type="checkbox" role="switch" />
                            </div>
                            <small class="text-muted mt-1" style="font-size: 0.8rem;">Bật để cho phép khách hàng tiếp tục chọn dịch vụ này khi đặt sân.</small>
                        </div>

                        <!-- Nhóm nút hành động -->
                        <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light border px-4 shadow-sm text-secondary">
                                Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}