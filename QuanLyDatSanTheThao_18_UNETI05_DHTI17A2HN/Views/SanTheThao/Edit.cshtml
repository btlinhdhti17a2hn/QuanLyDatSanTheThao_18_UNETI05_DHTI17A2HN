@*
// Họ và tên: Bùi Thùy Linh
// Mã sinh viên: 23103100108
// Nội dung thực hiện: Giao diện Razor View - Chỉnh sửa, cập nhật sân thể thao (Module 2)
*@
@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.Entities.SanTheThao
@{
    ViewData["Title"] = "Sửa sân thể thao";
}

<style>
    
    .form-card {
        border-radius: 20px;
        border: 1.5px solid #a7f3d0;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(5, 150, 105, 0.08);
        background: #ffffff;
    }
    .form-banner {
        background: linear-gradient(135deg, #064e3b 0%, #047857 55%, #059669 100%);
        padding: 24px 30px;
        color: #ffffff;
    }
    .form-banner.edit {
        background: linear-gradient(135deg, #0f766e 0%, #059669 100%);
    }
    .form-banner h4 {
        font-weight: 800;
        margin-bottom: 4px;
        font-size: 1.45rem;
        letter-spacing: -0.3px;
    }
    .form-banner p {
        color: #d1fae5;
        margin-bottom: 0;
        font-size: 0.9rem;
    }

    .form-label {
        font-weight: 700;
        color: #065f46;
        font-size: 0.9rem;
        margin-bottom: 6px;
    }
    .form-control, .form-select {
        border-radius: 10px;
        border: 1.5px solid #d1fae5;
        padding: 9px 14px;
        font-size: 0.92rem;
        transition: all 0.2s ease;
    }
    .form-control:focus, .form-select:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.18);
    }
    .input-group-text {
        background-color: #ecfdf5;
        border: 1.5px solid #d1fae5;
        border-right: none;
        border-radius: 10px 0 0 10px;
        color: #047857;
        font-size: 1.1rem;
    }
    .input-group .form-control, .input-group .form-select {
        border-radius: 0 10px 10px 0;
    }
    .input-group .form-control.has-suffix {
        border-radius: 0;
    }
    .suffix {
        background: #f0fdf4;
        border: 1.5px solid #d1fae5;
        border-left: none;
        border-radius: 0 10px 10px 0;
        padding: 9px 14px;
        color: #047857;
        font-weight: 700;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
    }

    .status-box {
        background: #f0fdf4;
        border: 1.5px solid #bbf7d0;
        border-radius: 12px;
        padding: 14px 18px;
    }
    .status-box .form-check-input {
        width: 44px;
        height: 22px;
        cursor: pointer;
    }
    .status-box .form-check-input:checked {
        background-color: #059669;
        border-color: #059669;
    }

    .btn-save {
        background: linear-gradient(135deg, #059669 0%, #10b981 100%);
        color: #ffffff;
        font-weight: 700;
        border-radius: 12px;
        padding: 10px 24px;
        border: none;
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);
        transition: all 0.25s ease;
    }
    .btn-save:hover {
        background: linear-gradient(135deg, #047857 0%, #059669 100%);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(5, 150, 105, 0.35);
    }
    .btn-back {
        background: #f0fdf4;
        color: #047857;
        font-weight: 700;
        border: 1.5px solid #a7f3d0;
        border-radius: 12px;
        padding: 10px 20px;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .btn-back:hover {
        background: #dcfce7;
        color: #064e3b;
    }
</style>

<div class="container mt-4 mb-5" style="max-width: 820px;">
    <div class="card form-card">

        <div class="form-banner edit">
            <h4>CẬP NHẬT SÂN THỂ THAO</h4>
            <p>Chỉnh sửa thông tin sân #@Model.MaSan</p>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.MaSan">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="MaSan" />

                <partial name="_FormSan" model="Model" />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-back">← Quay lại</a>
                    <button type="submit" class="btn btn-save">💾 Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}