@*
// Họ và tên: Bùi Thùy Linh
// Mã sinh viên: 23103100108
// Nội dung thực hiện: Giao diện danh sách sân thể thao - tìm kiếm, lọc, sắp xếp, phân trang (Module 2)
*@
@using QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Helpers
@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.ViewModels.SanTheThaoIndexViewModel
@{
    var vaiTro = Context.Session.GetString("VaiTro");
    bool laQuanLy = vaiTro == "Admin" || vaiTro == "NhanVien";
    ViewData["Title"] = laQuanLy ? "Quản lý sân thể thao" : "Danh sách sân thể thao";

    // Địa chỉ trang hiện tại (kèm điều kiện lọc) để quay lại sau khi xóa / đổi trạng thái
    string returnUrl = Context.Request.Path.Value + Context.Request.QueryString.Value;

    // Giá trị hiển thị lại trong các ô lọc
    string? vNgay = Model.NgaySuDung?.ToString("yyyy-MM-dd");
    string? vGioBd = Model.GioBatDau?.ToString(@"hh\:mm");
    string? vGioKt = Model.GioKetThuc?.ToString(@"hh\:mm");
    string? vGiaTu = Model.GiaTu?.ToString("0");
    string? vGiaDen = Model.GiaDen?.ToString("0");

    var cacKieuSapXep = new (string Ma, string Ten)[]
    {
        ("ten_asc", "Tên sân A → Z"),
        ("ten_desc", "Tên sân Z → A"),
        ("gia_asc", "Đơn giá tăng dần"),
        ("gia_desc", "Đơn giá giảm dần"),
        ("gio_asc", "Giờ mở cửa sớm → muộn"),
        ("gio_desc", "Giờ mở cửa muộn → sớm")
    };

    // Cửa sổ số trang hiển thị: trang hiện tại ± 2
    int trangTu = Math.Max(1, Model.TrangHienTai - 2);
    int trangDen = Math.Min(Model.TongTrang, Model.TrangHienTai + 2);
}

