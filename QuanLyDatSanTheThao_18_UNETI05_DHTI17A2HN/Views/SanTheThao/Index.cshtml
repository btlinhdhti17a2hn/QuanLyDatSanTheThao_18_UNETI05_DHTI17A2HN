<div class="container mt-4 mb-5">

    <!-- TIÊU ĐỀ TRANG -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            @if (laQuanLy)
            {
                <h2>🏟️ QUẢN LÝ SÂN THỂ THAO</h2>
                <p>Thêm, sửa, xóa sân và cập nhật trạng thái hoạt động của từng sân</p>
            }
            else
            {
                <h2>🏟️ DANH SÁCH SÂN THỂ THAO</h2>
                <p>Tìm sân phù hợp, kiểm tra tình trạng và đặt lịch nhanh chóng</p>
            }
        </div>
        @if (laQuanLy)
        {
            <a asp-action="Create" class="btn btn-add">+ Thêm sân mới</a>
        }
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 alert-dismissible fade show" role="alert">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-4 alert-dismissible fade show" role="alert">
            ⚠️ @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 alert-dismissible fade show" role="alert">
            ❌ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.CanhBao))
    {
        <div class="alert alert-info border-0 shadow-sm rounded-4" role="alert">ℹ️ @Model.CanhBao</div>
    }

    <!-- THỐNG KÊ NHANH (dành cho quản lý) -->
    @if (laQuanLy)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon s-total">🏟️</div>
                    <div>
                        <div class="stat-num text-primary">@Model.TongSan</div>
                        <div class="stat-label">Tổng số sân</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon s-active">✅</div>
                    <div>
                        <div class="stat-num text-success">@Model.SanKhaDung</div>
                        <div class="stat-label">Đang khả dụng</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon s-lock">🛠️</div>
                    <div>
                        <div class="stat-num" style="color:#b45309">@Model.SanKhongKhaDung</div>
                        <div class="stat-label">Ngừng / đang bảo trì</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- BỘ LỌC: TÌM KIẾM + LỌC + SẮP XẾP (gửi bằng GET để giữ điều kiện trên URL) -->
    <form method="get" asp-action="Index" class="filter-card mb-4">
        <div class="row g-3">
            <div class="col-lg-4 col-md-6">
                <label class="form-label">🔍 Tìm kiếm</label>
                <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
                       placeholder="Tên sân, loại sân hoặc địa chỉ..." />
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">⚽ Loại sân</label>
                <select name="maLoaiSan" class="form-select">
                    <option value="">Tất cả loại sân</option>
                    @foreach (var l in Model.LoaiSans)
                    {
                        <option value="@l.MaLoaiSan" selected="@(Model.MaLoaiSan == l.MaLoaiSan)">@l.TenLoai</option>
                    }
                </select>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label">📌 Trạng thái</label>
                <select name="trangThai" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="hoatdong" selected="@(Model.TrangThai == "hoatdong")">Hoạt động</option>
                    <option value="ngung" selected="@(Model.TrangThai == "ngung")">Ngừng hoạt động</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <label class="form-label">💰 Giá từ (đ)</label>
                <input type="number" name="giaTu" value="@vGiaTu" min="0" step="1000" class="form-control" placeholder="0" />
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <label class="form-label">💰 Giá đến (đ)</label>
                <input type="number" name="giaDen" value="@vGiaDen" min="0" step="1000" class="form-control" placeholder="500000" />
            </div>

            <div class="col-lg-3 col-md-4">
                <label class="form-label">📅 Ngày sử dụng</label>
                <input type="date" name="ngaySuDung" value="@vNgay" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <label class="form-label">⏰ Từ giờ</label>
                <input type="time" name="gioBatDau" value="@vGioBd" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-4 col-6">
                <label class="form-label">⏰ Đến giờ</label>
                <input type="time" name="gioKetThuc" value="@vGioKt" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label">🟢 Sân còn trống</label>
                <div class="check-box form-check form-switch">
                    <input class="form-check-input ms-0" type="checkbox" role="switch" id="conTrong" name="conTrong" value="true" @(Model.ConTrong ? "checked" : "") />
                    <label class="form-check-label fw-bold small" for="conTrong">Chỉ sân trống</label>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label">↕️ Sắp xếp</label>
                <select name="sapXep" class="form-select">
                    @foreach (var kieu in cacKieuSapXep)
                    {
                        <option value="@kieu.Ma" selected="@(Model.SapXep == kieu.Ma)">@kieu.Ten</option>
                    }
                </select>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-filter">🔎 Tìm kiếm / Lọc</button>
            <a asp-action="Index" class="btn btn-reset">✖ Xóa bộ lọc</a>
        </div>
    </form>

    <!-- THANH KẾT QUẢ -->
    <div class="mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="result-bar">📋 Tìm thấy @Model.TongKetQua sân @(Model.CoLoc ? "phù hợp" : "")</span>
        @if (Model.TongTrang > 0)
        {
            <span class="text-muted small">Trang @Model.TrangHienTai / @Model.TongTrang</span>
        }
    </div>

    @if (!Model.DanhSach.Any())
    {
        <div class="card table-card">
            <div class="empty-box">
                <div class="emoji">🔍</div>
                <h5 class="mt-2 fw-bold">Không tìm thấy sân nào</h5>
                <p class="mb-3">Hãy thử thay đổi từ khóa hoặc nới lỏng điều kiện lọc.</p>
                <a asp-action="Index" class="btn btn-success rounded-pill fw-bold px-4">Xem tất cả sân</a>
            </div>
        </div>
    }
    else if (laQuanLy)
    {
        <!-- ================= GIAO DIỆN QUẢN LÝ (BẢNG) ================= -->
        <div class="card table-card">
            <div class="table-responsive">
                <table class="table table-pretty align-middle">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Sân</th>
                            <th>Địa chỉ</th>
                            <th>Giờ hoạt động</th>
                            <th>Đơn giá / giờ</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.DanhSach)
                        {
                            <tr>
                                <td><span class="ma-badge">@s.MaSan</span></td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="loai-icon">@SanTheThaoUi.Icon(s.LoaiSan.TenLoai)</span>
                                        <div>
                                            <div class="fw-bold">@s.TenSan</div>
                                            <span class="loai-tag">@s.LoaiSan.TenLoai</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-muted">@s.DiaChi</td>
                                <td><span class="gio-tag">🕒 @SanTheThaoUi.Gio(s.GioMoCua) - @SanTheThaoUi.Gio(s.GioDongCua)</span></td>
                                <td><span class="gia-tag">@SanTheThaoUi.Tien(s.DonGia)</span></td>
                                <td>
                                    @if (s.DangKhaDung)
                                    {
                                        <span class="status-pill status-on">Còn khả dụng</span>
                                    }
                                    else if (s.DangBaoTri)
                                    {
                                        <span class="status-pill status-warn">Đang bảo trì</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-off">Ngừng hoạt động</span>
                                    }
                                </td>
                                <td class="text-center text-nowrap">
                                    <a asp-action="Details" asp-route-id="@s.MaSan" class="btn btn-act btn-view me-1">👁️ Xem</a>
                                    <a asp-action="Edit" asp-route-id="@s.MaSan" class="btn btn-act btn-edit me-1">✏️ Sửa</a>

                                    <form asp-action="DoiTrangThai" asp-route-id="@s.MaSan" method="post" class="d-inline">
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="btn btn-act btn-toggle me-1">@(s.TrangThai ? "⏸️ Ngừng" : "▶️ Mở lại")</button>
                                    </form>

                                    <form asp-action="Delete" asp-route-id="@s.MaSan" method="post" class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa sân này không?');">
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="btn btn-act btn-del">🗑️ Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- ================= GIAO DIỆN KHÁCH HÀNG (THẺ SÂN) ================= -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var s in Model.DanhSach)
            {
                <div class="col">
                    <div class="court-card">
                        <div class="court-top @SanTheThaoUi.Theme(s.LoaiSan.TenLoai)">
                            <span class="court-id">Sân #@s.MaSan</span>
                            @if (s.DangKhaDung)
                            {
                                <span class="status-pill status-on court-badge">Còn khả dụng</span>
                            }
                            else if (s.DangBaoTri)
                            {
                                <span class="status-pill status-warn court-badge">Đang bảo trì</span>
                            }
                            else
                            {
                                <span class="status-pill status-off court-badge">Không khả dụng</span>
                            }
                            <span>@SanTheThaoUi.Icon(s.LoaiSan.TenLoai)</span>
                        </div>

                        <div class="court-body">
                            <span class="loai-tag">@s.LoaiSan.TenLoai</span>
                            <div class="court-name">@s.TenSan</div>
                            <div class="court-meta"><span>📍</span><span>@s.DiaChi</span></div>
                            <div class="court-meta"><span>🕒</span><span>Mở cửa @SanTheThaoUi.Gio(s.GioMoCua) - @SanTheThaoUi.Gio(s.GioDongCua)</span></div>
                            <div class="court-meta"><span>👥</span><span>Tối đa @s.LoaiSan.SoNguoiToiDa người</span></div>
                            <div class="mt-2">
                                @foreach (var ti in SanTheThaoUi.TachTienIch(s.TienIch))
                                {
                                    <span class="chip">✔ @ti</span>
                                }
                            </div>
                        </div>

                        <div class="court-foot">
                            <div class="court-price me-auto">@SanTheThaoUi.Tien(s.DonGia)<small> /giờ</small></div>
                            <a asp-action="Details" asp-route-id="@s.MaSan" class="btn-detail">Chi tiết</a>
                            @if (s.DangKhaDung)
                            {
                                <a asp-controller="DatSan" asp-action="Create" asp-route-maSan="@s.MaSan" class="btn-book">📅 Đặt sân</a>
                            }
                            else
                            {
                                <span class="btn-book disabled">🚫 Đặt sân</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ================= PHÂN TRANG (giữ nguyên toàn bộ điều kiện) ================= -->
    @if (Model.TongTrang > 1)
    {
        <nav class="mt-4 d-flex flex-column align-items-center gap-2" aria-label="Phân trang">
            <ul class="pagination pagination-green mb-0">
                <li class="page-item @(Model.TrangHienTai <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="Model.TaoRouteData(Model.TrangHienTai - 1)">‹ Trước</a>
                </li>

                @if (trangTu > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="Model.TaoRouteData(1)">1</a></li>
                    @if (trangTu > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                }

                @for (int p = trangTu; p <= trangDen; p++)
                {
                    <li class="page-item @(p == Model.TrangHienTai ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="Model.TaoRouteData(p)">@p</a>
                    </li>
                }

                @if (trangDen < Model.TongTrang)
                {
                    @if (trangDen < Model.TongTrang - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="Model.TaoRouteData(Model.TongTrang)">@Model.TongTrang</a></li>
                }

                <li class="page-item @(Model.TrangHienTai >= Model.TongTrang ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="Model.TaoRouteData(Model.TrangHienTai + 1)">Sau ›</a>
                </li>
            </ul>
            <small class="text-muted">Đang xem trang <strong>@Model.TrangHienTai</strong> / @Model.TongTrang · @Model.KichThuocTrang sân mỗi trang</small>
        </nav>
    }
</div>