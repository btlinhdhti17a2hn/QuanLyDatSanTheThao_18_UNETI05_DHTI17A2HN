@*
// Họ và tên: Bùi Thùy Linh
// Mã sinh viên: 23103100108
// Nội dung thực hiện: Partial View chứa các trường nhập liệu dùng chung cho Thêm / Sửa sân (Module 2)
*@
@using Microsoft.AspNetCore.Mvc.Rendering
@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.Entities.SanTheThao
@{
    // Định dạng giá trị cho thẻ input type="time" / "date"
    string gioMo = Model.GioMoCua.ToString(@"hh\:mm");
    string gioDong = Model.GioDongCua.ToString(@"hh\:mm");
    string? ngayBaoTri = Model.NgayBaoTri?.ToString("yyyy-MM-dd");
    string? donGia = Model.DonGia.ToString("0");
}

<div class="mb-4">
    <label asp-for="TenSan" class="form-label fw-bold">Tên sân <span class="text-danger">*</span></label>
    <div class="input-group">
        <span class="input-group-text">🏟️</span>
        <input asp-for="TenSan" class="form-control" placeholder="VD: Sân số 1 - Bóng đá 7 người" />
    </div>
    <span asp-validation-for="TenSan" class="text-danger"></span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label asp-for="MaLoaiSan" class="form-label fw-bold">Loại sân <span class="text-danger">*</span></label>
        <div class="input-group">
            <span class="input-group-text">⚽</span>
            <select asp-for="MaLoaiSan" asp-items="(SelectList)ViewBag.LoaiSanList" class="form-select">
                <option value="">-- Chọn loại sân --</option>
            </select>
        </div>
        <span asp-validation-for="MaLoaiSan" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DonGia" class="form-label fw-bold">Đơn giá theo giờ <span class="text-danger">*</span></label>
        <div class="input-group">
            <span class="input-group-text">💰</span>
            <input asp-for="DonGia" type="number" min="0" step="1000" value="@donGia" class="form-control has-suffix" />
            <span class="suffix">VNĐ</span>
        </div>
        <span asp-validation-for="DonGia" class="text-danger"></span>
    </div>
</div>

<div class="mb-4">
    <label asp-for="DiaChi" class="form-label fw-bold">Địa chỉ <span class="text-danger">*</span></label>
    <div class="input-group">
        <span class="input-group-text">📍</span>
        <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ của sân..." />
    </div>
    <span asp-validation-for="DiaChi" class="text-danger"></span>
</div>

<div class="mb-4">
    <label asp-for="TienIch" class="form-label fw-bold">Tiện ích</label>
    <textarea asp-for="TienIch" class="form-control" rows="2" placeholder="Ngăn cách bằng dấu phẩy. VD: Wifi, Trà đá miễn phí, Chỗ để xe"></textarea>
    <span asp-validation-for="TienIch" class="text-danger"></span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <label asp-for="GioMoCua" class="form-label fw-bold">Giờ mở cửa <span class="text-danger">*</span></label>
        <div class="input-group">
            <span class="input-group-text">🌅</span>
            <input asp-for="GioMoCua" type="time" value="@gioMo" class="form-control" />
        </div>
        <span asp-validation-for="GioMoCua" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="GioDongCua" class="form-label fw-bold">Giờ đóng cửa <span class="text-danger">*</span></label>
        <div class="input-group">
            <span class="input-group-text">🌙</span>
            <input asp-for="GioDongCua" type="time" value="@gioDong" class="form-control" />
        </div>
        <span asp-validation-for="GioDongCua" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="NgayBaoTri" class="form-label fw-bold">Ngày bảo trì</label>
        <div class="input-group">
            <span class="input-group-text">🛠️</span>
            <input asp-for="NgayBaoTri" type="date" value="@ngayBaoTri" class="form-control" />
        </div>
        <span asp-validation-for="NgayBaoTri" class="text-danger"></span>
    </div>
</div>

<div class="mb-4">
    <label asp-for="GhiChu" class="form-label fw-bold">Ghi chú</label>
    <textarea asp-for="GhiChu" class="form-control" rows="3" placeholder="Ghi chú thêm về sân (nếu có)..."></textarea>
    <span asp-validation-for="GhiChu" class="text-danger"></span>
</div>

<div class="status-box form-check form-switch mb-4 d-flex align-items-center gap-3">
    <input class="form-check-input ms-0" asp-for="TrangThai" />
    <label class="form-check-label fw-bold" asp-for="TrangThai">Sân đang hoạt động (bật = cho phép khách đặt sân)</label>
</div>