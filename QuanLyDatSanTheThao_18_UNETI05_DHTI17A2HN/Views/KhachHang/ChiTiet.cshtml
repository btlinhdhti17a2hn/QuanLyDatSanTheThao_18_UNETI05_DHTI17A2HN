@*
// Họ và tên: Nguyễn Thị Lan Nhi
// Mã sinh viên: 23103100104
// Nội dung thực hiện: Module 3 - Giao diện Chi tiết khách hàng - Thông tin cá nhân và lịch sử đặt sân
*@

@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.Entities.KhachHang

@{
    ViewData["Title"] = "Chi tiết khách hàng - #" + Model.MaKhachHang;
}

<div class="container py-4">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-success">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-success">Danh sách khách hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết khách hàng #@Model.MaKhachHang</li>
        </ol>
    </nav>

    <!-- Thẻ thông tin khách hàng -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #16a34a, #22c55e); display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem;">
                        👤
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">@Model.HoTen</h4>
                        <small class="text-muted">
                            Mã khách hàng: <strong>#@Model.MaKhachHang</strong> | Tài khoản: 
                            @(Model.TaiKhoan != null ? "@" + Model.TaiKhoan.TenDangNhap : "Chưa liên kết")
                        </small>
                    </div>
                </div>
                <div>
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger fs-6 px-3 py-2 rounded-pill">Đã bị khóa</span>
                    }
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <span class="text-muted small d-block mb-1">Số điện thoại</span>
                    <a href="tel:@Model.SoDienThoai" class="fw-semibold text-dark text-decoration-none fs-6">📞 @Model.SoDienThoai</a>
                </div>

                <div class="col-md-6 col-lg-3">
                    <span class="text-muted small d-block mb-1">Email liên hệ</span>
                    <span class="fw-semibold text-dark fs-6">✉️ @(Model.Email ?? "Chưa có email")</span>
                </div>

                <div class="col-md-6 col-lg-3">
                    <span class="text-muted small d-block mb-1">Giới tính</span>
                    <span class="fw-semibold text-dark fs-6">@(Model.GioiTinh ?? "Chưa xác định")</span>
                </div>

                <div class="col-md-6 col-lg-3">
                    <span class="text-muted small d-block mb-1">Ngày sinh</span>
                    <span class="fw-semibold text-dark fs-6">@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</span>
                </div>

                <div class="col-md-6 col-lg-3">
                    <span class="text-muted small d-block mb-1">Ngày đăng ký</span>
                    <span class="fw-semibold text-dark fs-6">📅 @Model.NgayDangKy.ToString("dd/MM/yyyy")</span>
                </div>

                <div class="col-md-6 col-lg-3">
                    <span class="text-muted small d-block mb-1">Điểm tích lũy</span>
                    <span class="badge bg-warning text-dark fs-6 px-3 py-1 rounded-pill">⭐ @Model.DiemTichLuy điểm</span>
                </div>

                <div class="col-lg-6">
                    <span class="text-muted small d-block mb-1">Địa chỉ</span>
                    <span class="fw-semibold text-dark fs-6">📍 @(Model.DiaChi ?? "Chưa cập nhật địa chỉ")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách lịch sử đặt sân của khách hàng -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold text-success mb-0">🏟️ Lịch sử các đơn đặt sân</h5>
                <small class="text-muted">Tổng số lượt đặt: @(Model.DatSans?.Count ?? 0) giao dịch</small>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã đơn</th>
                        <th>Sân thể thao</th>
                        <th>Thời gian sử dụng</th>
                        <th>Đơn giá/giờ</th>
                        <th>Tiền cọc</th>
                        <th class="text-center">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DatSans != null && Model.DatSans.Any())
                    {
                        foreach (var ds in Model.DatSans.OrderByDescending(d => d.NgayDat))
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@ds.MaDatSan</td>
                                <td>
                                    <div class="fw-semibold text-dark">@(ds.SanTheThao?.TenSan ?? $"Sân #{ds.MaSan}")</div>
                                    <small class="text-muted">Ngày đặt: @ds.NgayDat.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary">@ds.GioBatDau.ToString("dd/MM/yyyy")</div>
                                    <small class="text-secondary">@ds.GioBatDau.ToString("HH:mm") - @ds.GioKetThuc.ToString("HH:mm")</small>
                                </td>
                                <td>@ds.DonGia.ToString("N0") VNĐ</td>
                                <td class="fw-bold text-success">@ds.TienCoc.ToString("N0") VNĐ</td>
                                <td class="text-center">
                                    @switch (ds.TrangThai)
                                    {
                                        case "Chờ xử lý":
                                            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">Chờ xử lý</span>
                                            break;
                                        case "Đang xử lý":
                                            <span class="badge bg-info text-dark px-3 py-1 rounded-pill">Đang xử lý</span>
                                            break;
                                        case "Hoàn thành":
                                            <span class="badge bg-success px-3 py-1 rounded-pill">Hoàn thành</span>
                                            break;
                                        case "Đã hủy":
                                            <span class="badge bg-danger px-3 py-1 rounded-pill">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-3 py-1 rounded-pill">@ds.TrangThai</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <em>Khách hàng chưa có giao dịch đặt sân nào.</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Nút điều hướng -->
    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            Quay lại danh sách
        </a>
    </div>
</div>
