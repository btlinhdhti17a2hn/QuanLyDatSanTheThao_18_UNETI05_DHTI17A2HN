@*
// Họ và tên: Lê Bích Ngọc
// Mã sinh viên: 23103100111
// Nội dung thực hiện: Giao diện Razor View Đăng nhập
*@

@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<style>
    .login-wrap {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    .login-card {
        width: 100%;
        max-width: 460px;
        border: none;
        border-radius: 24px;
        box-shadow: 0 15px 45px rgba(22, 163, 74, .18);
        overflow: hidden;
    }

    .login-banner {
        padding: 2.2rem 1.5rem 2rem;
        text-align: center;
        color: #fff;
        background: linear-gradient(135deg, #14532d, #16a34a 60%, #65a30d);
        position: relative;
        overflow: hidden;
    }

        .login-banner::before,
        .login-banner::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, .1);
        }

        .login-banner::before {
            width: 160px;
            height: 160px;
            top: -60px;
            left: -50px;
        }

        .login-banner::after {
            width: 120px;
            height: 120px;
            bottom: -50px;
            right: -30px;
        }

    .login-logo {
        width: 76px;
        height: 76px;
        margin: 0 auto 1rem;
        border-radius: 50%;
        background: rgba(255, 255, 255, .95);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.3rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, .25);
        position: relative;
        z-index: 1;
    }

    .login-banner h4 {
        font-weight: 800;
        margin: 0;
        position: relative;
        z-index: 1;
    }

    .login-banner p {
        margin: .35rem 0 0;
        opacity: .85;
        font-size: .92rem;
        position: relative;
        z-index: 1;
    }

    .login-card .form-label {
        color: #166534;
        margin-bottom: .4rem;
    }

    .login-card .input-group-text {
        background: #f0fdf4;
        border: 1px solid #d1fae5;
        border-right: none;
        border-radius: 12px 0 0 12px;
        font-size: 1.1rem;
    }

    .login-card .input-group .form-control {
        border: 1px solid #d1fae5;
        border-left: none;
        padding: .75rem 1rem;
    }

        .login-card .input-group .form-control.has-toggle {
            border-right: none;
        }

    .login-card .form-control:focus {
        border-color: #22c55e;
        box-shadow: none;
    }

    .login-card .input-group:focus-within .input-group-text,
    .login-card .input-group:focus-within .form-control,
    .login-card .input-group:focus-within .btn-eye {
        border-color: #22c55e;
    }

    .login-card .input-group:focus-within {
        border-radius: 12px;
        box-shadow: 0 0 0 .2rem rgba(34, 197, 94, .2);
    }

    .login-card .input-group .form-control:not(.has-toggle) {
        border-radius: 0 12px 12px 0;
    }

    .btn-eye {
        background: #fff;
        border: 1px solid #d1fae5;
        border-left: none;
        border-radius: 0 12px 12px 0;
        padding: 0 1rem;
        cursor: pointer;
        font-size: 1.1rem;
    }

        .btn-eye:hover {
            background: #f0fdf4;
        }

    .btn-login {
        border: none;
        border-radius: 50px;
        padding: .8rem;
        font-weight: 800;
        letter-spacing: .5px;
        color: #fff;
        background: linear-gradient(135deg, #16a34a, #22c55e);
        box-shadow: 0 8px 20px rgba(22, 163, 74, .4);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .btn-login:hover {
            color: #fff;
            transform: translateY(-3px);
            box-shadow: 0 12px 26px rgba(22, 163, 74, .5);
        }

    .login-footer {
        background: #f0fdf4;
        border-top: 1px solid #d1fae5;
        text-align: center;
        padding: 1.1rem;
    }

        .login-footer a {
            color: #15803d;
            font-weight: 800;
            text-decoration: none;
        }

            .login-footer a:hover {
                text-decoration: underline;
            }
</style>

<div class="login-wrap">
    <div class="card login-card">

        <div class="login-banner">
            <div class="login-logo">🏟️</div>
            <h4>HỆ THỐNG ĐẶT SÂN</h4>
            <p>Đăng nhập để quản lý và đặt sân thể thao</p>
        </div>

        <div class="card-body p-4 p-md-5 pb-4">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger border-0 shadow-sm rounded-4 text-center">
                    ❌ @ViewBag.Error
                </div>
            }

            <form asp-controller="TaiKhoan" asp-action="DangNhap" method="post">
                <div class="mb-4">
                    <label class="form-label fw-bold">Tên đăng nhập <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">👤</span>
                        <input type="text" name="tenDangNhap" class="form-control" required placeholder="Nhập tên đăng nhập..." autocomplete="username" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Mật khẩu <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">🔒</span>
                        <input type="password" id="oMatKhau" name="matKhau" class="form-control has-toggle" required placeholder="Nhập mật khẩu..." autocomplete="current-password" />
                        <button type="button" class="btn-eye" id="nutHienMatKhau" title="Hiện / ẩn mật khẩu">👁️</button>
                    </div>
                </div>

                <button type="submit" class="btn btn-login w-100 text-uppercase">Đăng Nhập</button>
            </form>
        </div>

        <div class="login-footer">
            <small>Chưa có tài khoản? <a asp-controller="TaiKhoan" asp-action="DangKy">Đăng ký ngay</a></small>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const oMatKhau = document.getElementById('oMatKhau');
            const nut = document.getElementById('nutHienMatKhau');
            nut.addEventListener('click', function () {
                const dangAn = oMatKhau.type === 'password';
                oMatKhau.type = dangAn ? 'text' : 'password';
                nut.textContent = dangAn ? '🙈' : '👁️';
            });
        })();
    </script>
}