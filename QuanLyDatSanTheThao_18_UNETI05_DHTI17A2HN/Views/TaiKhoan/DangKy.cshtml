@*
// Họ và tên: Lê Bích Ngọc
// Mã sinh viên: 23103100111
// Nội dung thực hiện: Giao diện Razor View Đăng ký tài khoản khách hàng
*@

@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SPORTS GROUND</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">

        <partial name="_AuthHero" />

        <section class="auth-card wide">
            <div class="card-brand"><span class="brand-badge sm">🏟️</span> SPORTS GROUND</div>
            <p class="card-sub">Tạo tài khoản khách hàng để bắt đầu đặt sân</p>

            @if (ViewBag.Error != null)
            {
                <div class="auth-alert error">❌ @ViewBag.Error</div>
            }

            <form asp-controller="TaiKhoan" asp-action="DangKy" method="post" id="formDangKy">
                <div class="form-grid">
                    <div class="mb-field span-2">
                        <label class="field-label" for="oHoTen">Họ và tên <span class="req">*</span></label>
                        <div class="input-wrap">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
                            <input type="text" id="oHoTen" name="hoTen" required placeholder="Nhập họ và tên..." autocomplete="name" />
                        </div>
                    </div>

                    <div class="mb-field">
                        <label class="field-label" for="oTenDangNhap">Tên đăng nhập <span class="req">*</span></label>
                        <div class="input-wrap">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
                            <input type="text" id="oTenDangNhap" name="tenDangNhap" required placeholder="Nhập tên đăng nhập..." autocomplete="username" />
                        </div>
                    </div>

                    <div class="mb-field">
                        <label class="field-label" for="oSoDienThoai">Số điện thoại <span class="req">*</span></label>
                        <div class="input-wrap">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg>
                            <input type="tel" id="oSoDienThoai" name="soDienThoai" required placeholder="Nhập số điện thoại..." autocomplete="tel" />
                        </div>
                    </div>

                    <div class="mb-field">
                        <label class="field-label" for="oMatKhau">Mật khẩu <span class="req">*</span></label>
                        <div class="input-wrap">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
                            <input type="password" id="oMatKhau" name="matKhau" class="has-toggle" required placeholder="Nhập mật khẩu..." autocomplete="new-password" />
                            <button type="button" class="btn-eye" data-target="oMatKhau" title="Hiện / ẩn mật khẩu">👁️</button>
                        </div>
                    </div>

                    <div class="mb-field">
                        <label class="field-label" for="oXacNhan">Xác nhận mật khẩu <span class="req">*</span></label>
                        <div class="input-wrap">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
                            <input type="password" id="oXacNhan" name="xacNhanMatKhau" class="has-toggle" required placeholder="Nhập lại mật khẩu..." autocomplete="new-password" />
                            <button type="button" class="btn-eye" data-target="oXacNhan" title="Hiện / ẩn mật khẩu">👁️</button>
                        </div>
                        <div id="thongBaoKhop" class="match-msg"></div>
                    </div>

                    <div class="mb-field span-2">
                        <label class="field-label" for="oEmail">Email</label>
                        <div class="input-wrap">
                            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                            <input type="email" id="oEmail" name="email" placeholder="Nhập địa chỉ email..." autocomplete="email" />
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-primary-auth">Đăng ký ngay →</button>
            </form>

            <div class="divider">Đã có tài khoản?</div>
            <a class="btn-secondary-auth" asp-controller="TaiKhoan" asp-action="DangNhap">🔑 Đăng nhập</a>

            <div class="auth-home"><a asp-controller="Home" asp-action="Index">← Về trang chủ</a></div>
            <div class="auth-copy">© 2026 Sports Ground. Bài tập lớn .NET - Đề 18 (UNETI)</div>
        </section>
    </div>

    <script>
        (function () {
            // Nút hiện / ẩn mật khẩu
            document.querySelectorAll('.btn-eye').forEach(function (nut) {
                nut.addEventListener('click', function () {
                    var o = document.getElementById(nut.dataset.target);
                    var dangAn = o.type === 'password';
                    o.type = dangAn ? 'text' : 'password';
                    nut.textContent = dangAn ? '🙈' : '👁️';
                });
            });

            // Kiểm tra mật khẩu xác nhận có khớp không
            var matKhau = document.getElementById('oMatKhau');
            var xacNhan = document.getElementById('oXacNhan');
            var thongBao = document.getElementById('thongBaoKhop');

            function kiemTraKhop() {
                if (!xacNhan.value) {
                    thongBao.textContent = '';
                    xacNhan.setCustomValidity('');
                    return;
                }
                if (matKhau.value === xacNhan.value) {
                    thongBao.textContent = '✔ Mật khẩu khớp';
                    thongBao.className = 'match-msg match-ok';
                    xacNhan.setCustomValidity('');
                } else {
                    thongBao.textContent = '✖ Mật khẩu chưa khớp';
                    thongBao.className = 'match-msg match-no';
                    xacNhan.setCustomValidity('Mật khẩu xác nhận không khớp.');
                }
            }

            matKhau.addEventListener('input', kiemTraKhop);
            xacNhan.addEventListener('input', kiemTraKhop);
        })();
    </script>
</body>
</html>