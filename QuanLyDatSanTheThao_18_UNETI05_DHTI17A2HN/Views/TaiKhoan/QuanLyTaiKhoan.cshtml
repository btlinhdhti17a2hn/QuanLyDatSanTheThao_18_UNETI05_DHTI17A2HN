@*
// Họ và tên: Lê Bích Ngọc
// Mã sinh viên: 23103100111
// Nội dung thực hiện: Giao diện Quản lý danh sách Tài Khoản
*@

@model IEnumerable<QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.Entities.TaiKhoan>
@{
    ViewData["Title"] = "Quản lý Tài Khoản";

    int tongSo = Model.Count();
    int dangHoatDong = Model.Count(x => x.TrangThai);
    int biKhoa = tongSo - dangHoatDong;
    int soKhachHang = Model.Count(x => x.VaiTro != "Admin" && x.VaiTro != "NhanVien");
}

<style>
    .page-header {
        border-radius: 20px;
        padding: 1.8rem 2rem;
        color: #fff;
        background: linear-gradient(135deg, #14532d, #16a34a 60%, #65a30d);
        box-shadow: 0 12px 30px rgba(22, 163, 74, .3);
        position: relative;
        overflow: hidden;
    }
    .page-header::after {
        content: "👥";
        position: absolute;
        right: 25px;
        bottom: -25px;
        font-size: 7rem;
        opacity: .13;
    }
    .page-header h2 { font-weight: 800; margin: 0; }
    .page-header p { margin: .3rem 0 0; opacity: .85; }

    .stat-card {
        border: none;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 20px rgba(0, 0, 0, .07);
        padding: 1.1rem 1.3rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: transform .25s ease, box-shadow .25s ease;
    }
    .stat-card:hover { transform: translateY(-5px); box-shadow: 0 14px 30px rgba(0, 0, 0, .12); }
    .stat-icon {
        width: 54px; height: 54px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.6rem;
    }
    .stat-icon.s-total { background: #dbeafe; }
    .stat-icon.s-active { background: #dcfce7; }
    .stat-icon.s-lock { background: #f3f4f6; }
    .stat-icon.s-user { background: #fef3c7; }
    .stat-num { font-size: 1.7rem; font-weight: 800; line-height: 1; }
    .stat-label { color: #6b7280; font-size: .85rem; }

    .toolbar {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, .06);
        padding: 1rem 1.2rem;
    }
    .toolbar .form-control, .toolbar .form-select {
        border-radius: 50px;
        border: 1px solid #d1fae5;
        padding: .6rem 1.1rem;
    }
    .toolbar .form-control:focus, .toolbar .form-select:focus {
        border-color: #22c55e;
        box-shadow: 0 0 0 .2rem rgba(34, 197, 94, .2);
    }

    .table-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
        overflow: hidden;
    }
    .table-pretty { margin: 0; }
    .table-pretty thead th {
        background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        color: #166534;
        font-weight: 700;
        text-transform: uppercase;
        font-size: .78rem;
        letter-spacing: .6px;
        border: none;
        padding: 1rem .9rem;
    }
    .table-pretty tbody td { padding: .9rem; border-color: #f1f5f9; }
    .table-pretty tbody tr { transition: background .2s ease; }
    .table-pretty tbody tr:hover { background: #f0fdf4; }

    .id-badge {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 38px; height: 34px;
        border-radius: 10px;
        background: #f1f5f9;
        color: #475569;
        font-weight: 700;
    }
    .avatar {
        width: 44px; height: 44px;
        border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
        color: #fff;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(0, 0, 0, .15);
    }
    .av-admin { background: linear-gradient(135deg, #dc2626, #f87171); }
    .av-nv { background: linear-gradient(135deg, #2563eb, #60a5fa); }
    .av-kh { background: linear-gradient(135deg, #16a34a, #4ade80); }

    .username-tag {
        display: inline-block;
        padding: .3rem .75rem;
        border-radius: 8px;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        color: #475569;
        font-family: Consolas, monospace;
        font-size: .9rem;
    }

    .role-pill {
        display: inline-block;
        padding: .35rem .85rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: .82rem;
    }
    .role-admin { background: #fee2e2; color: #dc2626; }
    .role-nv { background: #dbeafe; color: #2563eb; }
    .role-kh { background: #f1f5f9; color: #475569; }

    .status-pill {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .35rem .85rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: .82rem;
    }
    .status-pill::before {
        content: "";
        width: 8px; height: 8px;
        border-radius: 50%;
        background: currentColor;
    }
    .status-on { background: #dcfce7; color: #15803d; }
    .status-off { background: #f3f4f6; color: #6b7280; }

    .btn-act {
        border: none;
        border-radius: 50px;
        padding: .35rem .85rem;
        font-weight: 700;
        font-size: .82rem;
        line-height: 1.5;
        white-space: nowrap;
        color: #fff;
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .btn-act:hover { transform: translateY(-2px); box-shadow: 0 6px 14px rgba(0, 0, 0, .2); color: #fff; }
    .btn-lock { background: linear-gradient(135deg, #dc2626, #ef4444); }
    .btn-unlock { background: linear-gradient(135deg, #16a34a, #22c55e); }

    .default-tag {
        display: inline-block;
        padding: .35rem .9rem;
        border-radius: 50px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: .82rem;
        font-style: italic;
    }

    .empty-box { text-align: center; padding: 3rem 1rem; color: #6b7280; display: none; }
    .empty-box .emoji { font-size: 3.5rem; }
</style>

<div class="container mt-4 mb-5">

    <!-- TIÊU ĐỀ TRANG -->
    <div class="page-header mb-4">
        <h2>👥 QUẢN LÝ TÀI KHOẢN</h2>
        <p>Theo dõi người dùng, vai trò và khóa / mở khóa tài khoản</p>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 alert-dismissible fade show" role="alert">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 alert-dismissible fade show" role="alert">
            ❌ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- THỐNG KÊ NHANH -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon s-total">📋</div>
                <div>
                    <div class="stat-num text-primary">@tongSo</div>
                    <div class="stat-label">Tổng tài khoản</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon s-active">✅</div>
                <div>
                    <div class="stat-num text-success">@dangHoatDong</div>
                    <div class="stat-label">Đang hoạt động</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon s-lock">🔒</div>
                <div>
                    <div class="stat-num text-secondary">@biKhoa</div>
                    <div class="stat-label">Đang khóa</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon s-user">🙋</div>
                <div>
                    <div class="stat-num" style="color:#d97706;">@soKhachHang</div>
                    <div class="stat-label">Khách hàng</div>
                </div>
            </div>
        </div>
    </div>

    <!-- TÌM KIẾM & LỌC -->
    <div class="toolbar mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-md-7">
                <input type="text" id="oTimKiem" class="form-control" placeholder="🔍 Tìm theo họ tên hoặc tên đăng nhập..." />
            </div>
            <div class="col-md-3">
                <select id="locVaiTro" class="form-select">
                    <option value="">Tất cả vai trò</option>
                    <option value="Admin">Admin</option>
                    <option value="NhanVien">Nhân viên</option>
                    <option value="KhachHang">Khách hàng</option>
                </select>
            </div>
            <div class="col-md-2 text-md-end text-muted small">
                Hiển thị <strong id="soHienThi">@tongSo</strong> / @tongSo
            </div>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH -->
    <div class="card table-card">
        <div class="table-responsive">
            <table class="table table-pretty align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Họ tên</th>
                        <th>Tên đăng nhập</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="text-center pe-4">Hành động</th>
                    </tr>
                </thead>
                <tbody id="bangTaiKhoan">
                    @foreach (var item in Model)
                    {
                        string chuCai = string.IsNullOrWhiteSpace(item.HoTen) ? "?" : item.HoTen.Trim().Substring(0, 1).ToUpper();
                        string nhomVaiTro = item.VaiTro == "Admin" ? "Admin" : (item.VaiTro == "NhanVien" ? "NhanVien" : "KhachHang");
                        string lopAvatar = item.VaiTro == "Admin" ? "av-admin" : (item.VaiTro == "NhanVien" ? "av-nv" : "av-kh");
                        string duLieuTim = ((item.HoTen ?? "") + " " + (item.TenDangNhap ?? "")).ToLower();

                        <tr data-vaitro="@nhomVaiTro" data-tim="@duLieuTim">
                            <td class="ps-4"><span class="id-badge">@item.MaTaiKhoan</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="avatar @lopAvatar">@chuCai</span>
                                    <span class="fw-bold">@item.HoTen</span>
                                </div>
                            </td>
                            <td><span class="username-tag">@item.TenDangNhap</span></td>
                            <td>
                                @if (item.VaiTro == "Admin")
                                {
                                    <span class="role-pill role-admin">👑 Admin</span>
                                }
                                else if (item.VaiTro == "NhanVien")
                                {
                                    <span class="role-pill role-nv">🧑‍💼 Nhân viên</span>
                                }
                                else
                                {
                                    <span class="role-pill role-kh">🙋 Khách hàng</span>
                                }
                            </td>
                            <td>
                                @if (item.TrangThai)
                                {
                                    <span class="status-pill status-on">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-pill status-off">Khóa</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                @if (item.VaiTro != "Admin")
                                {
                                    <form asp-action="ThayDoiTrangThai" asp-route-id="@item.MaTaiKhoan" method="post" class="d-inline"
                                          data-dang-hoat-dong="@item.TrangThai.ToString().ToLower()"
                                          onsubmit="return xacNhanKhoa(this);">
                                        <button type="submit" class="btn btn-act @(item.TrangThai ? "btn-lock" : "btn-unlock")">
                                            @(item.TrangThai ? "🔒 Khóa tài khoản" : "🔓 Mở khóa")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="default-tag">Mặc định</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="empty-box" id="khongCoKetQua">
            <div class="emoji">🔎</div>
            <h5 class="mt-2 fw-bold">Không tìm thấy tài khoản phù hợp</h5>
            <p class="mb-0">Thử đổi từ khóa hoặc bộ lọc vai trò.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hỏi xác nhận khi khóa tài khoản (mở khóa thì không hỏi)
        function xacNhanKhoa(form) {
            if (form.dataset.dangHoatDong === 'true') {
                return confirm('Bạn có chắc chắn muốn khóa tài khoản này không?');
            }
            return true;
        }

        (function () {
            const oTimKiem = document.getElementById('oTimKiem');
            const locVaiTro = document.getElementById('locVaiTro');
            const soHienThi = document.getElementById('soHienThi');
            const khongCoKetQua = document.getElementById('khongCoKetQua');
            const hang = document.querySelectorAll('#bangTaiKhoan tr');

            function locDanhSach() {
                const tuKhoa = oTimKiem.value.trim().toLowerCase();
                const vaiTro = locVaiTro.value;
                let dem = 0;

                hang.forEach(function (tr) {
                    const khop = (!tuKhoa || tr.dataset.tim.includes(tuKhoa))
                              && (!vaiTro || tr.dataset.vaitro === vaiTro);
                    tr.style.display = khop ? '' : 'none';
                    if (khop) dem++;
                });

                soHienThi.textContent = dem;
                khongCoKetQua.style.display = dem === 0 ? 'block' : 'none';
            }

            oTimKiem.addEventListener('input', locDanhSach);
            locVaiTro.addEventListener('change', locDanhSach);
        })();
    </script>
}