@*
// Nội dung thực hiện: Giao diện thanh toán đơn đặt sân bằng mã QR.
//                     Khách quét mã chuyển khoản; nhân viên tự kiểm tra giao dịch ngân hàng rồi bấm xác nhận thủ công.
//                     Có xác nhận này thì ở trang chi tiết đơn nút "Hoàn thành" mới được mở.
*@

@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.ViewModels.ThanhToanTiepNhanViewModel

@{
    var don = Model.DonDat;
    ViewData["Title"] = $"Thanh toán đơn #{don.MaDatSan}";
    string nguonDuTien = Model.TienGiamDiem > 0 ? "Tiền cọc và điểm tích lũy" : "Tiền cọc";
}

<style>
    .pay-card {
        max-width: 560px;
        margin: 0 auto;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(22, 163, 74, 0.12);
        border: 2px solid #dcfce7;
        overflow: hidden;
    }

    .pay-header {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        color: #fff;
        padding: 24px;
        text-align: center;
        border-bottom-left-radius: 24px;
        border-bottom-right-radius: 24px;
    }

    .pay-amount {
        font-size: 2.1rem;
        font-weight: 800;
        color: #fef08a;
    }

    .pay-qr-frame {
        background: #fff;
        padding: 14px;
        border-radius: 20px;
        border: 2px dashed #4ade80;
        display: inline-block;
        box-shadow: 0 8px 20px rgba(0,0,0,.05);
    }

    .copy-btn {
        cursor: pointer;
        transition: all .2s;
    }

        .copy-btn:hover {
            background-color: #dcfce7 !important;
            border-color: #16a34a !important;
            color: #15803d !important;
        }

    .btn-xanh {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        border: none;
        color: #fff;
    }

        .btn-xanh:hover {
            color: #fff;
            filter: brightness(.95);
        }
</style>

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3" style="max-width: 560px; margin: 0 auto;">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-success">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-success">Tiếp nhận đặt sân</a></li>
            <li class="breadcrumb-item"><a asp-action="ChiTiet" asp-route-id="@don.MaDatSan" class="text-decoration-none text-success">Đơn #@don.MaDatSan</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
        </ol>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert" style="max-width: 560px; margin: 0 auto 1rem;">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert" style="max-width: 560px; margin: 0 auto 1rem;">
            ⚠️ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="pay-card">
        <div class="pay-header">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-25 mb-2 small fw-bold">
                <span>💳 Thanh toán bằng mã QR</span>
            </div>
            <h4 class="fw-bold mb-1">Đơn đặt sân #@don.MaDatSan</h4>
            <div class="small opacity-75">
                👤 @don.KhachHang.HoTen &bull; 🏟️ @don.SanTheThao.TenSan<br />
                ⏰ @don.GioBatDau.ToString("HH:mm") - @don.GioKetThuc.ToString("HH:mm") (@don.GioBatDau.ToString("dd/MM/yyyy"))
            </div>
            <div class="mt-3">
                <small class="d-block opacity-75">Khách cần thanh toán:</small>
                <div class="pay-amount">@Model.SoTienCanThu.ToString("N0") VNĐ</div>
            </div>
        </div>

        <div class="p-4">
            <!-- Bảng kê chi phí -->
            <div class="bg-light rounded-3 p-3 border small mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Tiền thuê sân (@Model.SoGio.ToString("0.#")h)</span>
                    <span>@Model.TienSan.ToString("N0") VNĐ</span>
                </div>
                @if (Model.TienDichVu > 0)
                {
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Dịch vụ đi kèm</span>
                        <span>@Model.TienDichVu.ToString("N0") VNĐ</span>
                    </div>
                }
                <div class="d-flex justify-content-between mb-1 border-top pt-1">
                    <span class="fw-semibold">Tổng cộng</span>
                    <span class="fw-semibold">@Model.TongTien.ToString("N0") VNĐ</span>
                </div>
                @if (Model.TienGiamDiem > 0)
                {
                    <div class="d-flex justify-content-between mb-1 text-success">
                        <span>Giảm từ điểm (@Model.DiemSuDung.ToString("N0") điểm)</span>
                        <span>- @Model.TienGiamDiem.ToString("N0") VNĐ</span>
                    </div>
                }
                <div class="d-flex justify-content-between mb-1 text-danger">
                    <span>Đã đặt cọc</span>
                    <span>- @don.TienCoc.ToString("N0") VNĐ</span>
                </div>
                <div class="d-flex justify-content-between border-top border-2 pt-2 mt-1">
                    <strong class="text-success">Còn phải thanh toán</strong>
                    <strong class="text-success fs-6">@Model.SoTienCanThu.ToString("N0") VNĐ</strong>
                </div>
            </div>

            @if (Model.SoTienCanThu <= 0)
            {
                <div class="alert alert-success text-center rounded-3">
                    🎉 @nguonDuTien đã đủ chi trả toàn bộ đơn,
                    <strong>không cần thu thêm tiền</strong>.
                </div>
            }
            else
            {
                <div class="text-center">
                    <div class="badge rounded-pill px-3 py-1 mb-2 text-dark" style="background-color: #dcfce7;">
                        Khách quét bằng App Ngân hàng hoặc Ví MoMo, ZaloPay
                    </div>

                    <div class="pay-qr-frame my-2">
                        <img src="@Model.VietQrUrl" alt="Mã QR thanh toán đơn #@don.MaDatSan"
                             class="img-fluid rounded-3" style="max-width: 250px; width: 100%; height: auto;" />
                        <div class="mt-2 text-muted" style="font-size: 0.85rem;">
                            Quét mã để tự động điền STK, số tiền <strong>@Model.SoTienCanThu.ToString("N0")đ</strong> và nội dung
                        </div>
                    </div>
                </div>

                <div class="bg-light rounded-3 p-3 text-start border mt-3 small">
                    <div class="mb-2 pb-2 border-bottom">
                        <span class="text-muted d-block">Ngân hàng:</span>
                        <strong class="text-dark">@Model.NganHang</strong>
                    </div>
                    <div class="mb-2 pb-2 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted d-block">Số tài khoản:</span>
                            <strong class="text-primary fs-6 font-monospace">@Model.SoTaiKhoan</strong>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary copy-btn rounded-pill px-2 py-1" data-copy="@Model.SoTaiKhoan">Chép STK</button>
                    </div>
                    <div class="mb-2 pb-2 border-bottom">
                        <span class="text-muted d-block">Chủ tài khoản:</span>
                        <strong class="text-dark">@Model.ChuTaiKhoan</strong>
                    </div>
                    <div class="mb-2 pb-2 border-bottom d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted d-block">Số tiền:</span>
                            <strong class="text-success font-monospace fs-6">@Model.SoTienCanThu.ToString("N0") VNĐ</strong>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-success copy-btn rounded-pill px-2 py-1" data-copy="@((long)Model.SoTienCanThu)">Chép số tiền</button>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted d-block">Nội dung chuyển khoản:</span>
                            <strong class="text-danger font-monospace fs-6">@Model.NoiDungChuyenKhoan</strong>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger copy-btn rounded-pill px-2 py-1" data-copy="@Model.NoiDungChuyenKhoan">Chép ND</button>
                    </div>
                </div>
            }

            <!-- NHÂN VIÊN XÁC NHẬN THỦ CÔNG -->
            <form asp-action="XacNhanThanhToan" asp-route-id="@don.MaDatSan" method="post" class="mt-4" id="formXacNhanThanhToan">
                <input type="hidden" name="diemSuDung" value="@Model.DiemSuDung" />

                <div class="border rounded-3 p-3" style="background:#fffbeb; border-color:#fde68a !important;">
                    <h6 class="fw-bold text-uppercase small mb-2" style="color:#b45309;">🧾 Nhân viên xác nhận thủ công</h6>

                    @if (Model.SoTienCanThu > 0)
                    {
                        <div class="small text-muted mb-3">
                            Mở <strong>app / sao kê ngân hàng</strong> của quầy và kiểm tra tiền đã vào tài khoản:
                            đúng số tiền <strong>@Model.SoTienCanThu.ToString("N0") VNĐ</strong> và nội dung
                            <strong class="font-monospace">@Model.NoiDungChuyenKhoan</strong>.
                            Chỉ bấm xác nhận khi đã thấy giao dịch.
                        </div>

                        <div class="mb-3">
                            <label for="maGiaoDich" class="form-label fw-semibold small mb-1">Mã giao dịch ngân hàng <span class="text-danger">*</span></label>
                            <input type="text" id="maGiaoDich" name="maGiaoDich" class="form-control font-monospace"
                                   maxlength="100" required autocomplete="off" placeholder="VD: FT26311xxxxxxxx" />
                            <div class="form-text">Đọc trong chi tiết giao dịch (dùng để đối soát sau này, mỗi mã chỉ dùng cho 1 đơn).</div>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="daKiemTra" id="daKiemTra" value="true" required />
                            <label class="form-check-label small" for="daKiemTra">
                                Tôi đã kiểm tra giao dịch ngân hàng và <strong>đã nhận đủ @Model.SoTienCanThu.ToString("N0") VNĐ</strong>.
                            </label>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mb-3">Đơn này không cần thu thêm tiền. Bấm xác nhận để ghi nhận và mở nút "Hoàn thành".</div>
                    }

                    <button type="submit" class="btn btn-xanh rounded-pill px-4 fw-semibold shadow-sm w-100">
                        ✅ @(Model.SoTienCanThu > 0 ? "Xác nhận đã nhận tiền" : "Xác nhận")
                    </button>
                </div>
            </form>

            <div class="mt-3 d-flex flex-column gap-2">
                <a asp-action="ChiTiet" asp-route-id="@don.MaDatSan" class="btn btn-outline-secondary rounded-pill">&laquo; Quay lại chi tiết đơn (chưa thanh toán)</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.copy-btn[data-copy]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                navigator.clipboard.writeText(btn.dataset.copy).then(function () {
                    const old = btn.innerHTML;
                    btn.innerHTML = '✔ Đã chép!';
                    setTimeout(function () { btn.innerHTML = old; }, 1500);
                });
            });
        });

        // Chống bấm xác nhận 2 lần liên tiếp
        (function () {
            const form = document.getElementById('formXacNhanThanhToan');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) return;
                if (!confirm('Xác nhận ĐÃ NHẬN TIỀN cho đơn #@(don.MaDatSan)? Sau khi xác nhận sẽ không sửa được dịch vụ của đơn.')) {
                    e.preventDefault();
                    return;
                }
                const btn = form.querySelector('button[type=submit]');
                setTimeout(function () { btn.disabled = true; }, 0);
            });
        })();
    </script>
}
