@*
// Họ và tên: Vũ Ánh Ngọc
// Mã sinh viên: 23103100106
// Nội dung thực hiện: Module 4 - Giao diện Danh sách đặt sân cần xử lý (tìm kiếm, lọc, sắp xếp, phân trang, thao tác theo trạng thái)
*@

@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.ViewModels.TiepNhanDatSanListViewModel

@{
    ViewData["Title"] = "Tiếp nhận đặt sân";

    // Đường dẫn hiện tại (kèm toàn bộ điều kiện lọc) để quay lại đúng trang sau khi xử lý
    var quayLaiUrl = Context.Request.Path.Value + Context.Request.QueryString.Value;

    // Tạo dữ liệu route cho liên kết phân trang: GIỮ NGUYÊN mọi điều kiện tìm kiếm, lọc, sắp xếp
    Dictionary<string, string?> RouteTrang(int trang) => new()
    {
        ["tenKhach"] = Model.TenKhach,
        ["tenSan"] = Model.TenSan,
        ["maLoaiSan"] = Model.MaLoaiSan?.ToString(),
        ["trangThai"] = Model.TrangThai,
        ["tuNgay"] = Model.TuNgay?.ToString("yyyy-MM-dd"),
        ["denNgay"] = Model.DenNgay?.ToString("yyyy-MM-dd"),
        ["sapXep"] = Model.SapXep,
        ["trang"] = trang.ToString()
    };

    // Kiểu hiển thị (màu + biểu tượng) cho từng trạng thái - giống trang chi tiết của khách hàng
    (string Css, string Icon) KieuTrangThai(string tt) => tt switch
    {
        "Chờ xử lý" => ("bg-warning text-dark", "⏳"),
        "Đang xử lý" => ("bg-info text-dark", "⚙️"),
        "Hoàn thành" => ("bg-success", "✅"),
        "Đã hủy" => ("bg-danger", "❌"),
        _ => ("bg-secondary", "•")
    };

    // Cửa sổ số trang hiển thị: trang hiện tại +- 2
    int tuTrang = Math.Max(1, Model.TrangHienTai - 2);
    int denTrang = Math.Min(Model.TongSoTrang, Model.TrangHienTai + 2);
    var homNay = DateTime.Now;
}

<style>
    .tn-stat {
        display: block;
        text-decoration: none;
        border-radius: 1rem;
        padding: 1rem 1.25rem;
        background: #fff;
        border: 2px solid transparent;
        box-shadow: 0 2px 10px rgba(0, 0, 0, .06);
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .tn-stat:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(22, 163, 74, .18); }
    .tn-stat.active { border-color: #22c55e; background: #f0fdf4; }
    .tn-stat .so { font-size: 1.8rem; font-weight: 800; line-height: 1.1; }
    .tn-stat .nhan { color: #6b7280; font-size: .85rem; font-weight: 600; }
    .btn-xanh {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        border: none;
        color: #fff;
    }
    .btn-xanh:hover { color: #fff; filter: brightness(.95); }

    /* Bảng xanh lá dùng chung với các trang quản lý khác của hệ thống */
    .table-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
        overflow: hidden;
        background: #fff;
    }
    .table-pretty { margin: 0; }
    .table-pretty thead th {
        background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        color: #166534;
        font-weight: 700;
        text-transform: uppercase;
        font-size: .78rem;
        letter-spacing: .6px;
        border: none;
        padding: 1rem .9rem;
        white-space: nowrap;
    }
    .table-pretty tbody td { padding: .9rem; border-color: #f1f5f9; }
    .table-pretty tbody tr { transition: background .2s ease; }
    .table-pretty tbody tr:hover { background: #f0fdf4; }
</style>

<div class="container-fluid py-4">
    <!-- Tiêu đề -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1">📋 Tiếp nhận &amp; xử lý đặt sân</h3>
            <p class="text-muted small mb-0">Xem đơn đặt sân của khách, kiểm tra điều kiện, xác nhận, hoàn thành hoặc hủy theo đúng luồng trạng thái</p>
        </div>
        <span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill">
            Kết quả: <strong>@Model.TongSoBanGhi</strong> đơn
        </span>
    </div>

    <!-- Thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
            ⚠️ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.CanhBaoLoc))
    {
        <div class="alert alert-warning shadow-sm rounded-3">ℹ️ @Model.CanhBaoLoc</div>
    }

    <!-- Thẻ thống kê nhanh theo trạng thái (bấm để lọc) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <a asp-action="Index" asp-route-trangThai="Chờ xử lý" class="tn-stat @(Model.TrangThai == "Chờ xử lý" ? "active" : "")">
                <div class="so text-warning">@Model.SoChoXuLy</div>
                <div class="nhan">⏳ Chờ xử lý</div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-action="Index" asp-route-trangThai="Đang xử lý" class="tn-stat @(Model.TrangThai == "Đang xử lý" ? "active" : "")">
                <div class="so text-info">@Model.SoDangXuLy</div>
                <div class="nhan">⚙️ Đang xử lý</div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-action="Index" asp-route-trangThai="Hoàn thành" class="tn-stat @(Model.TrangThai == "Hoàn thành" ? "active" : "")">
                <div class="so text-success">@Model.SoHoanThanh</div>
                <div class="nhan">✅ Hoàn thành</div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-action="Index" asp-route-trangThai="Đã hủy" class="tn-stat @(Model.TrangThai == "Đã hủy" ? "active" : "")">
                <div class="so text-danger">@Model.SoDaHuy</div>
                <div class="nhan">❌ Đã hủy</div>
            </a>
        </div>
    </div>

    <!-- Khung tìm kiếm - lọc - sắp xếp -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form asp-controller="TiepNhanDatSan" asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-secondary small">Khách hàng</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">👤</span>
                        <input type="text" name="tenKhach" value="@Model.TenKhach" class="form-control border-start-0" placeholder="Họ tên hoặc số điện thoại..." />
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-secondary small">Sân thể thao</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">🏟️</span>
                        <input type="text" name="tenSan" value="@Model.TenSan" class="form-control border-start-0" placeholder="Tên sân..." />
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-secondary small">Loại sân</label>
                    <select name="maLoaiSan" class="form-select">
                        <option value="">-- Tất cả loại sân --</option>
                        @foreach (var loai in Model.DanhSachLoaiSan)
                        {
                            <option value="@loai.MaLoaiSan" selected="@(Model.MaLoaiSan == loai.MaLoaiSan)">@loai.TenLoai</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-secondary small">Trạng thái</label>
                    <select name="trangThai" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Chờ xử lý" selected="@(Model.TrangThai == "Chờ xử lý")">Chờ xử lý</option>
                        <option value="Đang xử lý" selected="@(Model.TrangThai == "Đang xử lý")">Đang xử lý</option>
                        <option value="Hoàn thành" selected="@(Model.TrangThai == "Hoàn thành")">Hoàn thành</option>
                        <option value="Đã hủy" selected="@(Model.TrangThai == "Đã hủy")">Đã hủy</option>
                    </select>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-secondary small">Ngày sử dụng từ</label>
                    <input type="date" name="tuNgay" value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-secondary small">Đến ngày</label>
                    <input type="date" name="denNgay" value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label fw-semibold text-secondary small">Sắp xếp theo</label>
                    <select name="sapXep" class="form-select">
                        <option value="ngaydat_moi" selected="@(Model.SapXep == "ngaydat_moi")">Ngày tạo đơn: mới nhất</option>
                        <option value="ngaydat_cu" selected="@(Model.SapXep == "ngaydat_cu")">Ngày tạo đơn: cũ nhất</option>
                        <option value="ngaysd_moi" selected="@(Model.SapXep == "ngaysd_moi")">Ngày sử dụng: mới → cũ</option>
                        <option value="ngaysd_cu" selected="@(Model.SapXep == "ngaysd_cu")">Ngày sử dụng: cũ → mới</option>
                        <option value="khach_az" selected="@(Model.SapXep == "khach_az")">Tên khách: A → Z</option>
                        <option value="khach_za" selected="@(Model.SapXep == "khach_za")">Tên khách: Z → A</option>
                        <option value="san_az" selected="@(Model.SapXep == "san_az")">Tên sân: A → Z</option>
                        <option value="san_za" selected="@(Model.SapXep == "san_za")">Tên sân: Z → A</option>
                    </select>
                </div>

                <div class="col-md-6 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn btn-xanh fw-semibold px-4 rounded-pill flex-grow-1">🔍 Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3" title="Xóa bộ lọc">Làm mới</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách đơn đặt sân -->
    <div class="card table-card">
        <div class="table-responsive">
            <table class="table table-pretty align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Sân thể thao</th>
                        <th>Thời gian sử dụng</th>
                        <th class="text-end">Tiền cọc</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSach.Any())
                    {
                        foreach (var d in Model.DanhSach)
                        {
                            var kieu = KieuTrangThai(d.TrangThai);
                            bool choPhepHuy = d.TrangThai == "Chờ xử lý" || d.TrangThai == "Đang xử lý";
                            bool choPhepHoanThanh = d.TrangThai == "Đang xử lý" && d.GioBatDau <= homNay;

                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@d.MaDatSan</td>
                                <td>
                                    <div class="fw-semibold text-dark">@d.KhachHang.HoTen</div>
                                    <small class="text-muted">📞 @d.KhachHang.SoDienThoai</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@d.SanTheThao.TenSan</div>
                                    <small class="text-muted">@d.SanTheThao.LoaiSan.TenLoai</small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@d.GioBatDau.ToString("dd/MM/yyyy")</div>
                                    <small class="text-primary fw-semibold">@d.GioBatDau.ToString("HH:mm") - @d.GioKetThuc.ToString("HH:mm")</small>
                                </td>
                                <td class="text-end fw-semibold">@d.TienCoc.ToString("N0") VNĐ</td>
                                <td><small class="text-muted">@d.NgayDat.ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td class="text-center">
                                    <span class="badge @kieu.Css px-3 py-2 rounded-pill">@kieu.Icon @d.TrangThai</span>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-inline-flex flex-wrap justify-content-center gap-1">
                                        <a asp-action="ChiTiet" asp-route-id="@d.MaDatSan" class="btn btn-sm btn-outline-primary rounded-pill px-3">Chi tiết</a>

                                        @if (d.TrangThai == "Chờ xử lý")
                                        {
                                            <form asp-action="XacNhan" asp-route-id="@d.MaDatSan" method="post" class="d-inline"
                                                  onsubmit="return confirm('Xác nhận đơn đặt sân #@(d.MaDatSan)?');">
                                                <input type="hidden" name="quayLai" value="@quayLaiUrl" />
                                                <button type="submit" class="btn btn-sm btn-xanh rounded-pill px-3">Xác nhận</button>
                                            </form>
                                        }

                                        @if (choPhepHoanThanh)
                                        {
                                            <form asp-action="HoanThanhDon" asp-route-id="@d.MaDatSan" method="post" class="d-inline"
                                                  onsubmit="return confirm('Hoàn thành đơn đặt sân #@(d.MaDatSan)?');">
                                                <input type="hidden" name="quayLai" value="@quayLaiUrl" />
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">Hoàn thành</button>
                                            </form>
                                        }

                                        @if (choPhepHuy)
                                        {
                                            <form asp-action="HuyDon" asp-route-id="@d.MaDatSan" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn đặt sân #@(d.MaDatSan) không?');">
                                                <input type="hidden" name="quayLai" value="@quayLaiUrl" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Hủy</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <div class="fs-1 mb-2">🔍</div>
                                <p class="mb-0 fw-semibold">Không tìm thấy đơn đặt sân nào phù hợp với điều kiện tìm kiếm!</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang: có Trước / Sau, số trang, trang hiện tại; giữ nguyên điều kiện khi chuyển trang -->
        @if (Model.TongSoTrang > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <small class="text-muted">
                    Trang <strong>@Model.TrangHienTai</strong> / <strong>@Model.TongSoTrang</strong>
                    &middot; Tổng <strong>@Model.TongSoBanGhi</strong> đơn
                </small>

                <nav aria-label="Phân trang">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.TrangHienTai <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="RouteTrang(Model.TrangHienTai - 1)">&laquo; Trước</a>
                        </li>

                        @if (tuTrang > 1)
                        {
                            <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="RouteTrang(1)">1</a></li>
                            if (tuTrang > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                        }

                        @for (int i = tuTrang; i <= denTrang; i++)
                        {
                            <li class="page-item @(i == Model.TrangHienTai ? "active" : "")">
                                <a class="page-link @(i == Model.TrangHienTai ? "bg-success border-success" : "")" asp-action="Index" asp-all-route-data="RouteTrang(i)">@i</a>
                            </li>
                        }

                        @if (denTrang < Model.TongSoTrang)
                        {
                            if (denTrang < Model.TongSoTrang - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                            <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="RouteTrang(Model.TongSoTrang)">@Model.TongSoTrang</a></li>
                        }

                        <li class="page-item @(Model.TrangHienTai >= Model.TongSoTrang ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-all-route-data="RouteTrang(Model.TrangHienTai + 1)">Sau &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>