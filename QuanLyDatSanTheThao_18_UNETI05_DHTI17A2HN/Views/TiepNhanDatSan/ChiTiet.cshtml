@*
// Họ và tên: Vũ Ánh Ngọc
// Mã sinh viên: 23103100106
// Nội dung thực hiện: Module 4 - Giao diện Chi tiết và Xử lý đơn đặt sân (kiểm tra điều kiện, luồng trạng thái tách riêng đặt sân & thanh toán cọc)
*@

@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.ViewModels.TiepNhanDatSanChiTietViewModel

@{
    var don = Model.DonDat;
    ViewData["Title"] = "Xử lý đơn đặt sân #" + don.MaDatSan;

    (string Css, string Icon) KieuTrangThai(string tt) => tt switch
    {
        "Chờ duyệt" or "Chờ xử lý" => ("bg-warning text-dark", "⏳"),
        "Đã duyệt" or "Đang xử lý" => ("bg-info text-dark", "⚙️"),
        "Hoàn thành" => ("bg-success", "✅"),
        "Từ chối" or "Đã hủy" => ("bg-danger", "❌"),
        _ => ("bg-secondary", "•")
    };
    var kieu = KieuTrangThai(don.TrangThai);

    int buoc = don.TrangThai switch
    {
        "Chờ duyệt" or "Chờ xử lý" => 0,
        "Đã duyệt" or "Đang xử lý" => 1,
        "Hoàn thành" => 2,
        _ => -1
    };
    string[] tenBuoc = { "Chờ duyệt", "Đã duyệt", "Hoàn thành" };
    string[] iconBuoc = { "⏳", "⚙️", "✅" };

    bool dangSuDung = (don.TrangThai == "Đang xử lý" || don.TrangThai == "Đã duyệt") && don.GioBatDau <= DateTime.Now;

    string cauHoiHuy = dangSuDung
        ? $"Sân hiện đang được sử dụng. Bạn vẫn muốn hủy / từ chối đơn đặt sân #{don.MaDatSan}?"
        : $"Bạn có chắc chắn muốn từ chối / hủy đơn đặt sân #{don.MaDatSan} không?";

    var thanhToan = Model.ThanhToan;
    var ttThanhToan = thanhToan?.TrangThai ?? "Chưa thanh toán";

    var dvTrongDon = don.ChiTietDatSans
        .GroupBy(ct => ct.MaDichVu)
        .ToDictionary(g => g.Key, g => g.First());

    string LayIcon(string? ten)
    {
        var t = (ten ?? "").ToLower();
        if (t.Contains("cầu lông") || t.Contains("vợt")) return "🏸";
        if (t.Contains("tennis")) return "🎾";
        if (t.Contains("bóng rổ")) return "🏀";
        if (t.Contains("bóng")) return "⚽";
        if (t.Contains("áo") || t.Contains("bib")) return "👕";
        if (t.Contains("tăng lực") || t.Contains("redbull")) return "⚡";
        if (t.Contains("nước")) return "🥤";
        if (t.Contains("giày") || t.Contains("giầy")) return "👟";
        if (t.Contains("khăn")) return "🧣";
        return "🏷️";
    }

    var gioMoCua = don.SanTheThao.GioMoCua.ToString(@"hh\:mm");
    var gioDongCua = don.SanTheThao.GioDongCua.ToString(@"hh\:mm");
}

<style>
    .tn-flow {
        display: flex;
        align-items: center;
        gap: .75rem;
        flex-wrap: wrap;
    }
    .tn-step {
        padding: .5rem 1.1rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: .88rem;
        background: #f1f5f9;
        color: #64748b;
        border: 2px solid transparent;
        transition: all .2s ease;
    }
    .tn-step.current {
        background: #ecfdf5;
        color: #166534;
        border-color: #22c55e;
        box-shadow: 0 4px 12px rgba(34, 197, 94, .25);
    }
    .tn-step.done { background: #dcfce7; color: #15803d; }
    .tn-step.cancel { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
    .tn-arrow { color: #94a3b8; font-weight: 700; font-size: 1.1rem; }

    .btn-xanh {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        border: none;
        color: #fff;
    }
    .btn-xanh:hover { color: #fff; filter: brightness(.95); }

    .btn-vang {
        background: linear-gradient(135deg, #f59e0b, #fbbf24);
        border: none;
        color: #78350f;
    }
    .btn-vang:hover { color: #78350f; filter: brightness(.95); }

    .table-pretty { margin: 0; }
    .table-pretty thead th {
        background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        color: #166534;
        font-weight: 700;
        text-transform: uppercase;
        font-size: .78rem;
        border: none;
        padding: 1rem .9rem;
        white-space: nowrap;
    }
    .table-pretty tbody td { padding: .9rem; border-color: #f1f5f9; }
    .table-pretty tbody tr { transition: background .2s ease; }
    .table-pretty tbody tr:hover { background: #f0fdf4; }

    .dv-ico {
        width: 42px;
        height: 42px;
        flex: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        line-height: 1;
    }
    .dv-qty { width: 140px; }
    .dv-qty .form-control {
        text-align: center;
        font-weight: 700;
        color: #14532d;
        border-color: #bbf7d0;
        box-shadow: none;
    }
    .dv-qty .form-control:focus { border-color: #22c55e; box-shadow: 0 0 0 .2rem rgba(34, 197, 94, .2); }
    .btn-dv {
        background: #fff;
        color: #16a34a;
        border: 1px solid #bbf7d0;
        font-weight: 800;
        line-height: 1;
    }
    .btn-dv:hover { background: #dcfce7; color: #14532d; border-color: #86efac; }
    .dv-row.dv-chon { background: #f0fdf4; }
    .dv-row.dv-chon .dv-thanhtien { color: #14532d; }
</style>

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-success">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-success">Tiếp nhận đặt sân</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đơn #@don.MaDatSan</li>
        </ol>
    </nav>

    <!-- Thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
            ✅ @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4" role="alert">
            ⚠️ @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <!-- Đầu phiếu: hiển thị rõ cả 2 trạng thái -->
        <div class="card-header bg-white border-bottom p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <span class="badge bg-success-subtle text-success fs-6 px-3 py-1 rounded-pill mb-2">Quy trình duyệt 2 bước</span>
                    <h3 class="fw-bold text-dark mb-0">Xử lý đơn đặt sân: #@don.MaDatSan</h3>
                    <small class="text-muted">Thời điểm tạo đơn: @don.NgayDat.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
                <div class="text-end">
                    <div class="mb-2">
                        <span class="small text-muted d-block">Trạng thái đặt sân:</span>
                        <span class="badge @kieu.Css fs-6 px-3 py-2 rounded-pill">@kieu.Icon @don.TrangThai</span>
                    </div>
                    <div>
                        <span class="small text-muted d-block">Trạng thái thanh toán:</span>
                        @switch (ttThanhToan)
                        {
                            case "Đã thanh toán":
                                <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-1 rounded-pill fw-bold">
                                    ✅ Đã thanh toán cọc
                                </span>
                                break;
                            case "Chờ xác nhận":
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-6 px-3 py-1 rounded-pill fw-bold">
                                    ⏳ Khách đã báo thanh toán (Chờ xác nhận)
                                </span>
                                break;
                            default:
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fs-6 px-3 py-1 rounded-pill">
                                    ⚪ Khách chưa thanh toán
                                </span>
                                break;
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <!-- Luồng trạng thái đặt sân -->
            <div class="mb-4 pb-4 border-bottom">
                <h6 class="fw-bold text-success text-uppercase small mb-3">🔄 Luồng xử lý đơn đặt sân</h6>
                <div class="tn-flow">
                    @for (int i = 0; i < tenBuoc.Length; i++)
                    {
                        string css = buoc == -1 ? "" : (i < buoc ? "done" : (i == buoc ? "current" : ""));
                        <span class="tn-step @css">@iconBuoc[i] @tenBuoc[i]</span>
                        if (i < tenBuoc.Length - 1)
                        {
                            <span class="tn-arrow">→</span>
                        }
                    }
                    @if (buoc == -1)
                    {
                        <span class="tn-arrow">|</span>
                        <span class="tn-step cancel">❌ Từ chối / Đã hủy</span>
                    }
                </div>
            </div>

            <!-- KHỐI QUẢN LÝ THANH TOÁN TIỀN CỌC MÔ PHỎNG (MỚI) -->
            <div class="mb-4 pb-4 border-bottom">
                <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4" style="background: linear-gradient(145deg, #f0fdf4, #ffffff); border: 2px solid #bbf7d0 !important;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <h5 class="fw-bold text-success mb-1">💳 Quản lý thanh toán tiền cọc</h5>
                            <small class="text-muted">Kiểm tra thông tin chuyển khoản từ khách hàng trước khi duyệt đơn đặt sân</small>
                        </div>
                        <div>
                            @if (ttThanhToan != "Đã thanh toán" && don.TrangThai != "Đã hủy" && don.TrangThai != "Từ chối")
                            {
                                <form asp-action="XacNhanCoc" asp-route-id="@don.MaDatSan" method="post" class="d-inline"
                                      onsubmit="return confirm('Xác nhận khách đã thanh toán cọc (@don.TienCoc.ToString("N0") VNĐ) cho đơn #@don.MaDatSan?');">
                                    <button type="submit" class="btn btn-vang fw-bold rounded-pill px-4 py-2 shadow-sm">
                                        💵 Xác nhận đã đặt cọc
                                    </button>
                                </form>
                            }
                            else if (ttThanhToan == "Đã thanh toán")
                            {
                                <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">
                                    ✅ Đã hoàn tất đặt cọc
                                </span>
                            }
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6 col-md-3">
                            <div class="p-3 bg-white rounded-3 border">
                                <small class="text-muted d-block">Tiền cọc quy định:</small>
                                <strong class="text-danger fs-5">@don.TienCoc.ToString("N0") VNĐ</strong>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="p-3 bg-white rounded-3 border">
                                <small class="text-muted d-block">Phương thức:</small>
                                <strong class="text-dark">@(thanhToan?.PhuongThuc ?? "Chuyển khoản QR")</strong>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="p-3 bg-white rounded-3 border">
                                <small class="text-muted d-block">Trạng thái thanh toán:</small>
                                <strong class="@(ttThanhToan == "Đã thanh toán" ? "text-success" : (ttThanhToan == "Chờ xác nhận" ? "text-warning" : "text-muted"))">
                                    @ttThanhToan
                                </strong>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <div class="p-3 bg-white rounded-3 border">
                                <small class="text-muted d-block">Thời điểm thanh toán:</small>
                                <strong class="text-dark">@(thanhToan?.NgayThanhToan?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa thanh toán")</strong>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(thanhToan?.GhiChu))
                        {
                            <div class="col-12">
                                <div class="p-2 bg-white rounded-3 border small">
                                    <strong>Nội dung / Lời nhắn của khách:</strong> @thanhToan.GhiChu
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Thông tin khách hàng và sân -->
            <div class="row g-4 mb-4 pb-4 border-bottom">
                <div class="col-md-6">
                    <h6 class="fw-bold text-success text-uppercase small mb-3">👤 Thông tin khách hàng</h6>
                    <div class="p-3 bg-light rounded-3">
                        <p class="mb-2"><strong>Họ và tên:</strong> @don.KhachHang.HoTen</p>
                        <p class="mb-2"><strong>Số điện thoại:</strong> @don.KhachHang.SoDienThoai</p>
                        <p class="mb-2"><strong>Email:</strong> @(don.KhachHang.Email ?? "—")</p>
                        <p class="mb-2"><strong>Điểm tích lũy:</strong> ⭐ @don.KhachHang.DiemTichLuy</p>
                        <p class="mb-0">
                            <strong>Tình trạng:</strong>
                            @if (don.KhachHang.TrangThai)
                            {
                                <span class="badge bg-success-subtle text-success rounded-pill px-3">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Bị khóa</span>
                            }
                        </p>
                    </div>
                </div>

                <div class="col-md-6">
                    <h6 class="fw-bold text-success text-uppercase small mb-3">🏟️ Thông tin sân thi đấu</h6>
                    <div class="p-3 bg-light rounded-3">
                        <p class="mb-2"><strong>Tên sân:</strong> @don.SanTheThao.TenSan</p>
                        <p class="mb-2"><strong>Loại sân:</strong> @don.SanTheThao.LoaiSan.TenLoai</p>
                        <p class="mb-2"><strong>Địa chỉ:</strong> @don.SanTheThao.DiaChi</p>
                        <p class="mb-2"><strong>Giờ hoạt động:</strong> @gioMoCua - @gioDongCua</p>
                        <p class="mb-0">
                            <strong>Tình trạng:</strong>
                            @if (don.SanTheThao.DangKhaDung)
                            {
                                <span class="badge bg-success-subtle text-success rounded-pill px-3">@don.SanTheThao.TinhTrang</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3">@don.SanTheThao.TinhTrang</span>
                            }
                        </p>
                    </div>
                </div>
            </div>

            <!-- Thời gian sử dụng sân -->
            <div class="mb-4 pb-4 border-bottom">
                <h6 class="fw-bold text-success text-uppercase small mb-3">⏰ Thời gian sử dụng sân</h6>
                <div class="row g-3 text-center">
                    <div class="col-sm-4">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block">Ngày sử dụng</small>
                            <strong class="fs-5 text-dark">@don.GioBatDau.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block">Khung giờ</small>
                            <strong class="fs-5 text-primary">@don.GioBatDau.ToString("HH:mm") - @don.GioKetThuc.ToString("HH:mm")</strong>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block">Thời lượng</small>
                            <strong class="fs-5 text-dark">@Model.SoGio.ToString("0.#") giờ</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Kết quả kiểm tra điều kiện -->
            @if (don.TrangThai == "Chờ duyệt" || don.TrangThai == "Chờ xử lý")
            {
                <div class="mb-4 pb-4 border-bottom">
                    <h6 class="fw-bold text-success text-uppercase small mb-3">🔍 Kết quả kiểm tra điều kiện duyệt đơn</h6>

                    @if (Model.KetQua.Loi.Any())
                    {
                        <div class="alert alert-danger shadow-sm rounded-4 mb-3">
                            <div class="fw-bold mb-2">❌ Chưa đủ điều kiện để duyệt:</div>
                            <ul class="mb-0 ps-3">
                                @foreach (var loi in Model.KetQua.Loi)
                                {
                                    <li>@loi</li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success shadow-sm rounded-4 mb-3">
                            <div class="fw-bold">✅ Đã kiểm tra: Sân còn trống, đúng giờ hoạt động và đủ điều kiện để duyệt!</div>
                        </div>
                    }

                    @if (Model.KetQua.CanhBao.Any())
                    {
                        <div class="alert alert-warning shadow-sm rounded-4 mb-3">
                            <div class="fw-bold mb-1">⚠️ Lưu ý quản trị:</div>
                            <ul class="mb-0 ps-3">
                                @foreach (var cb in Model.KetQua.CanhBao)
                                {
                                    <li>@cb</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }

            <!-- Dịch vụ đi kèm -->
            <div class="mb-4 pb-4 border-bottom">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-success text-uppercase small mb-0">🥤 Dịch vụ đi kèm</h6>
                    @if (Model.CoTheSuaDichVu)
                    {
                        <button type="submit" form="formDichVu" class="btn btn-sm btn-outline-success rounded-pill px-3">
                            💾 Tạm lưu thay đổi dịch vụ
                        </button>
                    }
                </div>

                @if (Model.CoTheSuaDichVu)
                {
                    <form asp-action="LuuDichVu" asp-route-id="@don.MaDatSan" method="post" id="formDichVu">
                        @Html.AntiForgeryToken()
                        <div class="table-responsive">
                            <table class="table table-pretty align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;"></th>
                                        <th>Dịch vụ</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-center" style="width: 170px;">Số lượng</th>
                                        <th class="text-end" style="width: 170px;">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int idx = 0; }
                                    @foreach (var dv in Model.DanhSachDichVu)
                                    {
                                        int sl = dvTrongDon.TryGetValue(dv.MaDichVu, out var ct) ? ct.SoLuong : 0;
                                        decimal tt = (decimal)sl * dv.DonGia;
                                        <tr class="dv-row @(sl > 0 ? "dv-chon" : "")" data-dongia="@((long)dv.DonGia)">
                                            <td class="text-center ps-3">
                                                <span class="dv-ico">@LayIcon(dv.TenDichVu)</span>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark">@dv.TenDichVu</div>
                                                <small class="text-muted">@dv.MoTa</small>
                                                <input type="hidden" name="dichVu[@idx].MaDichVu" value="@dv.MaDichVu" />
                                            </td>
                                            <td class="text-end fw-semibold">@dv.DonGia.ToString("N0") VNĐ</td>
                                            <td class="text-center">
                                                <div class="input-group input-group-sm dv-qty mx-auto">
                                                    <button type="button" class="btn btn-dv btn-giam">−</button>
                                                    <input type="number" name="dichVu[@idx].SoLuong" value="@sl" min="0" max="99" class="form-control dv-input" />
                                                    <button type="button" class="btn btn-dv btn-tang">+</button>
                                                </div>
                                            </td>
                                            <td class="text-end fw-bold dv-thanhtien pe-3">@tt.ToString("N0") VNĐ</td>
                                        </tr>
                                        idx++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </form>
                }
                else if (don.ChiTietDatSans.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Dịch vụ</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ct in don.ChiTietDatSans)
                                {
                                    <tr>
                                        <td>@(ct.DichVu?.TenDichVu ?? $"Dịch vụ #{ct.MaDichVu}")</td>
                                        <td class="text-center">@ct.SoLuong</td>
                                        <td class="text-end">@ct.DonGia.ToString("N0") VNĐ</td>
                                        <td class="text-end fw-semibold">@ct.ThanhTien.ToString("N0") VNĐ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">Đơn không sử dụng dịch vụ đi kèm.</p>
                }
            </div>

            <!-- Bảng tổng kết chi phí -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="p-3 bg-light rounded-3" id="khungTien"
                         data-tien-san="@((long)Model.TienSan)" data-tien-coc="@((long)don.TienCoc)">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Đơn giá sân:</span>
                            <span class="fw-semibold">@don.DonGia.ToString("N0") VNĐ/giờ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tiền thuê sân (@Model.SoGio.ToString("0.#")h):</span>
                            <span class="fw-semibold">@Model.TienSan.ToString("N0") VNĐ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tiền dịch vụ thêm:</span>
                            <span class="fw-semibold" id="tongDichVu">@Model.TienDichVu.ToString("N0") VNĐ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 border-top pt-2">
                            <span class="fw-bold text-dark">Tổng cộng:</span>
                            <strong class="fs-5 text-primary" id="tongCong">@Model.TongTien.ToString("N0") VNĐ</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2 border-top pt-2">
                            <span class="fw-bold text-danger">Tiền cọc quy định (30%):</span>
                            <strong class="fs-5 text-danger">@don.TienCoc.ToString("N0") VNĐ</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top border-2 pt-2">
                            <span class="fw-bold text-success">
                                Tiền khách còn phải trả:
                                <small class="text-muted fw-normal d-block">(Tổng cộng − Tiền cọc)</small>
                            </span>
                            <strong class="fs-4 text-success" id="canThanhToan">@Model.ConPhaiThanhToan.ToString("N0") VNĐ</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nút thao tác Admin từng bước -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">&laquo; Quay lại danh sách</a>

                <div class="d-flex flex-wrap gap-2">
                    <!-- Bước 1: Xác nhận tiền cọc -->
                    @if (ttThanhToan != "Đã thanh toán" && don.TrangThai != "Đã hủy" && don.TrangThai != "Từ chối")
                    {
                        <form asp-action="XacNhanCoc" asp-route-id="@don.MaDatSan" method="post"
                              onsubmit="return confirm('Xác nhận khách đã đặt cọc (@don.TienCoc.ToString("N0") VNĐ) cho đơn #@don.MaDatSan?');">
                            <button type="submit" class="btn btn-vang rounded-pill px-4 fw-bold shadow-sm">
                                💵 Xác nhận đã đặt cọc
                            </button>
                        </form>
                    }

                    <!-- Bước 2: Duyệt đơn đặt sân -->
                    @if (don.TrangThai == "Chờ duyệt" || don.TrangThai == "Chờ xử lý")
                    {
                        if (Model.CoTheXacNhan)
                        {
                            <form asp-action="DuyetDon" asp-route-id="@don.MaDatSan" method="post"
                                  onsubmit="return confirm('Duyệt đơn đặt sân #@(don.MaDatSan)?');">
                                <button type="submit" class="btn btn-xanh rounded-pill px-4 fw-semibold shadow-sm">
                                    ✔️ Duyệt đơn đặt sân
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary rounded-pill px-4 fw-semibold" disabled
                                    title="Đơn chưa đủ điều kiện, xem mục kiểm tra phía trên">✔️ Chưa thể duyệt đơn</button>
                        }
                    }

                    <!-- Hoàn thành -->
                    @if (Model.CoTheHoanThanh)
                    {
                        <form asp-action="HoanThanhDon" asp-route-id="@don.MaDatSan" method="post"
                              onsubmit="return confirm('Hoàn thành đơn đặt sân #@(don.MaDatSan)?');">
                            <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm">✅ Hoàn thành</button>
                        </form>
                    }

                    <!-- Từ chối / Hủy đơn -->
                    @if (Model.CoTheHuy)
                    {
                        <form asp-action="TuChoi" asp-route-id="@don.MaDatSan" method="post"
                              onsubmit="return confirm('@cauHoiHuy');">
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm">
                                🗑️ Từ chối / Hủy đơn
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('formDichVu');
            if (!form) return;

            const khung = document.getElementById('khungTien');
            const tienSan = Number(khung.dataset.tienSan);
            const tienCoc = Number(khung.dataset.tienCoc);
            const lblTongDichVu = document.getElementById('tongDichVu');
            const lblTongCong = document.getElementById('tongCong');
            const lblCanThanhToan = document.getElementById('canThanhToan');

            function dinhDangTien(n) {
                return new Intl.NumberFormat('vi-VN').format(Math.max(0, Math.round(n))) + ' VNĐ';
            }

            function tinhLai() {
                let tongDv = 0;
                form.querySelectorAll('.dv-row').forEach(row => {
                    const donGia = Number(row.dataset.dongia);
                    const input = row.querySelector('.dv-input');
                    const sl = Math.max(0, Math.min(99, Number(input.value) || 0));
                    input.value = sl;

                    const thanhTien = sl * donGia;
                    tongDv += thanhTien;
                    row.querySelector('.dv-thanhtien').textContent = dinhDangTien(thanhTien);
                    row.classList.toggle('dv-chon', sl > 0);
                });

                const tongCong = tienSan + tongDv;
                const conPhaiTra = Math.max(0, tongCong - tienCoc);

                if (lblTongDichVu) lblTongDichVu.textContent = dinhDangTien(tongDv);
                if (lblTongCong) lblTongCong.textContent = dinhDangTien(tongCong);
                if (lblCanThanhToan) lblCanThanhToan.textContent = dinhDangTien(conPhaiTra);
            }

            form.addEventListener('click', e => {
                const btn = e.target.closest('.btn-dv');
                if (!btn) return;
                const input = btn.closest('.dv-qty').querySelector('.dv-input');
                let sl = Number(input.value) || 0;
                sl += btn.classList.contains('btn-tang') ? 1 : -1;
                input.value = Math.max(0, Math.min(99, sl));
                tinhLai();
            });

            form.addEventListener('input', e => {
                if (e.target.classList.contains('dv-input')) tinhLai();
            });
        })();
    </script>
}
