@*
// Họ và tên: Nguyễn Thị Lan Nhi
// Mã sinh viên: 23103100104
// Nội dung thực hiện: Module 3 - Giao diện Theo dõi lịch đặt sân của khách hàng (Tách riêng 2 trạng thái: Đặt sân & Thanh toán cọc)
*@

@model IEnumerable<QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.Entities.DatSan>

@{
    ViewData["Title"] = "Lịch sử đặt sân của tôi";
    int trangHienTai = ViewBag.TrangHienTai ?? 1;
    int tongSoTrang = ViewBag.TongSoTrang ?? 1;
    int tongSoBanGhi = ViewBag.TongSoBanGhi ?? 0;
    string? trangThai = ViewBag.TrangThai as string;
    string? trangThaiThanhToan = ViewBag.TrangThaiThanhToan as string;
}

<div class="container py-4">
    <!-- Tiêu đề và nút Tạo mới -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1">📅 Lịch sử đặt sân của tôi</h3>
            <p class="text-muted small mb-0">Theo dõi trạng thái duyệt đơn và trạng thái thanh toán tiền cọc của bạn</p>
        </div>
        <div>
            <a asp-action="TaoMoi" class="btn btn-success fw-bold px-4 py-2 rounded-pill shadow-sm" style="background: linear-gradient(135deg, #16a34a, #22c55e); border: none;">
                ➕ Đặt sân mới
            </a>
        </div>
    </div>

    <!-- Thông báo kết quả -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bộ lọc trạng thái (Tabs) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <!-- Lọc theo Trạng thái đặt sân -->
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="small fw-bold text-secondary me-1">Trạng thái đặt sân:</span>
                    <a asp-action="LichSuDatSan" asp-route-trangThaiThanhToan="@trangThaiThanhToan" class="btn btn-sm rounded-pill px-3 @(string.IsNullOrEmpty(trangThai) ? "btn-success" : "btn-light")">
                        Tất cả (@tongSoBanGhi)
                    </a>
                    <a asp-action="LichSuDatSan" asp-route-trangThai="Chờ duyệt" asp-route-trangThaiThanhToan="@trangThaiThanhToan" class="btn btn-sm rounded-pill px-3 @(trangThai == "Chờ duyệt" ? "btn-warning text-dark fw-bold" : "btn-light")">
                        ⏳ Chờ duyệt
                    </a>
                    <a asp-action="LichSuDatSan" asp-route-trangThai="Đã duyệt" asp-route-trangThaiThanhToan="@trangThaiThanhToan" class="btn btn-sm rounded-pill px-3 @(trangThai == "Đã duyệt" ? "btn-info text-dark fw-bold" : "btn-light")">
                        ⚙️ Đã duyệt
                    </a>
                    <a asp-action="LichSuDatSan" asp-route-trangThai="Hoàn thành" asp-route-trangThaiThanhToan="@trangThaiThanhToan" class="btn btn-sm rounded-pill px-3 @(trangThai == "Hoàn thành" ? "btn-success fw-bold" : "btn-light")">
                        ✅ Hoàn thành
                    </a>
                    <a asp-action="LichSuDatSan" asp-route-trangThai="Từ chối" asp-route-trangThaiThanhToan="@trangThaiThanhToan" class="btn btn-sm rounded-pill px-3 @(trangThai == "Từ chối" ? "btn-danger fw-bold" : "btn-light")">
                        ❌ Từ chối / Hủy
                    </a>
                </div>

                <!-- Lọc theo Trạng thái thanh toán -->
                <div class="d-flex align-items-center gap-1">
                    <span class="small text-muted me-1">Lọc thanh toán:</span>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown">
                            @(string.IsNullOrEmpty(trangThaiThanhToan) ? "Tất cả thanh toán" : trangThaiThanhToan)
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" asp-action="LichSuDatSan" asp-route-trangThai="@trangThai">Tất cả thanh toán</a></li>
                            <li><a class="dropdown-item" asp-action="LichSuDatSan" asp-route-trangThai="@trangThai" asp-route-trangThaiThanhToan="Chưa thanh toán">Chưa thanh toán</a></li>
                            <li><a class="dropdown-item" asp-action="LichSuDatSan" asp-route-trangThai="@trangThai" asp-route-trangThaiThanhToan="Chờ xác nhận">Chờ xác nhận</a></li>
                            <li><a class="dropdown-item" asp-action="LichSuDatSan" asp-route-trangThai="@trangThai" asp-route-trangThaiThanhToan="Đã thanh toán">Đã thanh toán</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách đơn đặt sân -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã đơn</th>
                        <th>Sân thể thao</th>
                        <th>Thời gian sử dụng</th>
                        <th>Tiền cọc</th>
                        <th class="text-center">Trạng thái đặt sân</th>
                        <th class="text-center">Trạng thái thanh toán</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var ds in Model)
                        {
                            var ttHienTai = ds.ThanhToanHienTai;
                            var ttThanhToan = ttHienTai?.TrangThai ?? "Chưa thanh toán";

                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@ds.MaDatSan</td>
                                <td>
                                    <div class="fw-bold text-dark">@(ds.SanTheThao?.TenSan ?? $"Sân #{ds.MaSan}")</div>
                                    <small class="text-muted">@(ds.SanTheThao?.LoaiSan?.TenLoai ?? "")</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary">@ds.GioBatDau.ToString("dd/MM/yyyy")</div>
                                    <small class="text-secondary fw-semibold">@ds.GioBatDau.ToString("HH:mm") - @ds.GioKetThuc.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <span class="fw-bold text-danger">@ds.TienCoc.ToString("N0") đ</span>
                                </td>

                                <!-- CỘT 1: TRẠNG THÁI ĐẶT SÂN -->
                                <td class="text-center">
                                    @switch (ds.TrangThai)
                                    {
                                        case "Chờ duyệt":
                                        case "Chờ xử lý":
                                            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">⏳ Chờ duyệt</span>
                                            break;
                                        case "Đã duyệt":
                                        case "Đang xử lý":
                                            <span class="badge bg-info text-dark px-3 py-1 rounded-pill">⚙️ Đã duyệt</span>
                                            break;
                                        case "Hoàn thành":
                                            <span class="badge bg-success px-3 py-1 rounded-pill">✅ Hoàn thành</span>
                                            break;
                                        case "Từ chối":
                                        case "Đã hủy":
                                            <span class="badge bg-danger px-3 py-1 rounded-pill">❌ Từ chối</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-3 py-1 rounded-pill">@ds.TrangThai</span>
                                            break;
                                    }
                                </td>

                                <!-- CỘT 2: TRẠNG THÁI THANH TOÁN (Chưa thanh toán / Chờ xác nhận / Đã thanh toán) -->
                                <td class="text-center">
                                    @switch (ttThanhToan)
                                    {
                                        case "Đã thanh toán":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill fw-bold">
                                                ✅ Đã thanh toán
                                            </span>
                                            break;
                                        case "Chờ xác nhận":
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill fw-bold">
                                                ⏳ Chờ xác nhận
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1 rounded-pill">
                                                ⚪ Chưa thanh toán
                                            </span>
                                            break;
                                    }
                                </td>

                                <!-- CỘT 3: THAO TÁC -->
                                <td class="text-center pe-4">
                                    <div class="d-inline-flex flex-wrap gap-2 justify-content-center">
                                        <!-- Nút Thanh toán cọc / Xem QR mô phỏng -->
                                        @if (ttThanhToan != "Đã thanh toán" && ds.TrangThai != "Đã hủy" && ds.TrangThai != "Từ chối")
                                        {
                                            <a asp-action="ThanhToan" asp-route-id="@ds.MaDatSan" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" style="background: linear-gradient(135deg, #16a34a, #22c55e); border: none;">
                                                💳 @(ttThanhToan == "Chờ xác nhận" ? "Xem lại QR" : "Thanh toán cọc")
                                            </a>
                                        }

                                        <!-- Xem chi tiết -->
                                        <a asp-action="ChiTiet" asp-route-id="@ds.MaDatSan" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            Chi tiết
                                        </a>

                                        <!-- Hủy đặt sân: Chỉ hiển thị khi đơn ở trạng thái 'Chờ duyệt' hoặc 'Chờ xử lý' -->
                                        @if (ds.TrangThai == "Chờ duyệt" || ds.TrangThai == "Chờ xử lý")
                                        {
                                            <form asp-action="Huy" asp-route-id="@ds.MaDatSan" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn đặt sân #@ds.MaDatSan này không?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    Hủy
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="fs-1 mb-2">🏟️</div>
                                <p class="mb-2 fw-semibold">Bạn chưa có đơn đặt sân nào @(string.IsNullOrEmpty(trangThai) ? "" : $"ở trạng thái '{trangThai}'")!</p>
                                <a asp-action="TaoMoi" class="btn btn-sm btn-success rounded-pill px-4">Đặt sân ngay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang LINQ -->
        @if (tongSoTrang > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <small class="text-muted">Trang <strong>@trangHienTai</strong> / <strong>@tongSoTrang</strong></small>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(trangHienTai <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="LichSuDatSan" asp-route-trang="@(trangHienTai - 1)" asp-route-trangThai="@trangThai" asp-route-trangThaiThanhToan="@trangThaiThanhToan">&laquo; Trước</a>
                        </li>
                        @for (int i = 1; i <= tongSoTrang; i++)
                        {
                            <li class="page-item @(i == trangHienTai ? "active" : "")">
                                <a class="page-link @(i == trangHienTai ? "bg-success border-success" : "")" asp-action="LichSuDatSan" asp-route-trang="@i" asp-route-trangThai="@trangThai" asp-route-trangThaiThanhToan="@trangThaiThanhToan">@i</a>
                            </li>
                        }
                        <li class="page-item @(trangHienTai >= tongSoTrang ? "disabled" : "")">
                            <a class="page-link" asp-action="LichSuDatSan" asp-route-trang="@(trangHienTai + 1)" asp-route-trangThai="@trangThai" asp-route-trangThaiThanhToan="@trangThaiThanhToan">Sau &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
