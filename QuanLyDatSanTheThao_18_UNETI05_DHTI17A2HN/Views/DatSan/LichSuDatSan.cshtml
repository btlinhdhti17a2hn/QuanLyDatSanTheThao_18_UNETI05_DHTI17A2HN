@*
// Họ và tên: Nguyễn Thị Lan Nhi
// Mã sinh viên: 23103100104
// Nội dung thực hiện: Module 3 - Giao diện Theo dõi lịch đặt sân của khách hàng (Danh sách, lọc trạng thái, phân trang và hủy đơn)
*@

@model IEnumerable<QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.Entities.DatSan>

@{
    ViewData["Title"] = "Lịch sử đặt sân của tôi";
    int trangHienTai = ViewBag.TrangHienTai ?? 1;
    int tongSoTrang = ViewBag.TongSoTrang ?? 1;
    int tongSoBanGhi = ViewBag.TongSoBanGhi ?? 0;
    string? trangThai = ViewBag.TrangThai as string;
}

<div class="container py-4">
    <!-- Tiêu đề và nút Tạo mới -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-success mb-1">📅 Lịch sử đặt sân của tôi</h3>
            <p class="text-muted small mb-0">Theo dõi trạng thái các đơn đặt sân và chi tiết giao dịch của bạn</p>
        </div>
        <div>
            <a asp-action="TaoMoi" class="btn btn-success fw-bold px-4 py-2 rounded-pill shadow-sm" style="background: linear-gradient(135deg, #16a34a, #22c55e); border: none;">
                ➕ Đặt sân mới
            </a>
        </div>
    </div>

    <!-- Thông báo kết quả -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Bộ lọc trạng thái (Tabs) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-2">
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="LichSuDatSan" class="btn btn-sm rounded-pill px-3 @(string.IsNullOrEmpty(trangThai) ? "btn-success" : "btn-light")">
                    Tất cả (@tongSoBanGhi)
                </a>
                <a asp-action="LichSuDatSan" asp-route-trangThai="Chờ xử lý" class="btn btn-sm rounded-pill px-3 @(trangThai == "Chờ xử lý" ? "btn-warning text-dark fw-bold" : "btn-light")">
                    ⏳ Chờ xử lý
                </a>
                <a asp-action="LichSuDatSan" asp-route-trangThai="Đang xử lý" class="btn btn-sm rounded-pill px-3 @(trangThai == "Đang xử lý" ? "btn-info text-dark fw-bold" : "btn-light")">
                    ⚙️ Đang xử lý
                </a>
                <a asp-action="LichSuDatSan" asp-route-trangThai="Hoàn thành" class="btn btn-sm rounded-pill px-3 @(trangThai == "Hoàn thành" ? "btn-success fw-bold" : "btn-light")">
                    ✅ Hoàn thành
                </a>
                <a asp-action="LichSuDatSan" asp-route-trangThai="Đã hủy" class="btn btn-sm rounded-pill px-3 @(trangThai == "Đã hủy" ? "btn-danger fw-bold" : "btn-light")">
                    ❌ Đã hủy
                </a>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách đơn đặt sân -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã đơn</th>
                        <th>Sân thể thao</th>
                        <th>Thời gian sử dụng</th>
                        <th>Thời điểm đặt</th>
                        <th>Tiền cọc</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var ds in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@ds.MaDatSan</td>
                                <td>
                                    <div class="fw-bold text-dark">@(ds.SanTheThao?.TenSan ?? $"Sân #{ds.MaSan}")</div>
                                    <small class="text-muted">@(ds.SanTheThao?.LoaiSan?.TenLoai ?? "")</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary">@ds.GioBatDau.ToString("dd/MM/yyyy")</div>
                                    <small class="text-secondary fw-semibold">@ds.GioBatDau.ToString("HH:mm") - @ds.GioKetThuc.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <small class="text-muted">@ds.NgayDat.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td>
                                    <span class="fw-bold text-danger">@ds.TienCoc.ToString("N0") đ</span>
                                </td>
                                <td class="text-center">
                                    @switch (ds.TrangThai)
                                    {
                                        case "Chờ xử lý":
                                            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">Chờ xử lý</span>
                                            break;
                                        case "Đang xử lý":
                                            <span class="badge bg-info text-dark px-3 py-1 rounded-pill">Đang xử lý</span>
                                            break;
                                        case "Hoàn thành":
                                            <span class="badge bg-success px-3 py-1 rounded-pill">Hoàn thành</span>
                                            break;
                                        case "Đã hủy":
                                            <span class="badge bg-danger px-3 py-1 rounded-pill">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-3 py-1 rounded-pill">@ds.TrangThai</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Xem chi tiết -->
                                        <a asp-action="ChiTiet" asp-route-id="@ds.MaDatSan" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            Chi tiết
                                        </a>

                                        <!-- Hủy đặt sân: Chỉ hiển thị khi đơn ở trạng thái 'Chờ xử lý' (Theo chuẩn Mục 7.4 đề bài) -->
                                        @if (ds.TrangThai == "Chờ xử lý")
                                        {
                                            <form asp-action="Huy" asp-route-id="@ds.MaDatSan" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn đặt sân #@ds.MaDatSan này không?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    Hủy
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="fs-1 mb-2">🏟️</div>
                                <p class="mb-2 fw-semibold">Bạn chưa có đơn đặt sân nào @(string.IsNullOrEmpty(trangThai) ? "" : $"ở trạng thái '{trangThai}'")!</p>
                                <a asp-action="TaoMoi" class="btn btn-sm btn-success rounded-pill px-4">Đặt sân ngay</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang LINQ (Giữ nguyên tham số trạng thái khi chuyển trang) -->
        @if (tongSoTrang > 1)
        {
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <small class="text-muted">Trang <strong>@trangHienTai</strong> / <strong>@tongSoTrang</strong></small>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(trangHienTai <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="LichSuDatSan" asp-route-trang="@(trangHienTai - 1)" asp-route-trangThai="@trangThai">&laquo; Trước</a>
                        </li>
                        @for (int i = 1; i <= tongSoTrang; i++)
                        {
                            <li class="page-item @(i == trangHienTai ? "active" : "")">
                                <a class="page-link @(i == trangHienTai ? "bg-success border-success" : "")" asp-action="LichSuDatSan" asp-route-trang="@i" asp-route-trangThai="@trangThai">@i</a>
                            </li>
                        }
                        <li class="page-item @(trangHienTai >= tongSoTrang ? "disabled" : "")">
                            <a class="page-link" asp-action="LichSuDatSan" asp-route-trang="@(trangHienTai + 1)" asp-route-trangThai="@trangThai">Sau &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
