@*
// Họ và tên: Nguyễn Thị Lan Nhi
// Mã sinh viên: 23103100104
// Nội dung thực hiện: Module 3 - Giao diện Chi tiết đơn đặt sân (Tách riêng 2 trạng thái: Đặt sân & Thanh toán, nút thanh toán QR)
*@

@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.Entities.DatSan

@{
    ViewData["Title"] = "Chi tiết đơn đặt sân #" + Model.MaDatSan;
    double soGio = (Model.GioKetThuc - Model.GioBatDau).TotalHours;
    decimal tienSan = Math.Round((decimal)soGio * Model.DonGia, 0);
    decimal tienDichVu = Model.ChiTietDatSans?.Sum(ct => ct.ThanhTien) ?? 0;
    decimal tongCong = tienSan + tienDichVu;
    var thanhToan = Model.ThanhToanHienTai;
    var ttThanhToan = thanhToan?.TrangThai ?? "Chưa thanh toán";
}

<div class="container py-4">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-success">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="LichSuDatSan" class="text-decoration-none text-success">Lịch sử đặt sân</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đơn đặt #@Model.MaDatSan</li>
        </ol>
    </nav>

    <!-- Thẻ Chi tiết đơn đặt sân phong cách Hóa đơn -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <!-- Banner đầu phiếu -->
        <div class="card-header bg-white border-bottom p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <span class="badge bg-success-subtle text-success fs-6 px-3 py-1 rounded-pill mb-2">Đơn đặt sân</span>
                    <h3 class="fw-bold text-dark mb-0">Mã đơn: #@Model.MaDatSan</h3>
                    <small class="text-muted">Thời điểm tạo đơn: @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
                <div class="text-end">
                    <div class="mb-2">
                        <span class="small text-muted d-block">Trạng thái đặt sân:</span>
                        @switch (Model.TrangThai)
                        {
                            case "Chờ duyệt":
                            case "Chờ xử lý":
                                <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">⏳ Chờ duyệt</span>
                                break;
                            case "Đã duyệt":
                            case "Đang xử lý":
                                <span class="badge bg-info text-dark fs-6 px-3 py-2 rounded-pill">⚙️ Đã duyệt</span>
                                break;
                            case "Hoàn thành":
                                <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">✅ Hoàn thành</span>
                                break;
                            case "Từ chối":
                            case "Đã hủy":
                                <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill">❌ Từ chối</span>
                                break;
                            default:
                                <span class="badge bg-secondary fs-6 px-3 py-2 rounded-pill">@Model.TrangThai</span>
                                break;
                        }
                    </div>
                    <div>
                        <span class="small text-muted d-block">Trạng thái thanh toán:</span>
                        @switch (ttThanhToan)
                        {
                            case "Đã thanh toán":
                                <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-1 rounded-pill fw-bold">
                                    ✅ Đã thanh toán cọc
                                </span>
                                break;
                            case "Chờ xác nhận":
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-6 px-3 py-1 rounded-pill fw-bold">
                                    ⏳ Chờ xác nhận cọc
                                </span>
                                break;
                            default:
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle fs-6 px-3 py-1 rounded-pill">
                                    ⚪ Chưa thanh toán cọc
                                </span>
                                break;
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <!-- Thông tin hai bên: Khách hàng và Sân -->
            <div class="row g-4 mb-4 pb-4 border-bottom">
                <!-- Thông tin khách hàng -->
                <div class="col-md-6">
                    <h6 class="fw-bold text-success text-uppercase small mb-3">👤 Thông tin khách hàng đặt sân</h6>
                    <div class="p-3 bg-light rounded-3">
                        <p class="mb-2"><strong>Họ và tên:</strong> @(Model.KhachHang?.HoTen ?? "Khách vãng lai")</p>
                        <p class="mb-2"><strong>Số điện thoại:</strong> @(Model.KhachHang?.SoDienThoai ?? "—")</p>
                        <p class="mb-0"><strong>Email:</strong> @(Model.KhachHang?.Email ?? "—")</p>
                    </div>
                </div>

                <!-- Thông tin sân thể thao -->
                <div class="col-md-6">
                    <h6 class="fw-bold text-success text-uppercase small mb-3">🏟️ Thông tin sân thi đấu</h6>
                    <div class="p-3 bg-light rounded-3">
                        <p class="mb-2"><strong>Tên sân:</strong> @(Model.SanTheThao?.TenSan ?? $"Sân #{Model.MaSan}")</p>
                        <p class="mb-2"><strong>Loại sân:</strong> @(Model.SanTheThao?.LoaiSan?.TenLoai ?? "—")</p>
                        <p class="mb-0"><strong>Địa chỉ sân:</strong> @(Model.SanTheThao?.DiaChi ?? "—")</p>
                    </div>
                </div>
            </div>

            <!-- Khung giờ thuê sân -->
            <div class="mb-4 pb-4 border-bottom">
                <h6 class="fw-bold text-success text-uppercase small mb-3">⏰ Thời gian sử dụng sân</h6>
                <div class="row g-3 text-center">
                    <div class="col-sm-4">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block">Ngày sử dụng</small>
                            <strong class="fs-5 text-dark">@Model.GioBatDau.ToString("dd/MM/yyyy")</strong>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block">Khung giờ</small>
                            <strong class="fs-5 text-primary">@Model.GioBatDau.ToString("HH:mm") - @Model.GioKetThuc.ToString("HH:mm")</strong>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block">Thời lượng thuê</small>
                            <strong class="fs-5 text-dark">@soGio.ToString("0.#") giờ</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dịch vụ đi kèm (nếu có) -->
            @if (Model.ChiTietDatSans != null && Model.ChiTietDatSans.Any())
            {
                <div class="mb-4 pb-4 border-bottom">
                    <h6 class="fw-bold text-success text-uppercase small mb-3">🥤 Dịch vụ sử dụng thêm</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Dịch vụ</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ct in Model.ChiTietDatSans)
                                {
                                    <tr>
                                        <td>@(ct.DichVu?.TenDichVu ?? $"Dịch vụ #{ct.MaDichVu}")</td>
                                        <td class="text-center">@ct.SoLuong</td>
                                        <td class="text-end">@ct.DonGia.ToString("N0") VNĐ</td>
                                        <td class="text-end fw-semibold">@ct.ThanhTien.ToString("N0") VNĐ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Thông tin thanh toán tiền cọc mô phỏng -->
            <div class="mb-4 pb-4 border-bottom">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-success text-uppercase small mb-0">💳 Chi tiết giao dịch thanh toán tiền cọc</h6>
                    @if (ttThanhToan != "Đã thanh toán" && Model.TrangThai != "Đã hủy" && Model.TrangThai != "Từ chối")
                    {
                        <a asp-action="ThanhToan" asp-route-id="@Model.MaDatSan" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" style="background: linear-gradient(135deg, #16a34a, #22c55e); border: none;">
                            Quét mã QR thanh toán cọc &raquo;
                        </a>
                    }
                </div>
                
                <div class="p-3 bg-light rounded-3">
                    <div class="row g-2">
                        <div class="col-sm-6 col-md-3">
                            <small class="text-muted d-block">Tiền cọc quy định:</small>
                            <strong class="text-danger fs-6">@Model.TienCoc.ToString("N0") VNĐ</strong>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <small class="text-muted d-block">Phương thức:</small>
                            <strong>@(thanhToan?.PhuongThuc ?? "Chuyển khoản QR")</strong>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <small class="text-muted d-block">Trạng thái thanh toán:</small>
                            <strong class="@(ttThanhToan == "Đã thanh toán" ? "text-success" : (ttThanhToan == "Chờ xác nhận" ? "text-warning" : "text-muted"))">
                                @ttThanhToan
                            </strong>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <small class="text-muted d-block">Ngày khách báo thanh toán:</small>
                            <strong>@(thanhToan?.NgayThanhToan?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa thực hiện")</strong>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(thanhToan?.GhiChu))
                    {
                        <div class="mt-2 pt-2 border-top small text-muted">
                            <strong>Nội dung / Ghi chú:</strong> @thanhToan.GhiChu
                        </div>
                    }
                </div>
            </div>

            <!-- Bảng tổng kết tiền -->
            <div class="row justify-content-end mb-4">
                <div class="col-md-6 col-lg-5">
                    <div class="p-3 bg-light rounded-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tiền thuê sân:</span>
                            <span class="fw-semibold">@tienSan.ToString("N0") VNĐ</span>
                        </div>
                        @if (tienDichVu > 0)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Tiền dịch vụ thêm:</span>
                                <span class="fw-semibold">@tienDichVu.ToString("N0") VNĐ</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-2 border-top pt-2">
                            <span class="fw-bold text-dark">Tổng cộng:</span>
                            <strong class="fs-5 text-primary">@tongCong.ToString("N0") VNĐ</strong>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2">
                            <span class="fw-bold text-danger">Tiền cọc quy định (30%):</span>
                            <strong class="fs-5 text-danger">@Model.TienCoc.ToString("N0") VNĐ</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nút thao tác -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                <a asp-action="LichSuDatSan" class="btn btn-outline-secondary rounded-pill px-4">
                    &laquo; Quay lại lịch sử đặt sân
                </a>

                <div class="d-flex gap-2">
                    @if (ttThanhToan != "Đã thanh toán" && Model.TrangThai != "Đã hủy" && Model.TrangThai != "Từ chối")
                    {
                        <a asp-action="ThanhToan" asp-route-id="@Model.MaDatSan" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm" style="background: linear-gradient(135deg, #16a34a, #22c55e); border: none;">
                            💳 Thanh toán cọc qua QR
                        </a>
                    }

                    @if (Model.TrangThai == "Chờ duyệt" || Model.TrangThai == "Chờ xử lý")
                    {
                        <form asp-action="Huy" asp-route-id="@Model.MaDatSan" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn đặt sân này không?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm">
                                🗑️ Hủy đơn đặt sân
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
