@*
// Họ và tên: Nguyễn Thị Lan Nhi
// Mã sinh viên: 23103100104
// Nội dung thực hiện: Module 3 - Giao diện Chi tiết đơn đặt sân (Thông tin sân, thời gian, trạng thái, chi phí, dịch vụ đi kèm và xem mã QR chuyển cọc)
*@

@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.Entities.DatSan

@{
    ViewData["Title"] = "Chi tiết đơn đặt sân #" + Model.MaDatSan;
    double soGio = (Model.GioKetThuc - Model.GioBatDau).TotalHours;
    decimal tienSan = Math.Round((decimal)soGio * Model.DonGia, 0);
    decimal tienDichVu = Model.ChiTietDatSans?.Sum(ct => ct.ThanhTien) ?? 0;
    decimal tongCong = tienSan + tienDichVu;
}

<div class="container py-4">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-success">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="LichSuDatSan" class="text-decoration-none text-success">Lịch sử đặt sân</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đơn đặt #@Model.MaDatSan</li>
        </ol>
    </nav>

    <!-- Thẻ Chi tiết đơn đặt sân phong cách Hóa đơn -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <!-- Banner đầu phiếu -->
        <div class="card-header bg-white border-bottom p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <span class="badge bg-success-subtle text-success fs-6 px-3 py-1 rounded-pill mb-2">Đơn đặt sân</span>
                    <h3 class="fw-bold text-dark mb-0">Mã đơn: #@Model.MaDatSan</h3>
                    <small class="text-muted">Thời điểm tạo đơn: @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
                <div class="text-end">
                    <span class="small text-muted d-block mb-1">Trạng thái hiện tại:</span>
                    @switch (Model.TrangThai)
                    {
                        case "Chờ xử lý":
                            <span class="badge bg-warning text-dark fs-6 px-4 py-2 rounded-pill">⏳ Chờ xử lý</span>
                            break;
                        case "Đang xử lý":
                            <span class="badge bg-info text-dark fs-6 px-4 py-2 rounded-pill">⚙️ Đang xử lý</span>
                            break;
                        case "Hoàn thành":
                            <span class="badge bg-success fs-6 px-4 py-2 rounded-pill">✅ Hoàn thành</span>
                            break;
                        case "Đã hủy":
                            <span class="badge bg-danger fs-6 px-4 py-2 rounded-pill">❌ Đã hủy</span>
                            break;
                        default:
                            <span class="badge bg-secondary fs-6 px-4 py-2 rounded-pill">@Model.TrangThai</span>
                            break;
                    }
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- 1. Thông tin Sân & Thời gian sử dụng -->
            <div class="row g-4 mb-4">
                <div class="col-md-6 border-end-md">
                    <h5 class="fw-bold text-success mb-3">🏟️ Thông tin Sân thể thao</h5>
                    <div class="p-3 bg-light rounded-3">
                        <div class="mb-2">
                            <span class="text-muted">Tên sân:</span>
                            <strong class="text-dark">@(Model.SanTheThao?.TenSan ?? $"Sân #{Model.MaSan}")</strong>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted">Loại sân:</span>
                            <span class="badge bg-secondary">@(Model.SanTheThao?.LoaiSan?.TenLoai ?? "Chưa phân loại")</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted">Địa chỉ:</span>
                            <span>@(Model.SanTheThao?.DiaChi ?? "Khu thể thao UNETI")</span>
                        </div>
                        <div>
                            <span class="text-muted">Đơn giá áp dụng:</span>
                            <strong class="text-primary">@Model.DonGia.ToString("N0") VNĐ/giờ</strong>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <h5 class="fw-bold text-success mb-3">⏰ Thời gian sử dụng sân</h5>
                    <div class="p-3 bg-light rounded-3">
                        <div class="mb-2">
                            <span class="text-muted">Ngày sử dụng:</span>
                            <strong class="text-dark">@Model.GioBatDau.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted">Khung giờ:</span>
                            <strong class="text-success fs-6">@Model.GioBatDau.ToString("HH:mm") &rarr; @Model.GioKetThuc.ToString("HH:mm")</strong>
                        </div>
                        <div>
                            <span class="text-muted">Thời lượng thuê:</span>
                            <span class="badge bg-primary px-3 py-1">@soGio.ToString("0.#") giờ</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Danh sách dịch vụ sử dụng đi kèm (nếu có) -->
            @if (Model.ChiTietDatSans != null && Model.ChiTietDatSans.Any())
            {
                <div class="mb-4">
                    <h5 class="fw-bold text-success mb-3">🥤 Dịch vụ tiện ích đi kèm</h5>
                    <div class="table-responsive border rounded-3">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>STT</th>
                                    <th>Tên dịch vụ</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int stt = 1; }
                                @foreach (var ct in Model.ChiTietDatSans)
                                {
                                    <tr>
                                        <td>@(stt++)</td>
                                        <td class="fw-semibold">@(ct.DichVu?.TenDichVu ?? $"Dịch vụ #{ct.MaDichVu}")</td>
                                        <td class="text-center">@ct.SoLuong</td>
                                        <td class="text-end">@ct.DonGia.ToString("N0") VNĐ</td>
                                        <td class="text-end fw-bold text-dark">@ct.ThanhTien.ToString("N0") VNĐ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- 3. Tóm tắt tổng chi phí và tiền cọc -->
            <div class="row justify-content-end mb-4">
                <div class="col-md-5">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tiền thuê sân (@soGio.ToString("0.#")h):</span>
                            <span class="fw-semibold">@tienSan.ToString("N0") VNĐ</span>
                        </div>
                        @if (tienDichVu > 0)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Tiền dịch vụ thêm:</span>
                                <span class="fw-semibold">@tienDichVu.ToString("N0") VNĐ</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between mb-2 border-top pt-2">
                            <span class="fw-bold text-dark">Tổng cộng:</span>
                            <strong class="fs-5 text-primary">@tongCong.ToString("N0") VNĐ</strong>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2">
                            <span class="fw-bold text-danger">Tiền cọc quy định (30%):</span>
                            <strong class="fs-5 text-danger">@Model.TienCoc.ToString("N0") VNĐ</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nút thao tác -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                <a asp-action="LichSuDatSan" class="btn btn-outline-secondary rounded-pill px-4">
                    &laquo; Quay lại lịch sử đặt sân
                </a>

                @if (Model.TrangThai == "Chờ xử lý")
                {
                    <div class="d-flex gap-2">
                        <a asp-action="XacNhanDatCoc" asp-route-id="@Model.MaDatSan" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" style="background: linear-gradient(135deg, #7c3aed, #9333ea); border: none;">
                            📱 Xem lại mã QR chuyển cọc
                        </a>
                        <form asp-action="Huy" asp-route-id="@Model.MaDatSan" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn đặt sân này không?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger rounded-pill px-4 fw-semibold shadow-sm">
                                🗑️ Hủy đơn
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
