@*
// Họ và tên: Nguyễn Thị Lan Nhi
// Mã sinh viên: 23103100104
// Nội dung thực hiện: Module 3 - Giao diện hiển thị Mã QR TPBank chuyển khoản đặt cọc sau khi đặt sân
*@

@model QuanLyDatSanTheThao_18_UNETI05_DHTI17A2HN.Models.Entities.DatSan

@{
    ViewData["Title"] = $"Xác nhận đặt cọc đơn #{Model.MaDatSan}";
    var soGio = (Model.GioKetThuc - Model.GioBatDau).TotalHours;
    decimal tongTien = Math.Round((decimal)soGio * Model.DonGia, 0);
}

<style>
    .qr-card-box {
        max-width: 540px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(107, 33, 168, 0.1);
        border: 2px solid #f3e8ff;
        overflow: hidden;
    }
    .tpbank-header {
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        color: white;
        padding: 24px;
        text-align: center;
        border-bottom-left-radius: 24px;
        border-bottom-right-radius: 24px;
    }
    .amount-highlight {
        font-size: 2.1rem;
        font-weight: 800;
        color: #fef08a;
    }
    .qr-frame {
        background: #ffffff;
        padding: 14px;
        border-radius: 20px;
        border: 2px dashed #c084fc;
        display: inline-block;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    }
    .copy-btn {
        cursor: pointer;
        transition: all 0.2s;
    }
    .copy-btn:hover {
        background-color: #f3e8ff !important;
        border-color: #9333ea !important;
        color: #7c3aed !important;
    }
    .btn-finish {
        background: linear-gradient(135deg, #16a34a, #22c55e);
        color: white;
        font-weight: 700;
        padding: 12px 28px;
        border-radius: 30px;
        border: none;
        box-shadow: 0 6px 18px rgba(22, 163, 74, 0.3);
        transition: transform 0.2s;
    }
    .btn-finish:hover {
        transform: translateY(-2px);
        color: white;
    }
</style>

<div class="container py-4">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3" style="max-width: 540px; margin: 0 auto;">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-success">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="LichSuDatSan" class="text-decoration-none text-success">Lịch sử đặt sân</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận cọc #@Model.MaDatSan</li>
        </ol>
    </nav>

    <!-- Khung mã QR TPBank căn giữa -->
    <div class="qr-card-box">
        <!-- Header: Tên ngân hàng & Số tiền cọc -->
        <div class="tpbank-header">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-25 mb-2 small fw-bold">
                <span>🏦 @ViewBag.NganHang</span>
            </div>
            <h4 class="fw-bold mb-1">Đơn đặt sân #@Model.MaDatSan</h4>
            <div class="small opacity-75">
                🏟️ @(Model.SanTheThao?.TenSan ?? $"Sân #{Model.MaSan}") &bull; ⏰ @Model.GioBatDau.ToString("HH:mm") - @Model.GioKetThuc.ToString("HH:mm") (@Model.GioBatDau.ToString("dd/MM/yyyy"))
            </div>
            <div class="mt-3">
                <small class="d-block opacity-75">Tiền cọc cần chuyển (30%):</small>
                <div class="amount-highlight">@Model.TienCoc.ToString("N0") VNĐ</div>
            </div>
        </div>

        <!-- Body: Ảnh mã QR VietQR TPBank -->
        <div class="p-4 text-center">
            <div class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill px-3 py-1 mb-2 text-dark" style="background-color: #f3e8ff;">
                <i class="bi bi-qr-code-scan me-1 text-primary"></i> Quét bằng bất kỳ App Ngân hàng hoặc Ví MoMo, ZaloPay
            </div>

            <!-- Mã QR VietQR TPBank chuẩn tự động điền STK & Số tiền cọc -->
            <div class="qr-frame my-2">
                <img src="@ViewBag.VietQrUrl" 
                     alt="Mã QR TPBank NGUYEN THI LAN NHI" 
                     class="img-fluid rounded-3" 
                     style="max-width: 250px; width: 100%; height: auto;" />
                <div class="mt-2 text-muted" style="font-size: 0.85rem;">
                    Quét mã để tự động điền STK và số tiền <strong>@Model.TienCoc.ToString("N0")đ</strong>
                </div>
            </div>

            <!-- Bảng thông tin tài khoản TPBank -->
            <div class="bg-light rounded-3 p-3 text-start border mt-3 small">
                <div class="mb-2 pb-2 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted d-block">Ngân hàng:</span>
                        <strong class="text-dark">@ViewBag.NganHang</strong>
                    </div>
                    <span class="badge bg-primary">TPBank</span>
                </div>

                <div class="mb-2 pb-2 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted d-block">Số tài khoản:</span>
                        <strong class="text-primary fs-6 font-monospace" id="txtStk">@ViewBag.SoTaiKhoan</strong>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary copy-btn rounded-pill px-2 py-1" onclick="copyText('@ViewBag.SoTaiKhoan', this)">
                        <i class="bi bi-clipboard"></i> Chép STK
                    </button>
                </div>

                <div class="mb-2 pb-2 border-bottom">
                    <span class="text-muted d-block">Chủ tài khoản:</span>
                    <strong class="text-dark">@ViewBag.ChuTaiKhoan</strong>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted d-block">Nội dung chuyển khoản:</span>
                        <strong class="text-danger font-monospace fs-6" id="txtNoiDung">@ViewBag.NoiDungChuyenKhoan</strong>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger copy-btn rounded-pill px-2 py-1" onclick="copyText('@ViewBag.NoiDungChuyenKhoan', this)">
                        <i class="bi bi-clipboard"></i> Chép ND
                    </button>
                </div>
            </div>

            <!-- Hướng dẫn tiếp theo -->
            <div class="alert alert-info py-2 px-3 mt-3 rounded-3 small text-start">
                <i class="bi bi-info-circle-fill me-1"></i>
                Sau khi bạn chuyển khoản cọc xong, bấm nút xác nhận bên dưới. Đơn sẽ ở trạng thái <strong>Chờ xử lý</strong> để ban quản lý kiểm tra và duyệt lịch sân cho bạn!
            </div>

            <!-- Nút bấm xác nhận hoàn tất của SV3 -->
            <div class="mt-4 pt-2 d-flex flex-column gap-2">
                <a asp-action="LichSuDatSan" class="btn btn-finish w-100">
                    🚀 Tôi đã chuyển khoản cọc
                </a>
                <a asp-action="LichSuDatSan" class="btn btn-link text-decoration-none text-muted small">
                    Để chuyển khoản sau &raquo;
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyText(val, btn) {
            navigator.clipboard.writeText(val).then(function() {
                const old = btn.innerHTML;
                btn.innerHTML = '✔ Đã chép!';
                btn.classList.add('btn-success', 'text-white');
                setTimeout(() => {
                    btn.innerHTML = old;
                    btn.classList.remove('btn-success', 'text-white');
                }, 1500);
            });
        }
    </script>
}
